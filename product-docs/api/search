yment","type":"heading","tags":[],"url":"/product-docs/getting-started/plan-your-deployment#how-it-helps","content":"How it helps"},"3100":{"id":"/product-docs/getting-started/plan-your-deployment-17","page_id":"/product-docs/getting-started/plan-your-deployment","type":"heading","tags":[],"url":"/product-docs/getting-started/plan-your-deployment#without-it","content":"What happens without it"},"3101":{"id":"/product-docs/getting-started/plan-your-deployment-18","page_id":"/product-docs/getting-started/plan-your-deployment","type":"heading","tags":[],"url":"/product-docs/getting-started/plan-your-deployment#why-buyers-care","content":"Why buyers care"},"3102":{"id":"/product-docs/getting-started/plan-your-deployment-19","page_id":"/product-docs/getting-started/plan-your-deployment","type":"heading","tags":[],"url":"/product-docs/getting-started/plan-your-deployment#approach","content":"The Oliv AI approach to deployment"},"3103":{"id":"/product-docs/getting-started/plan-your-deployment-20","page_id":"/product-docs/getting-started/plan-your-deployment","type":"heading","tags":[],"url":"/product-docs/getting-started/plan-your-deployment#works-with","content":"How the deployment plan works with other features"},"3104":{"id":"/product-docs/getting-started/plan-your-deployment-21","page_id":"/product-docs/getting-started/plan-your-deployment","type":"heading","tags":[],"url":"/product-docs/getting-started/plan-your-deployment#with-seat-roles","content":"Seat roles"},"3105":{"id":"/product-docs/getting-started/plan-your-deployment-22","page_id":"/product-docs/getting-started/plan-your-deployment","type":"heading","tags":[],"url":"/product-docs/getting-started/plan-your-deployment#with-field-mapping","content":"Field mapping"},"3106":{"id":"/product-docs/getting-started/plan-your-deployment-23","page_id":"/product-docs/getting-started/plan-your-deployment","type":"heading","tags":[],"url":"/product-docs/getting-started/plan-your-deployment#with-approvals","content":"Approval settings"},"3107":{"id":"/product-docs/getting-started/plan-your-deployment-24","page_id":"/product-docs/getting-started/plan-your-deployment","type":"heading","tags":[],"url":"/product-docs/getting-started/plan-your-deployment#with-recording","content":"Recording"},"3108":{"id":"/product-docs/getting-started/plan-your-deployment-25","page_id":"/product-docs/getting-started/plan-your-deployment","type":"heading","tags":[],"url":"/product-docs/getting-started/plan-your-deployment#who-uses-it","content":"Who uses the deployment plan, and how"},"3109":{"id":"/product-docs/getting-started/plan-your-deployment-26","page_id":"/product-docs/getting-started/plan-your-deployment","type":"heading","tags":[],"url":"/product-docs/getting-started/plan-your-deployment#revenue-operations","content":"Revenue operations"},"3110":{"id":"/product-docs/getting-started/plan-your-deployment-27","page_id":"/product-docs/getting-started/plan-your-deployment","type":"heading","tags":[],"url":"/product-docs/getting-started/plan-your-deployment#sales-leaders","content":"Sales leaders"},"3111":{"id":"/product-docs/getting-started/plan-your-deployment-28","page_id":"/product-docs/getting-started/plan-your-deployment","type":"heading","tags":[],"url":"/product-docs/getting-started/plan-your-deployment#customer-success-leaders","content":"Customer success leaders"},"3112":{"id":"/product-docs/getting-started/plan-your-deployment-29","page_id":"/product-docs/getting-started/plan-your-deployment","type":"heading","tags":[],"url":"/product-docs/getting-started/plan-your-deployment#enablement","content":"Enablement"},"3113":{"id":"/product-docs/getting-started/plan-your-deployment-30","page_id":"/product-docs/getting-started/plan-your-deployment","type":"heading","tags":[],"url":"/product-docs/getting-started/plan-your-deployment#compare","content":"How deployment compares"},"3114":{"id":"/product-docs/getting-started/plan-your-deployment-31","page_id":"/product-docs/getting-started/plan-your-deployment","type":"heading","tags":[],"url":"/product-docs/getting-started/plan-your-deployment#compare-stronger","content":"Why Oliv AI is the stronger choice for deployment"},"3115":{"id":"/product-docs/getting-started/plan-your-deployment-32","page_id":"/product-docs/getting-started/plan-your-deployment","type":"heading","tags":[],"url":"/product-docs/getting-started/plan-your-deployment#limits","content":"Limits and things to know"},"3116":{"id":"/product-docs/getting-started/plan-your-deployment-33","page_id":"/product-docs/getting-started/plan-your-deployment","type":"heading","tags":[],"url":"/product-docs/getting-started/plan-your-deployment#common-questions","content":"Common questions"},"3117":{"id":"/product-docs/getting-started/plan-your-deployment-34","page_id":"/product-docs/getting-started/plan-your-deployment","type":"heading","tags":[],"url":"/product-docs/getting-started/plan-your-deployment#faq-how-long","content":"How long does an Oliv AI rollout take?"},"3118":{"id":"/product-docs/getting-started/plan-your-deployment-35","page_id":"/product-docs/getting-started/plan-your-deployment","type":"heading","tags":[],"url":"/product-docs/getting-started/plan-your-deployment#faq-first-value","content":"When do reps see something useful?"},"3119":{"id":"/product-docs/getting-started/plan-your-deployment-36","page_id":"/product-docs/getting-started/plan-your-deployment","type":"heading","tags":[],"url":"/product-docs/getting-started/plan-your-deployment#faq-team-effort","content":"How much of my team's time does setup take?"},"3120":{"id":"/product-docs/getting-started/plan-your-deployment-37","page_id":"/product-docs/getting-started/plan-your-deployment","type":"heading","tags":[],"url":"/product-docs/getting-started/plan-your-deployment#faq-clean-crm","content":"Do we need to clean the CRM before we start?"},"3121":{"id":"/product-docs/getting-started/plan-your-deployment-38","page_id":"/product-docs/getting-started/plan-your-deployment","type":"heading","tags":[],"url":"/product-docs/getting-started/plan-your-deployment#faq-admin-access","content":"Which admin access do we need?"},"3122":{"id":"/product-docs/getting-started/plan-your-deployment-39","page_id":"/product-docs/getting-started/plan-your-deployment","type":"heading","tags":[],"url":"/product-docs/getting-started/plan-your-deployment#faq-proof-of-value","content":"Is there a proof of value?"},"3123":{"id":"/product-docs/getting-started/plan-your-deployment-40","page_id":"/product-docs/getting-started/plan-your-deployment","type":"heading","tags":[],"url":"/product-docs/getting-started/plan-your-deployment#faq-rep-training","content":"Do reps need training?"},"3124":{"id":"/product-docs/getting-started/plan-your-deployment-41","page_id":"/product-docs/getting-started/plan-your-deployment","type":"heading","tags":[],"url":"/product-docs/getting-started/plan-your-deployment#faq-methodology","content":"Can we use our own sales methodology?"},"3125":{"id":"/product-docs/getting-started/plan-your-deployment-42","page_id":"/product-docs/getting-started/plan-your-deployment","type":"heading","tags":[],"url":"/product-docs/getting-started/plan-your-deployment#faq-auto-mode","content":"When should CRM updates go automatic?"},"3126":{"id":"/product-docs/getting-started/plan-your-deployment-43","page_id":"/product-docs/getting-started/plan-your-deployment","type":"heading","tags":[],"url":"/product-docs/getting-started/plan-your-deployment#faq-models-after-launch","content":"Do the models keep up after launch?"},"3127":{"id":"/product-docs/getting-started/plan-your-deployment-44","page_id":"/product-docs/getting-started/plan-your-deployment","type":"heading","tags":[],"url":"/product-docs/getting-started/plan-your-deployment#related","content":"Related"},"3128":{"id":"/product-docs/getting-started/plan-your-deployment-45","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment","content":"Rolling Oliv AI out across sales and customer success takes about a month, and most of it runs in parallel. Reps get their first brief before their next meeting, while your process handbook and the manager agents come online over the following weeks. This guide gives revenue operations a week-by-week plan: who runs the setup, which admins you need, what to switch on first and what to check at day 30."},"3129":{"id":"/product-docs/getting-started/plan-your-deployment-46","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#at-a-glance","content":"|                  |                                                                               |\n| ---------------- | ----------------------------------------------------------------------------- |\n| **Who plans it** | A revenue operations lead, with a sales or CS leader to sign off the handbook |","table":"table-0"},"3130":{"id":"/product-docs/getting-started/plan-your-deployment-47","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#at-a-glance","content":"|                  |                                                                     |\n| ---------------- | ------------------------------------------------------------------- |\n| **Set-up paths** | **You Run It** (2 to 4 sessions) or **We Run It** (live in 2 weeks) |","table":"table-0"},"3131":{"id":"/product-docs/getting-started/plan-your-deployment-48","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#at-a-glance","content":"|                 |                                                            |\n| --------------- | ---------------------------------------------------------- |\n| **First value** | A brief 30 minutes before the next meeting on the calendar |","table":"table-0"},"3132":{"id":"/product-docs/getting-started/plan-your-deployment-49","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#at-a-glance","content":"|                      |                                                      |\n| -------------------- | ---------------------------------------------------- |\n| **Process handbook** | Built with Oliv AI's onboarding team in 1 to 2 weeks |","table":"table-0"},"3133":{"id":"/product-docs/getting-started/plan-your-deployment-50","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#at-a-glance","content":"|                     |                                                 |\n| ------------------- | ----------------------------------------------- |\n| **Tailored models** | Live within 1 day of the proof of value kickoff |","table":"table-0"},"3134":{"id":"/product-docs/getting-started/plan-your-deployment-51","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#at-a-glance","content":"|                     |                                                |\n| ------------------- | ---------------------------------------------- |\n| **Admins you need** | CRM, calendar or Microsoft 365, Zoom and Slack |","table":"table-0"},"3135":{"id":"/product-docs/getting-started/plan-your-deployment-52","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#at-a-glance","content":"|                            |                                                                                                                 |\n| -------------------------- | --------------------------------------------------------------------------------------------------------------- |\n| **Where you configure it** | **Settings**: stages, qualification framework, coaching scorecards, targets, measurements and forecast cadences |","table":"table-0"},"3136":{"id":"/product-docs/getting-started/plan-your-deployment-53","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#at-a-glance","content":"|                  |                                                                       |\n| ---------------- | --------------------------------------------------------------------- |\n| **Rep training** | None for forecasting or deal alerts; reps keep working as they do now |","table":"table-0"},"3137":{"id":"/product-docs/getting-started/plan-your-deployment-54","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#before-you-begin","content":"**Name an owner.** One revenue operations lead runs the plan. A sales or leadership stakeholder checks the handbook for accuracy during onboarding."},"3138":{"id":"/product-docs/getting-started/plan-your-deployment-55","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#before-you-begin","content":"**Gather what you have.** Bring your existing handbook, playbooks and methodology decks, even if they're messy or incomplete. Oliv AI's onboarding team works from them."},"3139":{"id":"/product-docs/getting-started/plan-your-deployment-56","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#before-you-begin","content":"**Find your admins.** Some connections need an admin on the other side. The table in Step 2 lists who to book."},"3140":{"id":"/product-docs/getting-started/plan-your-deployment-57","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#before-you-begin","content":"**Decide your seat roles.** Each person gets the plan that fits their work. Plans and seat roles helps you map your team before you invite anyone."},"3141":{"id":"/product-docs/getting-started/plan-your-deployment-58","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#before-you-begin","content":"**Don't clean the CRM first.** Oliv AI reads what's already there, messy data included."},"3142":{"id":"/product-docs/getting-started/plan-your-deployment-59","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#before-you-begin","content":"**Know where Settings lives.** **Settings**, at the bottom of the sidebar, opens **Revenue Process**, **Qualification Framework**, **Coaching Scorecard**, **Targets**, **Measurements**, **Organisational Settings** and **Profile Settings**. Steps 4 and 6 use most of them."},"3143":{"id":"/product-docs/getting-started/plan-your-deployment-60","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#before-you-begin","content":"Most of the rollout's configuration sits behind one menu: the stages, framework, scorecards, targets and cadences your agents and forecast work from."},"3144":{"id":"/product-docs/getting-started/plan-your-deployment-61","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-1-choose-a-path","content":"Oliv AI offers two set-up paths. Pick one before kickoff, because it decides how much of your team's time the rollout takes."},"3145":{"id":"/product-docs/getting-started/plan-your-deployment-62","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-1-choose-a-path","content":"|                     | You Run It      | We Run It       |\n| ------------------- | --------------- | --------------- |\n| **Time to onboard** | 2 to 4 sessions | Live in 2 weeks |","table":"table-1"},"3146":{"id":"/product-docs/getting-started/plan-your-deployment-63","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-1-choose-a-path","content":"|                                 | You Run It                                                 | We Run It                           |\n| ------------------------------- | ---------------------------------------------------------- | ----------------------------------- |\n| **Who maintains the playbooks** | Your revenue operations team, working with Oliver directly | Oliv AI's operators, on your behalf |","table":"table-1"},"3147":{"id":"/product-docs/getting-started/plan-your-deployment-64","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-1-choose-a-path","content":"|                      | You Run It                | We Run It |\n| -------------------- | ------------------------- | --------- |\n| **Prompts to write** | Yours to write and change | None      |","table":"table-1"},"3148":{"id":"/product-docs/getting-started/plan-your-deployment-65","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-1-choose-a-path","content":"|             | You Run It                     | We Run It               |\n| ----------- | ------------------------------ | ----------------------- |\n| **Control** | Full control over every update | Updates handled for you |","table":"table-1"},"3149":{"id":"/product-docs/getting-started/plan-your-deployment-66","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-1-choose-a-path","content":"Choose **You Run It** if your revenue operations team wants to own every rule change. Choose **We Run It** if the team is stretched and you'd rather review than build. Either way, Oliv AI's Oliver agent holds the result."},"3150":{"id":"/product-docs/getting-started/plan-your-deployment-67","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-2-admin-access","content":"Book the admins you need in week one, so no connection waits on a calendar invite."},"3151":{"id":"/product-docs/getting-started/plan-your-deployment-68","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-2-admin-access","content":"| Connection     | Who you need       | Why                                                                    |\n| -------------- | ------------------ | ---------------------------------------------------------------------- |\n| **Salesforce** | A Salesforce admin | Installs the Oliv AI package for all users from the admin install link |","table":"table-2"},"3152":{"id":"/product-docs/getting-started/plan-your-deployment-69","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-2-admin-access","content":"| Connection  | Who you need                             | Why                                                           |\n| ----------- | ---------------------------------------- | ------------------------------------------------------------- |\n| **HubSpot** | Whoever connects the HubSpot integration | Connects it in the Oliv AI web app and shares the HubSpot URL |","table":"table-2"},"3153":{"id":"/product-docs/getting-started/plan-your-deployment-70","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-2-admin-access","content":"| Connection   | Who you need                                    | Why                                                        |\n| ------------ | ----------------------------------------------- | ---------------------------------------------------------- |\n| **Calendar** | Each user, by logging in to the Oliv AI web app | Required: without it, Oliv AI can't take notes in meetings |","table":"table-2"},"3154":{"id":"/product-docs/getting-started/plan-your-deployment-71","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-2-admin-access","content":"| Connection         | Who you need                                         | Why                                                                  |\n| ------------------ | ---------------------------------------------------- | -------------------------------------------------------------------- |\n| **Outlook add-in** | Your Microsoft 365 administrator, if add-ins are off | Add-ins for Outlook must be activated before people can install them |","table":"table-2"},"3155":{"id":"/product-docs/getting-started/plan-your-deployment-72","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-2-admin-access","content":"| Connection | Who you need | Why                                                                       |\n| ---------- | ------------ | ------------------------------------------------------------------------- |\n| **Zoom**   | A Zoom admin | Grants the permission that lets meetings record when the host isn't there |","table":"table-2"},"3156":{"id":"/product-docs/getting-started/plan-your-deployment-73","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-2-admin-access","content":"| Connection | Who you need                                              | Why                                                 |\n| ---------- | --------------------------------------------------------- | --------------------------------------------------- |\n| **Slack**  | A Slack workspace admin, if your workspace needs approval | Approves the Oliv AI app or a Slack Connect channel |","table":"table-2"},"3157":{"id":"/product-docs/getting-started/plan-your-deployment-74","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-2-admin-access","content":"If the Slack app or Slack Connect can't be approved in time, onboarding carries on and messages go by email until Slack is connected. The Salesforce guide and the Zoom guide cover those two installs step by step."},"3158":{"id":"/product-docs/getting-started/plan-your-deployment-75","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-3-connect","content":"Connect the CRM first. Oliver needs it for schema alignment, and every agent reads pipeline and deal history from it. Salesforce, HubSpot and Zoho are supported."},"3159":{"id":"/product-docs/getting-started/plan-your-deployment-76","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-3-connect","content":"Then connect calendars, your call recorder and Slack or Teams. Calendars tell Oliv AI which meetings are coming. The recorder is the main source of live context, whether that's Oliv AI's own notetaker or a tool you already use. Email is optional but adds context between meetings. Most teams are connected within a week, and the integrations overview shows how each connection fits."},"3160":{"id":"/product-docs/getting-started/plan-your-deployment-77","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-4-handbook","content":"Oliv AI's onboarding team works with your revenue operations lead to translate existing playbooks, CRM configuration and methodology into Oliver's structured format. This typically takes one to two weeks. The handbook covers:"},"3161":{"id":"/product-docs/getting-started/plan-your-deployment-78","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-4-handbook","content":"**Who you sell to.** Your ICP and the signals that qualify an account."},"3162":{"id":"/product-docs/getting-started/plan-your-deployment-79","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-4-handbook","content":"**Who you sell to inside each account.** Your persona library."},"3163":{"id":"/product-docs/getting-started/plan-your-deployment-80","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-4-handbook","content":"**How you qualify.** The framework your team uses, such as MEDDPICC, BANT or SPICED, and the fields each stage requires."},"3164":{"id":"/product-docs/getting-started/plan-your-deployment-81","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-4-handbook","content":"**Who approves what.** Pricing desk triggers and the deal size where manager sign-off starts."},"3165":{"id":"/product-docs/getting-started/plan-your-deployment-82","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-4-handbook","content":"**How proofs of concept run.** What makes one eligible, what success looks like and how long it should last."},"3166":{"id":"/product-docs/getting-started/plan-your-deployment-83","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-4-handbook","content":"**How proposals and territories work.** Review steps, approvals and who owns which pipeline."},"3167":{"id":"/product-docs/getting-started/plan-your-deployment-84","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-4-handbook","content":"Your stakeholder checks each section for accuracy. Once it's in place, every agent works inside those rules from day one. Oliver's proposed changes wait as **Pending Review** until your company approves them, and minor ones that apply on their own are still logged in the Playbook's **History**."},"3168":{"id":"/product-docs/getting-started/plan-your-deployment-85","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-4-settings","content":"While the handbook is built, set the two definitions every deal is measured against."},"3169":{"id":"/product-docs/getting-started/plan-your-deployment-86","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-4-settings","content":"**Open Settings › Revenue Process.** Each sales motion has its own tab, such as **Enterprise Sales**, **Mid-Market sales** and **Customer Success**."},"3170":{"id":"/product-docs/getting-started/plan-your-deployment-87","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-4-settings","content":"**Bring in your stages.** Click **Import Pipeline from CRM** to pull the existing stages from the connected CRM."},"3171":{"id":"/product-docs/getting-started/plan-your-deployment-88","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-4-settings","content":"**Check each stage.** The table shows **Type** (**Open**, **Closed/Won** or **Closed/Lost**), **Probability** and the **Forecast Category** it rolls into, plus counts of **Outcomes** and **Entry Criteria**."},"3172":{"id":"/product-docs/getting-started/plan-your-deployment-89","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-4-settings","content":"Your stages, imported from the CRM and mapped to a probability and forecast category, are what deal alerts and the forecast read from week one."},"3173":{"id":"/product-docs/getting-started/plan-your-deployment-90","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-4-settings","content":"**Open Settings › Qualification Framework.** The tabs are **MEDDPICC**, **MEDDIC**, **SPICED**, **BANT** and **DRIVE**, and the one in use carries an **Active** badge."},"3174":{"id":"/product-docs/getting-started/plan-your-deployment-91","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-4-settings","content":"**Preview, then activate.** Click a tab to see its criteria, scoring range and supporting fields, then click **Activate** to switch your organisation to it. Agents then score meetings and deals against that framework."},"3175":{"id":"/product-docs/getting-started/plan-your-deployment-92","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-4-settings","content":"Pick the framework once, here, before managers switch on: every meeting insight and deal health score in the rollout is measured against the active one."},"3176":{"id":"/product-docs/getting-started/plan-your-deployment-93","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-5-first-value","content":"Reps don't wait for the handbook to finish. Oliv AI's Olivia agent delivers deal context, risk and next steps 30 minutes before the next meeting on the calendar, with no waiting period. For meetings on an active deal, Oliv AI's Meeting Assistant agent adds qualification status and a recommended agenda, as the meeting preparation guide shows."},"3177":{"id":"/product-docs/getting-started/plan-your-deployment-94","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-5-first-value","content":"At the same time, start Oliv AI's CRM Manager agent in **Ask First** mode. From the first meeting, call or email it proposes updates, and each one waits for review before anything reaches the CRM. Your reps learn what it gets right while nothing changes without them."},"3178":{"id":"/product-docs/getting-started/plan-your-deployment-95","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-6-managers","content":"In weeks two to four, bring the manager agents online. Each has its own set-up time:"},"3179":{"id":"/product-docs/getting-started/plan-your-deployment-96","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-6-managers","content":"| Agent           | What you set                                                 | Typical time to live                 |\n| --------------- | ------------------------------------------------------------ | ------------------------------------ |\n| **Deal Driver** | Connect the CRM and team calendar, then set alert thresholds | Most managers are live within a week |","table":"table-3"},"3180":{"id":"/product-docs/getting-started/plan-your-deployment-97","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-6-managers","content":"| Agent          | What you set                                                        | Typical time to live                 |\n| -------------- | ------------------------------------------------------------------- | ------------------------------------ |\n| **Forecaster** | Set targets, measurements and your forecast cadence in **Settings** | Most teams are live within two weeks |","table":"table-3"},"3181":{"id":"/product-docs/getting-started/plan-your-deployment-98","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-6-managers","content":"| Agent     | What you set                                                                    | Typical time to live                  |\n| --------- | ------------------------------------------------------------------------------- | ------------------------------------- |\n| **Coach** | Pick scorecards in **Settings › Coaching Scorecard** or bring your own criteria | First monthly review within two weeks |","table":"table-3"},"3182":{"id":"/product-docs/getting-started/plan-your-deployment-99","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-6-managers","content":"| Agent                 | What you set                                                 | Typical time to live         |\n| --------------------- | ------------------------------------------------------------ | ---------------------------- |\n| **Portfolio Manager** | Connect CRM, recordings, email, calendar and engagement data | Depends on your integrations |","table":"table-3"},"3183":{"id":"/product-docs/getting-started/plan-your-deployment-100","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-6-managers","content":"Oliv AI's Deal Driver agent works in the background, so reps don't need to change anything. Oliv AI's Forecaster agent needs no rep training; reps see a pre-drafted view where they'd normally submit by hand. Oliv AI's Coach agent needs about ten calls per rep to find a real pattern. For customer success, Oliv AI's Portfolio Manager agent builds a briefing of each CSM's book before every scheduled 1:1."},"3184":{"id":"/product-docs/getting-started/plan-your-deployment-101","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-6-forecast-settings","content":"The Forecaster agent works from four settings. Set them in this order:"},"3185":{"id":"/product-docs/getting-started/plan-your-deployment-102","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-6-forecast-settings","content":"**Targets.** In **Settings › Targets**, click **Create Target**, assign the users it applies to and track **Overall Progress**. Finished targets move to **Completed Targets**."},"3186":{"id":"/product-docs/getting-started/plan-your-deployment-103","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-6-forecast-settings","content":"**Measurements.** In **Settings › Measurements**, click **Create Measurement**. A **Basic** measurement sums or counts deals, and a **Formula** measurement combines others, as **Pipeline Coverage** does."},"3187":{"id":"/product-docs/getting-started/plan-your-deployment-104","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-6-forecast-settings","content":"**Boards.** In **Organisational Settings › Monitoring › Boards**, group your forecast boards into collections, each with its target and users."},"3188":{"id":"/product-docs/getting-started/plan-your-deployment-105","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-6-forecast-settings","content":"**Cadence.** In **Organisational Settings › Agents › Forecaster**, the **Cadences** table shows each cadence's board and the days reps and managers submit. Click **Add** to create one."},"3189":{"id":"/product-docs/getting-started/plan-your-deployment-106","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-6-forecast-settings","content":"Each cadence ties a board to submission days for reps and managers, so the Forecaster knows when to ask each role for their number."},"3190":{"id":"/product-docs/getting-started/plan-your-deployment-107","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-6-forecast-settings","content":"**Add** opens the **New Cadence** wizard in three steps: **Overview**, **Boards & Measurements** and **People**. On **Overview**, type a **Title** and **Description**, then pick a **Period**: **Weekly**, **Monthly** or **Quarterly**. With **Monthly**, you set a **Rep Submission Day** and a **Manager Submission Day**, each by week and day. Click **Next** to choose boards and measurements, then people."},"3191":{"id":"/product-docs/getting-started/plan-your-deployment-108","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-6-forecast-settings","content":"Step 1 of a new cadence: name it, pick how often it repeats, and set separate days for reps and managers to submit."},"3192":{"id":"/product-docs/getting-started/plan-your-deployment-109","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-6-forecast-settings","content":"**Monitoring › Cadence** then shows the submission plan week by week. Switch **Period** between **Quarterly** and **Monthly**, expand a period and tick which measurements are due in each week."},"3193":{"id":"/product-docs/getting-started/plan-your-deployment-110","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-6-scorecards","content":"**Settings › Coaching Scorecard** is the library Coach applies, grouped into **Deals**, **Customers**, **Meetings** and **Phone calls**. Each scorecard has a description and its **Evaluations (Last 30 days)**, so you can see which ones are already in use before the first monthly review."},"3194":{"id":"/product-docs/getting-started/plan-your-deployment-111","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-6-scorecards","content":"The starting scorecards for enablement to review: one library across deals, customers, meetings and phone calls, with a usage count beside each."},"3195":{"id":"/product-docs/getting-started/plan-your-deployment-112","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-7-review","content":"**Check the CRM updates.** Look at what reps accepted and rejected. Once accuracy thresholds are met, revenue operations confirms the switch to auto mode, as the CRM upkeep guide explains."},"3196":{"id":"/product-docs/getting-started/plan-your-deployment-113","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-7-review","content":"**Read the first coaching review.** Coach's monthly review shows whether the scorecards match how you want calls run."},"3197":{"id":"/product-docs/getting-started/plan-your-deployment-114","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-7-review","content":"**Watch a pipeline review.** Managers should open their 1:1s with Deal Driver's report, as in the pipeline review workflow."},"3198":{"id":"/product-docs/getting-started/plan-your-deployment-115","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#step-7-review","content":"**Tell Oliver what changed.** Anything you learned in the month goes to Oliver as a process update. It waits as **Pending Review** until you approve it, then every connected agent picks it up."},"3199":{"id":"/product-docs/getting-started/plan-your-deployment-116","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#what-it-is","content":"A deployment plan is the order in which you connect tools, build rules and switch on agents, so each team gets value as early as possible. Oliv AI splits it into two tracks that run at once."},"3200":{"id":"/product-docs/getting-started/plan-your-deployment-117","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#what-it-is","content":"| Track           | What happens                                              | Who's involved                 | When     |\n| --------------- | --------------------------------------------------------- | ------------------------------ | -------- |\n| **Value track** | Briefs, follow-ups and proposed CRM updates start flowing | Reps, from their first meeting | Week one |","table":"table-4"},"3201":{"id":"/product-docs/getting-started/plan-your-deployment-118","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#what-it-is","content":"| Track             | What happens                                                         | Who's involved                                          | When              |\n| ----------------- | -------------------------------------------------------------------- | ------------------------------------------------------- | ----------------- |\n| **Process track** | The handbook is built, models are tailored, manager agents switch on | Revenue operations, Oliv AI's onboarding team, managers | Weeks one to four |","table":"table-4"},"3202":{"id":"/product-docs/getting-started/plan-your-deployment-119","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#what-it-is","content":"The tracks meet in the handbook. Oliv AI's Oliver agent keeps the rules, and Oliv AI's Olivia agent runs inside them for every rep. Behind both, Oliv AI tailors its signal models to your company. It researches what you sell, takes in your enablement materials and writes tailored prompts, so each model surfaces only the signals that matter to your motion. A tailored version is live within 1 day of the proof of value kickoff. For the wider architecture, read the RevOps guide to agentic AI."},"3203":{"id":"/product-docs/getting-started/plan-your-deployment-120","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#what-its-for","content":"A plan puts the right agent in front of the right team in the right week. Reps see value early, and managers get agents built on rules you've agreed."},"3204":{"id":"/product-docs/getting-started/plan-your-deployment-121","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#how-it-helps","content":"**Reps feel it first.** The first brief lands before the next meeting, so adoption starts on day one."},"3205":{"id":"/product-docs/getting-started/plan-your-deployment-122","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#how-it-helps","content":"**Admins are booked early.** CRM, Zoom and Slack approvals don't stall the rollout in week three."},"3206":{"id":"/product-docs/getting-started/plan-your-deployment-123","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#how-it-helps","content":"**Rules come before scale.** Managers get alerts and forecasts that follow one agreed process."},"3207":{"id":"/product-docs/getting-started/plan-your-deployment-124","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#how-it-helps","content":"**Trust is earned.** CRM updates start in review, and auto mode waits until the numbers say so."},"3208":{"id":"/product-docs/getting-started/plan-your-deployment-125","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#without-it","content":"Without a plan, a rollout tends to switch everything on at once. Reps get alerts before the rules behind them are agreed. Managers see forecasts built on fields nobody mapped. The first impression is noise, and some teams never come back from that."},"3209":{"id":"/product-docs/getting-started/plan-your-deployment-126","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#why-buyers-care","content":"This matters most to revenue operations leads, who own the rollout and answer for its results. It matters to sales and CS leaders too, who need their teams working in it within the month. It counts most when the contract starts close to a quarter or renewal season, because there's no slack for a slow start."},"3210":{"id":"/product-docs/getting-started/plan-your-deployment-127","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#approach","content":"Say a revenue operations lead has just signed with Oliv AI for 25 account executives and a customer success team of eight. Leadership wants both teams using it by the end of the month. She has a methodology deck from last year, a CRM full of half-filled fields and one free afternoon a week."},"3211":{"id":"/product-docs/getting-started/plan-your-deployment-128","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#approach","content":"The usual route is to clean the CRM, write the playbook down properly and then train everyone at once. Each of those steps can take weeks on its own. By the time they're done, the quarter has moved on and the team has lost interest."},"3212":{"id":"/product-docs/getting-started/plan-your-deployment-129","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#approach","content":"Nothing about the agents needs a finished playbook before reps can start. A brief only needs a calendar, a recorder and a CRM. The rules can be built alongside, as long as someone owns them and reviews each change."},"3213":{"id":"/product-docs/getting-started/plan-your-deployment-130","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#approach","content":"Oliv AI runs both tracks for her. Reps get their first brief before their next meeting, while Oliv AI's onboarding team turns her deck into Oliver's handbook in one to two weeks. If she picks We Run It, Oliv AI's operators maintain the playbooks on her behalf."},"3214":{"id":"/product-docs/getting-started/plan-your-deployment-131","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#approach","content":"The proof of value adds one more piece: a tailored version of Oliv AI is live within 1 day of kickoff. How other platforms handle setup and tailoring is covered in How deployment compares, below."},"3215":{"id":"/product-docs/getting-started/plan-your-deployment-132","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#with-seat-roles","content":"Plans are sold by role, so the rollout order often follows them. Account executives and CSMs on the deal apps come first, and managers follow as their agents switch on. Seat roles explained shows which apps each person gets."},"3216":{"id":"/product-docs/getting-started/plan-your-deployment-133","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#with-field-mapping","content":"Custom fields on your opportunity record need a home before CRM Manager can fill them. CRM field mapping is set up during onboarding, alongside the handbook."},"3217":{"id":"/product-docs/getting-started/plan-your-deployment-134","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#with-approvals","content":"Agents that write to your CRM, calendar or mailbox can ask before acting. Agent tools and run modes explains how to keep early rollouts on approval and relax it later."},"3218":{"id":"/product-docs/getting-started/plan-your-deployment-135","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#with-recording","content":"When your company organizes a meeting, Oliv AI can record without a visible bot. Bot and botless recording explains what customers see, which helps when you brief the team."},"3219":{"id":"/product-docs/getting-started/plan-your-deployment-136","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#who-uses-it","content":"These are typical patterns, shown to illustrate how teams roll Oliv AI out."},"3220":{"id":"/product-docs/getting-started/plan-your-deployment-137","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#revenue-operations","content":"A revenue operations lead owns the plan end to end. She books the admins, works with Oliv AI's onboarding team on the handbook and decides when CRM Manager moves to auto mode. Afterwards she keeps the rules current through Oliver."},"3221":{"id":"/product-docs/getting-started/plan-your-deployment-138","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#sales-leaders","content":"A VP of Sales signs off the qualification rules in the handbook. Two weeks later, first-line managers open their 1:1s with Deal Driver's report, and the forecast follows within the month."},"3222":{"id":"/product-docs/getting-started/plan-your-deployment-139","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#customer-success-leaders","content":"A head of customer success brings the CSMs on in week one for briefs and follow-ups. Portfolio Manager's 1:1 briefings follow once recordings and CRM data are flowing."},"3223":{"id":"/product-docs/getting-started/plan-your-deployment-140","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#enablement","content":"An enablement manager picks Coach's starting scorecards and reads the first monthly review. It's a quick way to see where new hires need help, as covered in cutting new-hire ramp time."},"3224":{"id":"/product-docs/getting-started/plan-your-deployment-141","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#compare","content":"Oliv AI's onboarding team builds your process handbook with your revenue operations lead, and you can hand ongoing upkeep to Oliv AI's operators. Signal models are tailored to your company within a day of the proof of value kickoff. Oliv AI is the only platform in this table that does all three."},"3225":{"id":"/product-docs/getting-started/plan-your-deployment-142","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#compare","content":"Setup and onboarding, from each platform's public documentation:"},"3226":{"id":"/product-docs/getting-started/plan-your-deployment-143","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#compare","content":"| Platform    | Vendor team builds your process setup with you | Vendor-run option for ongoing upkeep | Tailored to your company within a day |\n| ----------- | ---------------------------------------------- | ------------------------------------ | ------------------------------------- |\n| **Oliv AI** | Yes                                            | Yes                                  | Yes                                   |","table":"table-5"},"3227":{"id":"/product-docs/getting-started/plan-your-deployment-144","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#compare","content":"| Platform | Vendor team builds your process setup with you | Vendor-run option for ongoing upkeep | Tailored to your company within a day   |\n| -------- | ---------------------------------------------- | ------------------------------------ | --------------------------------------- |\n| **Gong** | Partly (onboarding consultant for data import) | Not in docs                          | Partly (AI trackers you build yourself) |","table":"table-5"},"3228":{"id":"/product-docs/getting-started/plan-your-deployment-145","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#compare","content":"| Platform     | Vendor team builds your process setup with you | Vendor-run option for ongoing upkeep | Tailored to your company within a day |\n| ------------ | ---------------------------------------------- | ------------------------------------ | ------------------------------------- |\n| **Outreach** | Partly (billable services projects)            | Not in docs                          | Not in docs                           |","table":"table-5"},"3229":{"id":"/product-docs/getting-started/plan-your-deployment-146","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#compare","content":"| Platform         | Vendor team builds your process setup with you | Vendor-run option for ongoing upkeep | Tailored to your company within a day |\n| ---------------- | ---------------------------------------------- | ------------------------------------ | ------------------------------------- |\n| **Fireflies.ai** | Partly (guided onboarding on Enterprise)       | Not in docs                          | Not in docs                           |","table":"table-5"},"3230":{"id":"/product-docs/getting-started/plan-your-deployment-147","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#compare","content":"| Platform  | Vendor team builds your process setup with you | Vendor-run option for ongoing upkeep | Tailored to your company within a day |\n| --------- | ---------------------------------------------- | ------------------------------------ | ------------------------------------- |\n| **Avoma** | Partly (designated CSM on higher plans)        | Not in docs                          | Not in docs                           |","table":"table-5"},"3231":{"id":"/product-docs/getting-started/plan-your-deployment-148","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#compare","content":"*Yes: documented and built in. Partly: documented with a limit, shown in brackets. Not in docs: not found in the vendor's public documentation.*"},"3232":{"id":"/product-docs/getting-started/plan-your-deployment-149","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#compare-stronger","content":"**Your process, built with you.** Oliv AI's onboarding team turns your playbooks and methodology into Oliver's handbook in one to two weeks. Gong documents working with an onboarding consultant to bring in historical CRM data. See Gong vs Oliv AI."},"3233":{"id":"/product-docs/getting-started/plan-your-deployment-150","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#compare-stronger","content":"**Upkeep you can hand off.** On the We Run It path, Oliv AI's operators maintain the playbooks for you. Outreach describes its professional services as billable projects. See Gong vs Outreach, and where Oliv AI fits."},"3234":{"id":"/product-docs/getting-started/plan-your-deployment-151","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#compare-stronger","content":"**Tailored on day one.** Oliv AI tailors its signal models within 1 day of the proof of value kickoff. Gong documents AI trackers that you write and publish yourself. See Oliv AI as a Gong alternative."},"3235":{"id":"/product-docs/getting-started/plan-your-deployment-152","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#compare-stronger","content":"**Support that sets things up.** Oliv AI's onboarding team builds the handbook with your revenue operations lead. Avoma documents a designated customer success manager on its Organization and Enterprise plans. See Oliv AI vs Avoma."},"3236":{"id":"/product-docs/getting-started/plan-your-deployment-153","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#compare-stronger","content":"*Competitor details checked against each vendor's public documentation on 22 October 2026. Features and plans change, so confirm with the vendor before you decide.*"},"3237":{"id":"/product-docs/getting-started/plan-your-deployment-154","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#limits","content":"**The calendar comes first.** Oliv AI can't take notes in meetings until calendars are connected, so that step can't be skipped or delayed."},"3238":{"id":"/product-docs/getting-started/plan-your-deployment-155","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#limits","content":"**Some steps need an admin.** Salesforce, Zoom recording without the host and, in some workspaces, Slack all need an admin on your side."},"3239":{"id":"/product-docs/getting-started/plan-your-deployment-156","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#limits","content":"**Handbook changes are reviewed or logged.** Oliver's proposals wait for your company's approval. Minor changes can apply on their own, and every change appears in the Playbook's **History**."},"3240":{"id":"/product-docs/getting-started/plan-your-deployment-157","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#limits","content":"**Reps don't work with Oliver.** Revenue operations and leaders do. Reps work with Olivia, who follows Oliver's rules."},"3241":{"id":"/product-docs/getting-started/plan-your-deployment-158","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#limits","content":"**Coaching needs call volume.** Coach looks for about ten calls per rep before it reports a pattern."},"3242":{"id":"/product-docs/getting-started/plan-your-deployment-159","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#limits","content":"**Auto mode is a decision.** CRM Manager starts in review. Revenue operations confirms the switch to auto mode once accuracy thresholds are met."},"3243":{"id":"/product-docs/getting-started/plan-your-deployment-160","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#faq-how-long","content":"Reps get value in the first week, from their first brief. The handbook takes one to two weeks, and the manager agents are typically live within one to two weeks of being connected."},"3244":{"id":"/product-docs/getting-started/plan-your-deployment-161","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#faq-first-value","content":"Before their next meeting. Oliv AI's Olivia agent delivers deal context, risk and next steps 30 minutes before the next meeting on the calendar, with no waiting period."},"3245":{"id":"/product-docs/getting-started/plan-your-deployment-162","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#faq-team-effort","content":"On the You Run It path, onboarding takes 2 to 4 sessions with your revenue operations team. On We Run It, there are no prompts to write and Oliv AI's operators maintain the playbooks."},"3246":{"id":"/product-docs/getting-started/plan-your-deployment-163","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#faq-clean-crm","content":"No. Oliv AI reads what's already there, messy data included. Oliv AI's CRM Manager agent fills missing or stale fields from call history as it goes."},"3247":{"id":"/product-docs/getting-started/plan-your-deployment-164","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#faq-admin-access","content":"A Salesforce admin for the package install, a Zoom admin for recording without the host, and a Slack admin if your workspace needs approval. Each user connects their own calendar by logging in."},"3248":{"id":"/product-docs/getting-started/plan-your-deployment-165","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#faq-proof-of-value","content":"Yes. A tailored version of Oliv AI is live within 1 day of the proof of value kickoff. Oliv AI researches your company and writes tailored prompts for each signal model."},"3249":{"id":"/product-docs/getting-started/plan-your-deployment-166","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#faq-rep-training","content":"Not for forecasting or deal alerts. Reps see a pre-drafted forecast view where they'd normally submit by hand, and Deal Driver works in the background."},"3250":{"id":"/product-docs/getting-started/plan-your-deployment-167","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#faq-methodology","content":"Yes. In **Settings › Qualification Framework**, preview **MEDDPICC**, **MEDDIC**, **SPICED**, **BANT** or **DRIVE**, then click **Activate**. Agents then score meetings and deals against the framework you chose."},"3251":{"id":"/product-docs/getting-started/plan-your-deployment-168","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#faq-auto-mode","content":"When the team trusts them. Updates start in review, and revenue operations confirms the switch to auto mode once accuracy thresholds are met."},"3252":{"id":"/product-docs/getting-started/plan-your-deployment-169","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#faq-models-after-launch","content":"Yes. Human feedback and quarterly re-research track new offerings, positioning and buyer personas as your company changes."},"3253":{"id":"/product-docs/getting-started/plan-your-deployment-170","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#related","content":"Oliv AI product documentation: every guide, by agent and feature."},"3254":{"id":"/product-docs/getting-started/plan-your-deployment-171","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#related","content":"Agents overview: what each Oliv AI agent does, before you decide the rollout order."},"3255":{"id":"/product-docs/getting-started/plan-your-deployment-172","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#related","content":"Slack integration: the meeting messages your team gets once Slack is connected."},"3256":{"id":"/product-docs/getting-started/plan-your-deployment-173","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#related","content":"Customer onboarding with Oliv AI: how onboarding teams use Oliv AI agents with their own customers."},"3257":{"id":"/product-docs/getting-started/plan-your-deployment-174","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment#related","content":"Plans and pricing: how Oliv AI is priced."},"3258":{"id":"/product-docs","page_id":"/product-docs","type":"page","content":"Oliv AI product documentation","breadcrumbs":["Oliv AI docs"],"tags":[],"url":"/product-docs"},"3259":{"id":"/product-docs-0","page_id":"/product-docs","tags":[],"type":"text","url":"/product-docs","content":"How Oliv AI's agents and apps work, from asking Olivia a question to recording meetings, keeping the CRM current and running pipeline reviews."},"3260":{"id":"/product-docs-1","page_id":"/product-docs","type":"heading","tags":[],"url":"/product-docs#what-oliv-ai-is","content":"What Oliv AI is"},"3261":{"id":"/product-docs-2","page_id":"/product-docs","type":"heading","tags":[],"url":"/product-docs#start-here","content":"Start here"},"3262":{"id":"/product-docs-3","page_id":"/product-docs","type":"heading","tags":[],"url":"/product-docs#agents","content":"Agents"},"3263":{"id":"/product-docs-4","page_id":"/product-docs","type":"heading","tags":[],"url":"/product-docs#agent-builder","content":"How an agent is built"},"3264":{"id":"/product-docs-5","page_id":"/product-docs","type":"heading","tags":[],"url":"/product-docs#apps","content":"Apps"},"3265":{"id":"/product-docs-6","page_id":"/product-docs","type":"heading","tags":[],"url":"/product-docs#workflows","content":"Workflows and use cases"},"3266":{"id":"/product-docs-7","page_id":"/product-docs","type":"heading","tags":[],"url":"/product-docs#integrations","content":"Integrations and plans"},"3267":{"id":"/product-docs-8","page_id":"/product-docs","tags":[],"type":"text","url":"/product-docs#what-oliv-ai-is","content":"Oliv AI builds AI agents for revenue teams. It works as a layer on top of the CRM you already use, not as a replacement for it. The agents work alongside your team to prospect, close, retain and expand revenue."},"3268":{"id":"/product-docs-9","page_id":"/product-docs","tags":[],"type":"text","url":"/product-docs#what-oliv-ai-is","content":"You ask for work in plain language. Oliv AI's Olivia agent runs the day-to-day work and hands tasks to specialist agents. Oliv AI's Oliver agent keeps the rules: your stages, ownership and handoffs."},"3269":{"id":"/product-docs-10","page_id":"/product-docs","tags":[],"type":"text","url":"/product-docs#what-oliv-ai-is","content":"Everything starts from one sidebar: **Home**, **Agents**, **Apps**, **Reports**, **Records** and **Activities**, with **Playbook** and **Settings** at the bottom. **Home** has two tabs. **Ask** is where you talk to Olivia or Oliver, and **Agent Feed** is one stream of what your agents have done."},"3270":{"id":"/product-docs-11","page_id":"/product-docs","tags":[],"type":"text","url":"/product-docs#what-oliv-ai-is","content":"Home is where most people start: ask Oliv AI's Olivia agent for work in plain language, and switch to the Agent Feed to see what was done."},"3271":{"id":"/product-docs-12","page_id":"/product-docs","tags":[],"type":"text","url":"/product-docs#agents","content":"Agents are the product. Each one owns a part of the revenue workflow. Oliv AI's Deal Driver agent watches the pipeline and tells managers which deals need attention. Oliv AI's CRM Manager agent fills CRM fields from calls, emails and meetings, and you can map your custom fields so updates land in the right place."},"3272":{"id":"/product-docs-13","page_id":"/product-docs","tags":[],"type":"text","url":"/product-docs#agents","content":"Each agent posts its work to the **Agent Feed**, which you can filter by team, role, agent and time."},"3273":{"id":"/product-docs-14","page_id":"/product-docs","tags":[],"type":"text","url":"/product-docs#agents","content":"The feed shows a rep's day as the agents saw it, from Oliv AI's Olivia agent's morning brief to the evening CRM updates. Names and figures are sample data."},"3274":{"id":"/product-docs-15","page_id":"/product-docs","tags":[],"type":"text","url":"/product-docs#agents","content":"Oliv AI's Meeting Assistant agent prepares you before a meeting and drafts the follow-up after it. Oliv AI's Forecaster agent drafts each rep's forecast, and Oliv AI's Coach agent scores calls and sets a goal for each rep."},"3275":{"id":"/product-docs-16","page_id":"/product-docs","tags":[],"type":"text","url":"/product-docs#agent-builder","content":"**Agents** in the sidebar opens the marketplace, where you filter agents by team or search by the job they do."},"3276":{"id":"/product-docs-17","page_id":"/product-docs","tags":[],"type":"text","url":"/product-docs#agent-builder","content":"The marketplace lists the specialist agents by team. Each card opens an agent page built from the parts described below."},"3277":{"id":"/product-docs-18","page_id":"/product-docs","tags":[],"type":"text","url":"/product-docs#agent-builder","content":"The agent builder shows what each agent is made of. Its tools and run modes decide which actions run on their own and which wait for approval. Triggers start an agent when something happens, knowledge files give it your material, instructions spell out its process, and run history records what it did."},"3278":{"id":"/product-docs-19","page_id":"/product-docs","tags":[],"type":"text","url":"/product-docs#apps","content":"Oliv AI's apps group the screens each role works in. In Converse, the meetings list and meeting details hold every recorded call. In the sidebar, meetings and calls sit under **Activities**. Clips save the moments worth sharing, and recording modes cover recording with or without a bot."},"3279":{"id":"/product-docs-20","page_id":"/product-docs","tags":[],"type":"text","url":"/product-docs#workflows","content":"Workflows follow a deal's week across several agents: you record a meeting and follow up, keep the CRM updated between meetings and run a pipeline review at the end of the week."},"3280":{"id":"/product-docs-21","page_id":"/product-docs","tags":[],"type":"text","url":"/product-docs#workflows","content":"Use cases start from a role. Running deals as an account executive shows how one AE uses the agents across a week of calls."},"3281":{"id":"/product-docs-22","page_id":"/product-docs","tags":[],"type":"text","url":"/product-docs#integrations","content":"Oliv AI's integrations bring in the context agents work from: HubSpot as well as Salesforce for the CRM, Zoom for meetings and Slack for summaries and alerts. Plans explain how seat roles, add-ons and agent actions fit together. Prices are on the Oliv AI pricing page."},"3282":{"id":"/product-docs/integrations/gmail","page_id":"/product-docs/integrations/gmail","type":"page","content":"Gmail","breadcrumbs":["Oliv AI docs","Integrations"],"tags":[],"url":"/product-docs/integrations/gmail"},"3283":{"id":"/product-docs/integrations/gmail-0","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail","content":"How Oliv AI connects to Gmail, files every customer email against the right deal, drafts replies for you to review and gives the agents you build nine Gmail actions."},"3284":{"id":"/product-docs/integrations/gmail-1","page_id":"/product-docs/integrations/gmail","type":"heading","tags":[],"url":"/product-docs/integrations/gmail#at-a-glance","content":"At a glance"},"3285":{"id":"/product-docs/integrations/gmail-2","page_id":"/product-docs/integrations/gmail","type":"heading","tags":[],"url":"/product-docs/integrations/gmail#what-it-is","content":"What the Gmail integration is"},"3286":{"id":"/product-docs/integrations/gmail-3","page_id":"/product-docs/integrations/gmail","type":"heading","tags":[],"url":"/product-docs/integrations/gmail#three-jobs","content":"Three jobs Gmail does"},"3287":{"id":"/product-docs/integrations/gmail-4","page_id":"/product-docs/integrations/gmail","type":"heading","tags":[],"url":"/product-docs/integrations/gmail#where-emails-land","content":"Where your emails land"},"3288":{"id":"/product-docs/integrations/gmail-5","page_id":"/product-docs/integrations/gmail","type":"heading","tags":[],"url":"/product-docs/integrations/gmail#why-it-matters","content":"Why the Gmail integration matters"},"3289":{"id":"/product-docs/integrations/gmail-6","page_id":"/product-docs/integrations/gmail","type":"heading","tags":[],"url":"/product-docs/integrations/gmail#what-its-for","content":"What it's for"},"3290":{"id":"/product-docs/integrations/gmail-7","page_id":"/product-docs/integrations/gmail","type":"heading","tags":[],"url":"/product-docs/integrations/gmail#how-it-helps","content":"How it helps"},"3291":{"id":"/product-docs/integrations/gmail-8","page_id":"/product-docs/integrations/gmail","type":"heading","tags":[],"url":"/product-docs/integrations/gmail#without-it","content":"What happens without it"},"3292":{"id":"/product-docs/integrations/gmail-9","page_id":"/product-docs/integrations/gmail","type":"heading","tags":[],"url":"/product-docs/integrations/gmail#why-buyers-care","content":"Why buyers care"},"3293":{"id":"/product-docs/integrations/gmail-10","page_id":"/product-docs/integrations/gmail","type":"heading","tags":[],"url":"/product-docs/integrations/gmail#approach","content":"The Oliv AI approach to the Gmail integration"},"3294":{"id":"/product-docs/integrations/gmail-11","page_id":"/product-docs/integrations/gmail","type":"heading","tags":[],"url":"/product-docs/integrations/gmail#set-up","content":"Connect Gmail"},"3295":{"id":"/product-docs/integrations/gmail-12","page_id":"/product-docs/integrations/gmail","type":"heading","tags":[],"url":"/product-docs/integrations/gmail#email-context","content":"What Oliv AI does with your email"},"3296":{"id":"/product-docs/integrations/gmail-13","page_id":"/product-docs/integrations/gmail","type":"heading","tags":[],"url":"/product-docs/integrations/gmail#drafts","content":"Drafts and replies in Gmail"},"3297":{"id":"/product-docs/integrations/gmail-14","page_id":"/product-docs/integrations/gmail","type":"heading","tags":[],"url":"/product-docs/integrations/gmail#agent-tools","content":"Gmail in agents you build"},"3298":{"id":"/product-docs/integrations/gmail-15","page_id":"/product-docs/integrations/gmail","type":"heading","tags":[],"url":"/product-docs/integrations/gmail#works-with","content":"How Gmail works with Oliv AI's agents"},"3299":{"id":"/product-docs/integrations/gmail-16","page_id":"/product-docs/integrations/gmail","type":"heading","tags":[],"url":"/product-docs/integrations/gmail#with-crm-manager","content":"CRM Manager"},"3300":{"id":"/product-docs/integrations/gmail-17","page_id":"/product-docs/integrations/gmail","type":"heading","tags":[],"url":"/product-docs/integrations/gmail#with-olivia","content":"Olivia"},"3301":{"id":"/product-docs/integrations/gmail-18","page_id":"/product-docs/integrations/gmail","type":"heading","tags":[],"url":"/product-docs/integrations/gmail#with-meeting-assistant","content":"Meeting Assistant"},"3302":{"id":"/product-docs/integrations/gmail-19","page_id":"/product-docs/integrations/gmail","type":"heading","tags":[],"url":"/product-docs/integrations/gmail#with-deal-driver-forecaster","content":"Deal Driver and Forecaster"},"3303":{"id":"/product-docs/integrations/gmail-20","page_id":"/product-docs/integrations/gmail","type":"heading","tags":[],"url":"/product-docs/integrations/gmail#with-portfolio-manager","content":"Portfolio Manager"},"3304":{"id":"/product-docs/integrations/gmail-21","page_id":"/product-docs/integrations/gmail","type":"heading","tags":[],"url":"/product-docs/integrations/gmail#with-catalog-agents","content":"Catalog agents that draft in Gmail"},"3305":{"id":"/product-docs/integrations/gmail-22","page_id":"/product-docs/integrations/gmail","type":"heading","tags":[],"url":"/product-docs/integrations/gmail#who-uses-it","content":"Who uses the Gmail integration, and how"},"3306":{"id":"/product-docs/integrations/gmail-23","page_id":"/product-docs/integrations/gmail","type":"heading","tags":[],"url":"/product-docs/integrations/gmail#account-executives","content":"Account executives"},"3307":{"id":"/product-docs/integrations/gmail-24","page_id":"/product-docs/integrations/gmail","type":"heading","tags":[],"url":"/product-docs/integrations/gmail#sales-managers","content":"Sales managers"},"3308":{"id":"/product-docs/integrations/gmail-25","page_id":"/product-docs/integrations/gmail","type":"heading","tags":[],"url":"/product-docs/integrations/gmail#customer-success","content":"Customer success and account management"},"3309":{"id":"/product-docs/integrations/gmail-26","page_id":"/product-docs/integrations/gmail","type":"heading","tags":[],"url":"/product-docs/integrations/gmail#revenue-operations","content":"Revenue operations"},"3310":{"id":"/product-docs/integrations/gmail-27","page_id":"/product-docs/integrations/gmail","type":"heading","tags":[],"url":"/product-docs/integrations/gmail#compare","content":"How the Gmail integration compares"},"3311":{"id":"/product-docs/integrations/gmail-28","page_id":"/product-docs/integrations/gmail","type":"heading","tags":[],"url":"/product-docs/integrations/gmail#compare-stronger","content":"Why Oliv AI is the stronger choice for the Gmail integration"},"3312":{"id":"/product-docs/integrations/gmail-29","page_id":"/product-docs/integrations/gmail","type":"heading","tags":[],"url":"/product-docs/integrations/gmail#limits","content":"Limits and things to know"},"3313":{"id":"/product-docs/integrations/gmail-30","page_id":"/product-docs/integrations/gmail","type":"heading","tags":[],"url":"/product-docs/integrations/gmail#common-questions","content":"Common questions"},"3314":{"id":"/product-docs/integrations/gmail-31","page_id":"/product-docs/integrations/gmail","type":"heading","tags":[],"url":"/product-docs/integrations/gmail#faq-connect","content":"How do I connect Gmail?"},"3315":{"id":"/product-docs/integrations/gmail-32","page_id":"/product-docs/integrations/gmail","type":"heading","tags":[],"url":"/product-docs/integrations/gmail#faq-calendar","content":"Do I need to connect my calendar?"},"3316":{"id":"/product-docs/integrations/gmail-33","page_id":"/product-docs/integrations/gmail","type":"heading","tags":[],"url":"/product-docs/integrations/gmail#faq-google-meet","content":"Will Oliv join my Google Meet calls?"},"3317":{"id":"/product-docs/integrations/gmail-34","page_id":"/product-docs/integrations/gmail","type":"heading","tags":[],"url":"/product-docs/integrations/gmail#faq-which-deal","content":"Which deal does an email get logged to?"},"3318":{"id":"/product-docs/integrations/gmail-35","page_id":"/product-docs/integrations/gmail","type":"heading","tags":[],"url":"/product-docs/integrations/gmail#faq-new-domain","content":"What if a contact starts emailing from a new domain?"},"3319":{"id":"/product-docs/integrations/gmail-36","page_id":"/product-docs/integrations/gmail","type":"heading","tags":[],"url":"/product-docs/integrations/gmail#faq-send-review","content":"Will an agent send email without me seeing it?"},"3320":{"id":"/product-docs/integrations/gmail-37","page_id":"/product-docs/integrations/gmail","type":"heading","tags":[],"url":"/product-docs/integrations/gmail#faq-open-in-gmail","content":"What does Open in Gmail do?"},"3321":{"id":"/product-docs/integrations/gmail-38","page_id":"/product-docs/integrations/gmail","type":"heading","tags":[],"url":"/product-docs/integrations/gmail#faq-actions","content":"Which Gmail actions can a custom agent use?"},"3322":{"id":"/product-docs/integrations/gmail-39","page_id":"/product-docs/integrations/gmail","type":"heading","tags":[],"url":"/product-docs/integrations/gmail#faq-olivia","content":"Does Olivia read my email?"},"3323":{"id":"/product-docs/integrations/gmail-40","page_id":"/product-docs/integrations/gmail","type":"heading","tags":[],"url":"/product-docs/integrations/gmail#faq-plan","content":"Which plan includes email capture?"},"3324":{"id":"/product-docs/integrations/gmail-41","page_id":"/product-docs/integrations/gmail","type":"heading","tags":[],"url":"/product-docs/integrations/gmail#faq-outlook","content":"Does it work with Outlook instead?"},"3325":{"id":"/product-docs/integrations/gmail-42","page_id":"/product-docs/integrations/gmail","type":"heading","tags":[],"url":"/product-docs/integrations/gmail#faq-remove","content":"How do I remove the Gmail integration?"},"3326":{"id":"/product-docs/integrations/gmail-43","page_id":"/product-docs/integrations/gmail","type":"heading","tags":[],"url":"/product-docs/integrations/gmail#related","content":"Related"},"3327":{"id":"/product-docs/integrations/gmail-44","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail","content":"Oliv AI's Gmail integration puts your customer email in the same picture as your calls. Once Gmail is connected, Oliv AI captures each email with its participants, content and timestamps, and files it against the right account, contact and opportunity. Agents then use those threads to update the CRM, answer questions about a deal and draft replies for you to review."},"3328":{"id":"/product-docs/integrations/gmail-45","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#at-a-glance","content":"|                  |                                                                          |\n| ---------------- | ------------------------------------------------------------------------ |\n| **What it does** | Captures Gmail email and calendar events, and lets agents draft in Gmail |","table":"table-0"},"3329":{"id":"/product-docs/integrations/gmail-46","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#at-a-glance","content":"|                  |                                                     |\n| ---------------- | --------------------------------------------------- |\n| **Who it's for** | Account executives, sales managers, CSMs and RevOps |","table":"table-0"},"3330":{"id":"/product-docs/integrations/gmail-47","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#at-a-glance","content":"|                    |                                              |\n| ------------------ | -------------------------------------------- |\n| **How to connect** | Log in to the Oliv AI web app at web.oliv.ai |","table":"table-0"},"3331":{"id":"/product-docs/integrations/gmail-48","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#at-a-glance","content":"|              |                            |\n| ------------ | -------------------------- |\n| **Calendar** | Required: Gmail or Outlook |","table":"table-0"},"3332":{"id":"/product-docs/integrations/gmail-49","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#at-a-glance","content":"|                       |                                                        |\n| --------------------- | ------------------------------------------------------ |\n| **Where email lands** | The right account, contact and opportunity in your CRM |","table":"table-0"},"3333":{"id":"/product-docs/integrations/gmail-50","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#at-a-glance","content":"|                 |                                         |\n| --------------- | --------------------------------------- |\n| **Agent tools** | Nine Gmail actions in the agent builder |","table":"table-0"},"3334":{"id":"/product-docs/integrations/gmail-51","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#at-a-glance","content":"|                   |                                              |\n| ----------------- | -------------------------------------------- |\n| **To disconnect** | Message Oliv through Intercom in the Oliv UI |","table":"table-0"},"3335":{"id":"/product-docs/integrations/gmail-52","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#what-it-is","content":"The Gmail integration links your Google mailbox and calendar to Oliv AI. Gmail appears as one of two calendar integrations, next to Outlook, and as one of two email sources. Email threads are captured the same way as video calls and phone lines, so a deal's record holds both."},"3336":{"id":"/product-docs/integrations/gmail-53","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#three-jobs","content":"**Calendar.** Oliv AI reads your calendar to know which meetings to join. Without a calendar connection, Oliv can't take notes in your meetings."},"3337":{"id":"/product-docs/integrations/gmail-54","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#three-jobs","content":"**Email capture.** Every email is kept as a rich record with its participants, content and timestamps, alongside calls, calendar events and Slack messages."},"3338":{"id":"/product-docs/integrations/gmail-55","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#three-jobs","content":"**A tool for agents.** Gmail is one of seven systems in the agent builder, with nine named actions an agent can take."},"3339":{"id":"/product-docs/integrations/gmail-56","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#where-emails-land","content":"Oliv AI uses AI to connect each email to the right account, contact and opportunity in your CRM. That holds when one account has several opportunities. It also covers a contact who now emails from a new domain after an acquisition. When Oliv AI's CRM Manager agent can't settle where an email belongs, it asks the seller."},"3340":{"id":"/product-docs/integrations/gmail-57","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#where-emails-land","content":"On the deal itself, captured emails get their own row on the **Momentum** tab's **Activity Map**. They sit next to meetings, internal and external Slack, and agent actions, so you can see when the thread went quiet."},"3341":{"id":"/product-docs/integrations/gmail-58","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#where-emails-land","content":"Captured Gmail threads appear as the Emails row on each deal's Activity Map, so the written side of a deal sits on the same timeline as its calls."},"3342":{"id":"/product-docs/integrations/gmail-59","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#what-its-for","content":"The Gmail integration is for deals that move as much by email as by meeting. It puts what the buyer wrote next to what the buyer said, on the same deal. People and agents then work from one record."},"3343":{"id":"/product-docs/integrations/gmail-60","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#how-it-helps","content":"**Email counts as deal activity.** Each customer email is logged against the account, contact and opportunity it belongs to."},"3344":{"id":"/product-docs/integrations/gmail-61","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#how-it-helps","content":"**The CRM catches up by itself.** Contact roles and tasks are updated from signals in emails, as well as calls and meetings."},"3345":{"id":"/product-docs/integrations/gmail-62","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#how-it-helps","content":"**Answers draw on the thread.** When you ask about a deal, the answer can use what was written between meetings."},"3346":{"id":"/product-docs/integrations/gmail-63","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#how-it-helps","content":"**Replies start as drafts.** Agents write replies and outreach as drafts, so you review them before they go."},"3347":{"id":"/product-docs/integrations/gmail-64","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#without-it","content":"A deal's record shows the calls and little else. The buyer's written questions, a promise made in a reply and a new name copied on a thread stay in one person's inbox. Agents and managers then judge the deal on half the story."},"3348":{"id":"/product-docs/integrations/gmail-65","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#why-buyers-care","content":"Account executives care when a deal runs on long threads between calls. Sales managers care at pipeline review, when the CRM should match what buyers have put in writing. RevOps cares when email activity has to land on the right opportunity, not only the right account."},"3349":{"id":"/product-docs/integrations/gmail-66","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#approach","content":"Picture an account executive on a deal that has run mostly over email. The thread with the buyer is now forty messages long. A pricing question, a security review and a new timeline are all in there, spread across three people."},"3350":{"id":"/product-docs/integrations/gmail-67","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#approach","content":"The usual fix is to scroll and search before each call, then copy the key points into the CRM by hand. On a busy week that can eat an hour, and it may not happen at all. When it doesn't, the deal record may miss what the buyer actually wrote."},"3351":{"id":"/product-docs/integrations/gmail-68","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#approach","content":"Yet the thread already holds the facts. Who asked what, who agreed to what, and when, are all written down with names and times. What's missing is something that reads the thread next to the calls and files each point against the right deal."},"3352":{"id":"/product-docs/integrations/gmail-69","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#approach","content":"Oliv AI captures email from Gmail into the same record as calls and meetings. Each email keeps its participants, content and timestamps, and is matched to the right account, contact and opportunity. Oliv AI's CRM Manager agent then turns what changed into CRM updates. Oliv AI's Olivia agent can draw on the thread when you ask about the deal."},"3353":{"id":"/product-docs/integrations/gmail-70","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#approach","content":"The matching holds when one account has several opportunities, as Where your emails land sets out above. How that lines up with other tools is covered in How the Gmail integration compares, below."},"3354":{"id":"/product-docs/integrations/gmail-71","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#set-up","content":"**Log in to Oliv AI.** Go to web.oliv.ai and log in. That is how you connect Gmail."},"3355":{"id":"/product-docs/integrations/gmail-72","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#set-up","content":"**Check your calendar is connected.** Calendar integration is required. Oliv then joins external calls automatically, and Google Meet calls need no separate integration."},"3356":{"id":"/product-docs/integrations/gmail-73","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#set-up","content":"**Connect your CRM.** Email is matched to records in your CRM, so connect Salesforce or HubSpot as well."},"3357":{"id":"/product-docs/integrations/gmail-74","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#set-up","content":"**Add the Chrome extension if you use Google Calendar.** It lets you stop the note taker joining a meeting from Google Calendar. The recording modes guide covers the other ways to manage it."},"3358":{"id":"/product-docs/integrations/gmail-75","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#set-up","content":"**Disconnect by message.** To remove the Gmail integration later, send Oliv a message through Intercom in the Oliv UI."},"3359":{"id":"/product-docs/integrations/gmail-76","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#email-context","content":"| What happens to a customer email                          | Agent       |\n| --------------------------------------------------------- | ----------- |\n| Logged against the right account, contact and opportunity | CRM Manager |","table":"table-1"},"3360":{"id":"/product-docs/integrations/gmail-77","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#email-context","content":"| What happens to a customer email                           | Agent       |\n| ---------------------------------------------------------- | ----------- |\n| A new company or person on the thread becomes a CRM record | CRM Manager |","table":"table-1"},"3361":{"id":"/product-docs/integrations/gmail-78","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#email-context","content":"| What happens to a customer email                             | Agent       |\n| ------------------------------------------------------------ | ----------- |\n| Opportunity contact roles updated from signals in the thread | CRM Manager |","table":"table-1"},"3362":{"id":"/product-docs/integrations/gmail-79","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#email-context","content":"| What happens to a customer email     | Agent       |\n| ------------------------------------ | ----------- |\n| Next steps in the email become tasks | CRM Manager |","table":"table-1"},"3363":{"id":"/product-docs/integrations/gmail-80","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#email-context","content":"| What happens to a customer email          | Agent  |\n| ----------------------------------------- | ------ |\n| Used as context when you ask about a deal | Olivia |","table":"table-1"},"3364":{"id":"/product-docs/integrations/gmail-81","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#email-context","content":"| What happens to a customer email      | Agent      |\n| ------------------------------------- | ---------- |\n| Read when the forecast is recommended | Forecaster |","table":"table-1"},"3365":{"id":"/product-docs/integrations/gmail-82","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#email-context","content":"CRM Manager works after every activity, including each email, and syncs its updates to the CRM. You can review its suggestions before they sync, as set out in how to keep the CRM updated."},"3366":{"id":"/product-docs/integrations/gmail-83","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#drafts","content":"**Drafts wait for a person.** When an agent writes an email rather than sending one, the draft is put in front of a person first. On a Comms Manager run, the record labels the draft **Draft · Gmail**, lists the **Deal context used:** and offers **Review draft in Gmail** or **Copy**."},"3367":{"id":"/product-docs/integrations/gmail-84","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#drafts","content":"**Drafts can sit in Gmail.** Oliv AI's customer success workflow shows targeted outreach drafted per customer, with the drafts left in Gmail, ready to send."},"3368":{"id":"/product-docs/integrations/gmail-85","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#drafts","content":"**Run records hand off to Gmail.** An agent's run record shows one card per contact under an **Email Sent** banner, with the **To** chip, **Subject** and full body. **Open in Gmail** opens Gmail's compose screen with the recipient, subject and body filled in. It doesn't send anything."},"3369":{"id":"/product-docs/integrations/gmail-86","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#drafts","content":"**You decide what may send.** Each Gmail tool has a run mode: **Auto Run**, **Requires Approval** or **Agent Decides**. The tools and run modes guide explains each one."},"3370":{"id":"/product-docs/integrations/gmail-87","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#drafts","content":"A multithreading run record: the contacts the agent picked on the left and the Gmail email written for the selected one, ready to open in Gmail."},"3371":{"id":"/product-docs/integrations/gmail-88","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#drafts","content":"For writing that lands, Oliv AI's notes on sales emails that get responses and sales email templates by stage are a useful start."},"3372":{"id":"/product-docs/integrations/gmail-89","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#agent-tools","content":"In the **Add Tool** picker, Gmail has one group of tools named **Actions**. It offers nine: **Send Email via Gmail**, **Get Emails from Gmail**, **Search Emails in Gmail**, **Reply to Email**, **Draft Email in Gmail**, **Attach File to Gmail**, **Label Email in Gmail**, **Get Gmail Threads** and **Delete Email from Gmail**. Oliv AI's public RevOps page describes custom agents whose runs execute across Gmail, Slack and the CRM."},"3373":{"id":"/product-docs/integrations/gmail-90","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#agent-tools","content":"Every Gmail action you can give an agent you build. Read-only tools sit next to send and delete, so set each one's run mode before the agent goes live."},"3374":{"id":"/product-docs/integrations/gmail-91","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#agent-tools","content":"Give **Send Email via Gmail** and **Delete Email from Gmail** the **Requires Approval** run mode if a person should check every one."},"3375":{"id":"/product-docs/integrations/gmail-92","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#agent-tools","content":"Pick a trigger for when the agent starts, then choose which Gmail actions it may take. Gmail can start an agent too: **Google Mail** is in the **Most popular** group of the trigger picker."},"3376":{"id":"/product-docs/integrations/gmail-93","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#agent-tools","content":"Google Mail sits in the trigger picker's Most popular group, so a new email can be the event that starts an agent you build."},"3377":{"id":"/product-docs/integrations/gmail-94","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#agent-tools","content":"The agent builder overview walks through the rest of the setup."},"3378":{"id":"/product-docs/integrations/gmail-95","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#with-crm-manager","content":"Oliv AI's CRM Manager agent is triggered after every meeting, call and email. It logs each one against the right account, contact and opportunity. When an email involves a company or person not yet in the CRM, it creates the record."},"3379":{"id":"/product-docs/integrations/gmail-96","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#with-olivia","content":"Oliv AI's Olivia agent holds context from meeting data, CRM records and emails. Its agent doc lists email integration as optional but says it significantly enriches context between meetings."},"3380":{"id":"/product-docs/integrations/gmail-97","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#with-meeting-assistant","content":"Oliv AI's Meeting Assistant agent drafts the follow-up email after each call. It also flags deal field updates that need to go into the CRM. The full flow is in how to record a meeting and follow up."},"3381":{"id":"/product-docs/integrations/gmail-98","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#with-deal-driver-forecaster","content":"Oliv AI's Deal Driver agent flags risk from deal fields that CRM Manager refreshes from calls, emails and meetings. Oliv AI's Forecaster agent builds its recommendations from what is happening in calls and emails."},"3382":{"id":"/product-docs/integrations/gmail-99","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#with-portfolio-manager","content":"Oliv AI's Portfolio Manager agent reads customer-facing interactions to keep account health current. Its inputs include email threads, next to QBRs, check-ins and support conversations."},"3383":{"id":"/product-docs/integrations/gmail-100","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#with-catalog-agents","content":"**Multithreader.** Oliv AI's Multithreader agent proposes five more people for a deal at Proposal stage. It writes one labeled Gmail draft per contact."},"3384":{"id":"/product-docs/integrations/gmail-101","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#with-catalog-agents","content":"**Momentum Reviver.** Oliv AI's Momentum Reviver agent drafts an email for each stalled opportunity after a funding signal. The seller reviews and sends."},"3385":{"id":"/product-docs/integrations/gmail-102","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#with-catalog-agents","content":"**Comms Manager.** Oliv AI's Comms Manager agent watches customer email and chat, and drafts replies threaded under the customer's message. It sends nothing itself. It starts on a **New customer email in Gmail or Outlook**, and runs a **Morning inbox sweep, weekdays 7:30 AM**."},"3386":{"id":"/product-docs/integrations/gmail-103","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#with-catalog-agents","content":"Oliv AI's Comms Manager agent is a catalog agent built on Gmail: a new customer email starts it, and each reply it drafts waits for the seller to review."},"3387":{"id":"/product-docs/integrations/gmail-104","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#account-executives","content":"An AE with long buyer threads gets each email filed on the right deal, and a follow-up draft after every call. Comms Manager drafts replies that already know the deal. The whole day is in running deals as an account executive."},"3388":{"id":"/product-docs/integrations/gmail-105","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#sales-managers","content":"Managers get deal risk from fields refreshed by email as well as calls. That shapes the weekly pipeline review, and Forecaster's recommendations."},"3389":{"id":"/product-docs/integrations/gmail-106","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#customer-success","content":"CSMs get account health that reflects email threads, not just meetings. Drafted outreach can wait in Gmail, ready to send. Prep for the next call is covered in how to prepare for a meeting."},"3390":{"id":"/product-docs/integrations/gmail-107","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#revenue-operations","content":"RevOps gets email activity matched to the right opportunity, even when one account has several. Its integration blueprint for calls, email and Slack covers the wider stack."},"3391":{"id":"/product-docs/integrations/gmail-108","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#compare","content":"Oliv AI files each email against the right deal, even when one account has several opportunities. It also drafts replies inside the customer's thread, and gives the agents you build nine Gmail actions. Oliv AI is the only platform in this table that does all four."},"3392":{"id":"/product-docs/integrations/gmail-109","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#compare","content":"Email features, from each platform's public documentation:"},"3393":{"id":"/product-docs/integrations/gmail-110","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#compare","content":"| Platform    | Email threads kept with full content | Email matched when an account has several deals | Reply drafts in the customer's thread | Gmail actions in agents you build |\n| ----------- | ------------------------------------ | ----------------------------------------------- | ------------------------------------- | --------------------------------- |\n| **Oliv AI** | Yes                                  | Yes                                             | Yes                                   | Yes                               |","table":"table-2"},"3394":{"id":"/product-docs/integrations/gmail-111","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#compare","content":"| Platform | Email threads kept with full content | Email matched when an account has several deals   | Reply drafts in the customer's thread       | Gmail actions in agents you build   |\n| -------- | ------------------------------------ | ------------------------------------------------- | ------------------------------------------- | ----------------------------------- |\n| **Gong** | Yes (emails imported and stored)     | Partly (logged to the account when several match) | Partly (drafts from to-dos, flows or calls) | Partly (internal email action only) |","table":"table-2"},"3395":{"id":"/product-docs/integrations/gmail-112","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#compare","content":"| Platform  | Email threads kept with full content   | Email matched when an account has several deals | Reply drafts in the customer's thread       | Gmail actions in agents you build |\n| --------- | -------------------------------------- | ----------------------------------------------- | ------------------------------------------- | --------------------------------- |\n| **Avoma** | Yes (Gmail sync builds deal timelines) | Linked to relevant opportunities                | Partly (follow-up email from meeting notes) | Not in docs                       |","table":"table-2"},"3396":{"id":"/product-docs/integrations/gmail-113","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#compare","content":"| Platform     | Email threads kept with full content  | Email matched when an account has several deals | Reply drafts in the customer's thread          | Gmail actions in agents you build |\n| ------------ | ------------------------------------- | ----------------------------------------------- | ---------------------------------------------- | --------------------------------- |\n| **Outreach** | Yes (sync from the connected mailbox) | Partly (Gmail and Outreach Mail only)           | Yes (AI email replies with Smart Email Assist) | Not in docs                       |","table":"table-2"},"3397":{"id":"/product-docs/integrations/gmail-114","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#compare","content":"| Platform      | Email threads kept with full content    | Email matched when an account has several deals | Reply drafts in the customer's thread | Gmail actions in agents you build |\n| ------------- | --------------------------------------- | ----------------------------------------------- | ------------------------------------- | --------------------------------- |\n| **Fireflies** | Partly (inbox searched through AskFred) | Not in docs                                     | Yes (Auto Draft reply drafts)         | Not in docs                       |","table":"table-2"},"3398":{"id":"/product-docs/integrations/gmail-115","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#compare","content":"| Platform   | Email threads kept with full content | Email matched when an account has several deals | Reply drafts in the customer's thread | Gmail actions in agents you build |\n| ---------- | ------------------------------------ | ----------------------------------------------- | ------------------------------------- | --------------------------------- |\n| **Fathom** | Not in docs                          | Not in docs                                     | Partly (follow-up to copy and paste)  | Not in docs                       |","table":"table-2"},"3399":{"id":"/product-docs/integrations/gmail-116","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#compare","content":"*Yes: documented and built in. Partly: documented with a limit, shown in brackets. Not in docs: not found in the vendor's public documentation.*"},"3400":{"id":"/product-docs/integrations/gmail-117","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#compare-stronger","content":"**The right deal, not just the account.** Oliv AI matches email to the right opportunity when an account has several. In Gong's Salesforce logging, the account is used when several opportunities could match. Compare Oliv AI vs Gong."},"3401":{"id":"/product-docs/integrations/gmail-118","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#compare-stronger","content":"**Replies, not only follow-ups.** Oliv AI's Comms Manager agent drafts replies threaded under the customer's message. Avoma drafts a follow-up email from your meeting notes. Compare Oliv AI vs Avoma."},"3402":{"id":"/product-docs/integrations/gmail-119","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#compare-stronger","content":"**Gmail inside the agents you build.** A custom Oliv agent can search, read threads, draft, label and send in Gmail. A Gong automated agent can send an internal email to Gong team members. See Oliv AI as a Gong alternative."},"3403":{"id":"/product-docs/integrations/gmail-120","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#compare-stronger","content":"**Matching across every channel.** Oliv AI connects meeting, phone, email and Slack activity to the right opportunity. Outreach's email-to-opportunity association is only available in Gmail and Outreach Mail. Read Gong vs Outreach."},"3404":{"id":"/product-docs/integrations/gmail-121","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#compare-stronger","content":"*Competitor details checked against each vendor's public documentation on 22 October 2026. Features and plans change, so confirm with the vendor before you decide.*"},"3405":{"id":"/product-docs/integrations/gmail-122","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#limits","content":"**The calendar comes first.** Calendar integration is required. Without it, Oliv can't take notes in your meetings."},"3406":{"id":"/product-docs/integrations/gmail-123","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#limits","content":"**Matching needs your CRM.** Emails are matched to accounts, contacts and opportunities in your CRM, so connect it too."},"3407":{"id":"/product-docs/integrations/gmail-124","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#limits","content":"**Unclear cases go to the seller.** When CRM Manager can't resolve where an email belongs, it asks the seller."},"3408":{"id":"/product-docs/integrations/gmail-125","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#limits","content":"**Open in Gmail hands off.** The link opens a filled-in Gmail compose screen. You send from Gmail."},"3409":{"id":"/product-docs/integrations/gmail-126","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#limits","content":"**Sending follows the run mode.** An agent acts in Gmail within each tool's run mode. Set send to **Requires Approval** if every email should be reviewed."},"3410":{"id":"/product-docs/integrations/gmail-127","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#limits","content":"**Removal is a request.** To disconnect Gmail, message Oliv through Intercom in the Oliv UI."},"3411":{"id":"/product-docs/integrations/gmail-128","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#faq-connect","content":"Log in to the Oliv AI web app at web.oliv.ai. That is the integration step for Gmail."},"3412":{"id":"/product-docs/integrations/gmail-129","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#faq-calendar","content":"Yes. Calendar integration is required for Oliv to work. Without it, Oliv can't take notes during your meetings."},"3413":{"id":"/product-docs/integrations/gmail-130","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#faq-google-meet","content":"Yes. No separate Google Meet integration is needed. Oliv joins meetings automatically once your calendar is integrated."},"3414":{"id":"/product-docs/integrations/gmail-131","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#faq-which-deal","content":"Oliv AI uses AI to connect each email to the right account, contact and opportunity in your CRM. That includes accounts with several opportunities."},"3415":{"id":"/product-docs/integrations/gmail-132","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#faq-new-domain","content":"CRM Manager handles acquisitions, such as emails from Company B when the opportunity lives on Company A. If it can't resolve a case, it asks the seller."},"3416":{"id":"/product-docs/integrations/gmail-133","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#faq-send-review","content":"That depends on the run mode you set for each Gmail tool. Drafted emails wait for a person, and Comms Manager sends nothing itself."},"3417":{"id":"/product-docs/integrations/gmail-134","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#faq-open-in-gmail","content":"It opens Gmail's compose screen in a new tab, with the recipient, subject and body filled in. It doesn't send anything."},"3418":{"id":"/product-docs/integrations/gmail-135","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#faq-actions","content":"Nine: send, retrieve, search, reply, draft, attach, label, read threads and delete. Each one has its own run mode."},"3419":{"id":"/product-docs/integrations/gmail-136","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#faq-olivia","content":"Olivia draws on meeting data, CRM records and emails. Its agent doc calls email integration optional, and says it significantly enriches context between meetings."},"3420":{"id":"/product-docs/integrations/gmail-137","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#faq-plan","content":"Email capture is listed in the Converse app. The plans and seat roles guide explains how apps map to roles, and Oliv AI pricing has the current plans."},"3421":{"id":"/product-docs/integrations/gmail-138","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#faq-outlook","content":"Yes. Outlook is listed next to Gmail as a calendar integration and an email source. You connect it the same way, by logging in to web.oliv.ai."},"3422":{"id":"/product-docs/integrations/gmail-139","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#faq-remove","content":"Send Oliv a message through Intercom in the Oliv UI."},"3423":{"id":"/product-docs/integrations/gmail-140","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#related","content":"Converse app: email capture next to calls, phone and Slack."},"3424":{"id":"/product-docs/integrations/gmail-141","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#related","content":"CRM Manager agent: how email becomes CRM updates."},"3425":{"id":"/product-docs/integrations/gmail-142","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#related","content":"Olivia agent: ask about a deal with email in context."},"3426":{"id":"/product-docs/integrations/gmail-143","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#related","content":"Agent tools and run modes: Gmail actions and approval settings."},"3427":{"id":"/product-docs/integrations/gmail-144","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#related","content":"Slack: the other half of written customer context."},"3428":{"id":"/product-docs/integrations/gmail-145","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#related","content":"Oliv AI integrations: every tool Oliv AI connects to."},"3429":{"id":"/product-docs/integrations/gmail-146","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#related","content":"Agents overview: every agent that can use your email."},"3430":{"id":"/product-docs/integrations/gmail-147","page_id":"/product-docs/integrations/gmail","tags":[],"type":"text","url":"/product-docs/integrations/gmail#related","content":"Oliv AI product documentation: every documented agent and feature."},"3431":{"id":"/product-docs/integrations/hubspot","page_id":"/product-docs/integrations/hubspot","type":"page","content":"HubSpot","breadcrumbs":["Oliv AI docs","Integrations"],"tags":[],"url":"/product-docs/integrations/hubspot"},"3432":{"id":"/product-docs/integrations/hubspot-0","page_id":"/product-docs/integrations/hubspot","tags":[],"type":"text","url":"/product-docs/integrations/hubspot","content":"How to connect Oliv AI to HubSpot, show Oliv AI fields on deal records, decide how updates are approved, and see what Oliv AI keeps current in your portal."},"3433":{"id":"/product-docs/integrations/hubspot-1","page_id":"/product-docs/integrations/hubspot","type":"heading","tags":[],"url":"/product-docs/integrations/hubspot#at-a-glance","content":"At a glance"},"3434":{"id":"/product-docs/integrations/hubspot-2","page_id":"/product-docs/integrations/hubspot","type":"heading","tags":[],"url":"/product-docs/integrations/hubspot#what-it-is","content":"What the HubSpot integration is"},"3435":{"id":"/product-docs/integrations/hubspot-3","page_id":"/product-docs/integrations/hubspot","type":"heading","tags":[],"url":"/product-docs/integrations/hubspot#what-changes","content":"What changes in HubSpot"},"3436":{"id":"/product-docs/integrations/hubspot-4","page_id":"/product-docs/integrations/hubspot","type":"heading","tags":[],"url":"/product-docs/integrations/hubspot#why-it-matters","content":"Why the HubSpot integration matters"},"3437":{"id":"/product-docs/integrations/hubspot-5","page_id":"/product-docs/integrations/hubspot","type":"heading","tags":[],"url":"/product-docs/integrations/hubspot#what-its-for","content":"What it's for"},"3438":{"id":"/product-docs/integrations/hubspot-6","page_id":"/product-docs/integrations/hubspot","type":"heading","tags":[],"url":"/product-docs/integrations/hubspot#how-it-helps","content":"How it helps"},"3439":{"id":"/product-docs/integrations/hubspot-7","page_id":"/product-docs/integrations/hubspot","type":"heading","tags":[],"url":"/p