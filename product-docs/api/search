,"url":"/product-docs/agents/builder/knowledge#check-knowledge","content":"Check what an agent knows"},"187":{"id":"/product-docs/agents/builder/knowledge-10","page_id":"/product-docs/agents/builder/knowledge","type":"heading","tags":[],"url":"/product-docs/agents/builder/knowledge#add-files","content":"Add files to an agent"},"188":{"id":"/product-docs/agents/builder/knowledge-11","page_id":"/product-docs/agents/builder/knowledge","type":"heading","tags":[],"url":"/product-docs/agents/builder/knowledge#formats","content":"Formats the tab names"},"189":{"id":"/product-docs/agents/builder/knowledge-12","page_id":"/product-docs/agents/builder/knowledge","type":"heading","tags":[],"url":"/product-docs/agents/builder/knowledge#works-with","content":"How agent knowledge files work with other features"},"190":{"id":"/product-docs/agents/builder/knowledge-13","page_id":"/product-docs/agents/builder/knowledge","type":"heading","tags":[],"url":"/product-docs/agents/builder/knowledge#with-instructions","content":"Instructions"},"191":{"id":"/product-docs/agents/builder/knowledge-14","page_id":"/product-docs/agents/builder/knowledge","type":"heading","tags":[],"url":"/product-docs/agents/builder/knowledge#with-tools","content":"Tools and run modes"},"192":{"id":"/product-docs/agents/builder/knowledge-15","page_id":"/product-docs/agents/builder/knowledge","type":"heading","tags":[],"url":"/product-docs/agents/builder/knowledge#with-data","content":"Data sources"},"193":{"id":"/product-docs/agents/builder/knowledge-16","page_id":"/product-docs/agents/builder/knowledge","type":"heading","tags":[],"url":"/product-docs/agents/builder/knowledge#with-overview","content":"The Overview tab"},"194":{"id":"/product-docs/agents/builder/knowledge-17","page_id":"/product-docs/agents/builder/knowledge","type":"heading","tags":[],"url":"/product-docs/agents/builder/knowledge#who-uses-it","content":"Who uses agent knowledge files, and how"},"195":{"id":"/product-docs/agents/builder/knowledge-18","page_id":"/product-docs/agents/builder/knowledge","type":"heading","tags":[],"url":"/product-docs/agents/builder/knowledge#enablement","content":"Enablement"},"196":{"id":"/product-docs/agents/builder/knowledge-19","page_id":"/product-docs/agents/builder/knowledge","type":"heading","tags":[],"url":"/product-docs/agents/builder/knowledge#account-executives-and-sales-leaders","content":"Account executives and sales leaders"},"197":{"id":"/product-docs/agents/builder/knowledge-20","page_id":"/product-docs/agents/builder/knowledge","type":"heading","tags":[],"url":"/product-docs/agents/builder/knowledge#customer-success","content":"Customer success and account management"},"198":{"id":"/product-docs/agents/builder/knowledge-21","page_id":"/product-docs/agents/builder/knowledge","type":"heading","tags":[],"url":"/product-docs/agents/builder/knowledge#revenue-operations","content":"Revenue operations"},"199":{"id":"/product-docs/agents/builder/knowledge-22","page_id":"/product-docs/agents/builder/knowledge","type":"heading","tags":[],"url":"/product-docs/agents/builder/knowledge#compare","content":"How agent knowledge files compare"},"200":{"id":"/product-docs/agents/builder/knowledge-23","page_id":"/product-docs/agents/builder/knowledge","type":"heading","tags":[],"url":"/product-docs/agents/builder/knowledge#compare-stronger","content":"Why Oliv AI is the stronger choice for agent knowledge files"},"201":{"id":"/product-docs/agents/builder/knowledge-24","page_id":"/product-docs/agents/builder/knowledge","type":"heading","tags":[],"url":"/product-docs/agents/builder/knowledge#limits","content":"Limits and things to know"},"202":{"id":"/product-docs/agents/builder/knowledge-25","page_id":"/product-docs/agents/builder/knowledge","type":"heading","tags":[],"url":"/product-docs/agents/builder/knowledge#common-questions","content":"Common questions"},"203":{"id":"/product-docs/agents/builder/knowledge-26","page_id":"/product-docs/agents/builder/knowledge","type":"heading","tags":[],"url":"/product-docs/agents/builder/knowledge#faq-what-is-knowledge","content":"What is knowledge in an Oliv AI agent?"},"204":{"id":"/product-docs/agents/builder/knowledge-27","page_id":"/product-docs/agents/builder/knowledge","type":"heading","tags":[],"url":"/product-docs/agents/builder/knowledge#faq-see-files","content":"How do I see what an agent has read?"},"205":{"id":"/product-docs/agents/builder/knowledge-28","page_id":"/product-docs/agents/builder/knowledge","type":"heading","tags":[],"url":"/product-docs/agents/builder/knowledge#faq-formats","content":"Which file types does the Knowledge tab name?"},"206":{"id":"/product-docs/agents/builder/knowledge-29","page_id":"/product-docs/agents/builder/knowledge","type":"heading","tags":[],"url":"/product-docs/agents/builder/knowledge#faq-how-many","content":"How many files can I upload at once?"},"207":{"id":"/product-docs/agents/builder/knowledge-30","page_id":"/product-docs/agents/builder/knowledge","type":"heading","tags":[],"url":"/product-docs/agents/builder/knowledge#faq-pill","content":"Why does a knowledge pill open a new browser tab?"},"208":{"id":"/product-docs/agents/builder/knowledge-31","page_id":"/product-docs/agents/builder/knowledge","type":"heading","tags":[],"url":"/product-docs/agents/builder/knowledge#faq-remove","content":"Can I remove a file from an agent?"},"209":{"id":"/product-docs/agents/builder/knowledge-32","page_id":"/product-docs/agents/builder/knowledge","type":"heading","tags":[],"url":"/product-docs/agents/builder/knowledge#faq-used","content":"How do I know the agent actually used a file?"},"210":{"id":"/product-docs/agents/builder/knowledge-33","page_id":"/product-docs/agents/builder/knowledge","type":"heading","tags":[],"url":"/product-docs/agents/builder/knowledge#faq-no-tab","content":"Why does this agent have no Knowledge tab?"},"211":{"id":"/product-docs/agents/builder/knowledge-34","page_id":"/product-docs/agents/builder/knowledge","type":"heading","tags":[],"url":"/product-docs/agents/builder/knowledge#related","content":"Related"},"212":{"id":"/product-docs/agents/builder/knowledge-35","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge","content":"Knowledge is the background reading an Oliv AI agent does its work against, such as a buying-committee profile, an ideal-customer document or a solution deck. Each agent with a **Knowledge** tab lists the files it is using, and you can open any of them from there. The tab also carries an upload area that names the file formats it takes, and buttons to bring files in from other tools."},"213":{"id":"/product-docs/agents/builder/knowledge-36","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge","content":"The Knowledge tab shows an agent's reading list and the way to add to it, on one screen: files in use at the top, the upload area and import buttons below."},"214":{"id":"/product-docs/agents/builder/knowledge-37","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#at-a-glance","content":"|                       |                                  |\n| --------------------- | -------------------------------- |\n| **What knowledge is** | The files an agent works against |","table":"table-0"},"215":{"id":"/product-docs/agents/builder/knowledge-38","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#at-a-glance","content":"|                    |                                  |\n| ------------------ | -------------------------------- |\n| **Where it lives** | **Agents › [agent] › Knowledge** |","table":"table-0"},"216":{"id":"/product-docs/agents/builder/knowledge-39","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#at-a-glance","content":"|               |                                                                   |\n| ------------- | ----------------------------------------------------------------- |\n| **File list** | **Knowledge in use**, one row per file, each with a **View** link |","table":"table-0"},"217":{"id":"/product-docs/agents/builder/knowledge-40","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#at-a-glance","content":"|                    |                                                   |\n| ------------------ | ------------------------------------------------- |\n| **Stated formats** | .csv, json, .pdf, xlsx, xls, txt, md, docx, .pptx |","table":"table-0"},"218":{"id":"/product-docs/agents/builder/knowledge-41","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#at-a-glance","content":"|                         |                          |\n| ----------------------- | ------------------------ |\n| **Stated upload limit** | \"Max 5 files per upload\" |","table":"table-0"},"219":{"id":"/product-docs/agents/builder/knowledge-42","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#at-a-glance","content":"|                    |                                                                                                                                    |\n| ------------------ | ---------------------------------------------------------------------------------------------------------------------------------- |\n| **Import buttons** | **Upload from Google Drive**, **Upload from OneDrive**, **Import from Seismic**, **Import from Highspot**, **Scrape from website** |","table":"table-0"},"220":{"id":"/product-docs/agents/builder/knowledge-43","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#at-a-glance","content":"|                   |                                          |\n| ----------------- | ---------------------------------------- |\n| **Also shown on** | The **Overview** tab, as knowledge pills |","table":"table-0"},"221":{"id":"/product-docs/agents/builder/knowledge-44","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#what-it-is","content":"An agent's instructions say what it does. Its knowledge is what it reads while doing it. The tab states its purpose in its own words: \"Share anything about your company, role, or work processes that will help your agent assist you better.\""},"222":{"id":"/product-docs/agents/builder/knowledge-45","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#what-it-is","content":"The **Knowledge** tab is one column with two sections."},"223":{"id":"/product-docs/agents/builder/knowledge-46","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#what-it-is","content":"| Section              | What it holds                                                                                      |\n| -------------------- | -------------------------------------------------------------------------------------------------- |\n| **Knowledge in use** | A table of the agent's files. Each row shows a document icon, the file's name and a **View** link. |","table":"table-1"},"224":{"id":"/product-docs/agents/builder/knowledge-47","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#what-it-is","content":"| Section                          | What it holds                                                                         |\n| -------------------------------- | ------------------------------------------------------------------------------------- |\n| **What should your agent know?** | A line explaining the purpose, then a dashed upload area and a row of import buttons. |","table":"table-1"},"225":{"id":"/product-docs/agents/builder/knowledge-48","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#what-it-is","content":"On the **Overview** tab, the same files appear as pills under a **Knowledge** heading, so you can see at a glance what background an agent has."},"226":{"id":"/product-docs/agents/builder/knowledge-49","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#what-its-for","content":"Knowledge files give an agent the material your team already works from. They hold the context about your company, your roles and your processes that an agent needs to help well. The tab keeps that reading list on the agent itself."},"227":{"id":"/product-docs/agents/builder/knowledge-50","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#how-it-helps","content":"**The reading list is visible.** **Knowledge in use** names every file an agent has."},"228":{"id":"/product-docs/agents/builder/knowledge-51","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#how-it-helps","content":"**Every file opens in one press.** **View** opens a file in a new browser tab, so you can check its content."},"229":{"id":"/product-docs/agents/builder/knowledge-52","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#how-it-helps","content":"**Common formats are named.** The upload area lists slide decks, documents and spreadsheets among its formats."},"230":{"id":"/product-docs/agents/builder/knowledge-53","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#how-it-helps","content":"**The Overview shows it too.** Knowledge pills tell you what background an agent has before you open it."},"231":{"id":"/product-docs/agents/builder/knowledge-54","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#without-it","content":"Without knowledge files, an agent works only from what it can find for itself. It has none of the material your team wrote down about how you sell. Its answers then drift from what reps hear in training, and nobody can see which material was missing."},"232":{"id":"/product-docs/agents/builder/knowledge-55","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#why-buyers-care","content":"This matters most to enablement teams, who own the decks and guides reps learn from. It matters when an agent first goes to a team. It matters again each time that material changes, because the agent's reading list should match what reps are taught."},"233":{"id":"/product-docs/agents/builder/knowledge-56","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#approach","content":"Think of an enablement manager who rebuilt the team's battlecards last month. She also keeps a set of one-page product sheets with no pricing in them. Reps were trained on both. Now an agent drafts answers for those same reps, and she wants it to say what they were taught."},"234":{"id":"/product-docs/agents/builder/knowledge-57","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#approach","content":"A common habit is to paste lines from the latest deck into each request. Some teams send a link and hope it gets used. That probably works some of the time. Old versions tend to linger in shared folders, though, and nobody can tell which copy an answer came from."},"235":{"id":"/product-docs/agents/builder/knowledge-58","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#approach","content":"If the agent reads the same files reps are taught from, the answers can line up. So the files belong on the agent, in a list that anyone can open and check. When a battlecard changes, the list is the one place to look."},"236":{"id":"/product-docs/agents/builder/knowledge-59","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#approach","content":"Oliv AI puts that list on each agent. The **Knowledge** tab shows **Knowledge in use**, with every file the agent works against and a **View** link beside each one. The enablement manager opens each file and checks it against her current set. The tab's upload area names the formats her material comes in, including .pptx, .pdf and docx."},"237":{"id":"/product-docs/agents/builder/knowledge-60","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#approach","content":"The upload area prints its formats: \"Supported formats: .csv, json,.pdf, xlsx, xls, txt, md, docx, .pptx.\"\nThe line beneath it reads \"Max 5 files per upload\". How other platforms handle the files an agent works from is covered in How agent knowledge files compare, below."},"238":{"id":"/product-docs/agents/builder/knowledge-61","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#check-knowledge","content":"Open the agent and select the **Knowledge** tab."},"239":{"id":"/product-docs/agents/builder/knowledge-62","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#check-knowledge","content":"Read the **Knowledge in use** table. It has a **Name** column and one row per file, each with a document icon."},"240":{"id":"/product-docs/agents/builder/knowledge-63","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#check-knowledge","content":"Press **View** on a row. That file opens in a new browser tab."},"241":{"id":"/product-docs/agents/builder/knowledge-64","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#check-knowledge","content":"The list grows with the agent's job. A customer-facing agent can carry a playbook, response-time standards, FAQs and a file of approved attachments."},"242":{"id":"/product-docs/agents/builder/knowledge-65","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#check-knowledge","content":"Step 2: each row in Knowledge in use is one file the agent works against. Press View on any row to open it and check its content."},"243":{"id":"/product-docs/agents/builder/knowledge-66","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#check-knowledge","content":"You can also press a knowledge pill on the **Overview** tab. Unlike the tools and trigger pills beside it, a knowledge pill doesn't switch tabs. It opens that file in a new browser tab instead."},"244":{"id":"/product-docs/agents/builder/knowledge-67","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#add-files","content":"The second section, **What should your agent know?**, holds the upload area."},"245":{"id":"/product-docs/agents/builder/knowledge-68","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#add-files","content":"Scroll down to **What should your agent know?** on the **Knowledge** tab."},"246":{"id":"/product-docs/agents/builder/knowledge-69","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#add-files","content":"Drag files onto the dashed area marked \"Drag & drop or choose files to upload.\""},"247":{"id":"/product-docs/agents/builder/knowledge-70","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#add-files","content":"Or press **choose files** inside that line. Your computer's file picker opens and lets you pick several files at once."},"248":{"id":"/product-docs/agents/builder/knowledge-71","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#add-files","content":"Keep to five files at a time. The area states \"Max 5 files per upload\"."},"249":{"id":"/product-docs/agents/builder/knowledge-72","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#add-files","content":"Or press one of the buttons beneath the area, after the word \"or\": **Upload from Google Drive**, **Upload from OneDrive**, **Import from Seismic**, **Import from Highspot** or **Scrape from website**."},"250":{"id":"/product-docs/agents/builder/knowledge-73","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#add-files","content":"Step 5: besides drag and drop, the tab offers five ways to bring material in, from cloud drives and enablement libraries to a page on your website."},"251":{"id":"/product-docs/agents/builder/knowledge-74","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#add-files","content":"Drag-and-drop needs a mouse or trackpad. The **choose files** link works without one."},"252":{"id":"/product-docs/agents/builder/knowledge-75","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#formats","content":"| Kind of file | Formats named       |\n| ------------ | ------------------- |\n| Documents    | .pdf, docx, txt, md |","table":"table-2"},"253":{"id":"/product-docs/agents/builder/knowledge-76","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#formats","content":"| Kind of file | Formats named |\n| ------------ | ------------- |\n| Slide decks  | .pptx         |","table":"table-2"},"254":{"id":"/product-docs/agents/builder/knowledge-77","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#formats","content":"| Kind of file          | Formats named         |\n| --------------------- | --------------------- |\n| Spreadsheets and data | .csv, xlsx, xls, json |","table":"table-2"},"255":{"id":"/product-docs/agents/builder/knowledge-78","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#formats","content":"That's nine extensions in all, as the upload area lists them."},"256":{"id":"/product-docs/agents/builder/knowledge-79","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#with-instructions","content":"The **Instructions** tab says what an agent is for and the steps it takes. Knowledge is the background it brings to those steps. Read the two together when you check an agent before a rollout."},"257":{"id":"/product-docs/agents/builder/knowledge-80","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#with-tools","content":"Knowledge is what an agent reads. Tools are what it does, and each tool's run mode decides how freely it acts. Both sit on the same agent, as the guide to agent tools and run modes explains."},"258":{"id":"/product-docs/agents/builder/knowledge-81","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#with-data","content":"An agent also reads structured data, shown on its **Data** tab: a **Sources** list of the systems it draws on, such as Salesforce, and a card for each field with a plain-language description. On agents without that tab, the **Overview** can list **Data Sources** instead, such as product usage and Salesforce accounts. Data sources are the other thing an agent reads, beside its files."},"259":{"id":"/product-docs/agents/builder/knowledge-82","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#with-overview","content":"The **Overview** tab lists an agent's knowledge as pills under a **Knowledge** heading. It's the quickest place to see what background an agent has, from the agents in the marketplace to the ones your team runs."},"260":{"id":"/product-docs/agents/builder/knowledge-83","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#with-overview","content":"On the Overview, knowledge shows as file pills beside the agent's triggers and tools. Pressing a pill opens that file rather than the Knowledge tab."},"261":{"id":"/product-docs/agents/builder/knowledge-84","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#who-uses-it","content":"These are typical patterns, shown to illustrate how the tab is used."},"262":{"id":"/product-docs/agents/builder/knowledge-85","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#enablement","content":"An enablement team opens each agent's **Knowledge in use** list after a content refresh. It presses **View** on each file and compares it with the current set of guides. The sales enablement software guide covers where this sits beside content tools."},"263":{"id":"/product-docs/agents/builder/knowledge-86","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#account-executives-and-sales-leaders","content":"Before trusting an agent's draft on a deal, an account executive checks its knowledge pills on the **Overview** tab. It's a quick way to see which profiles and decks the agent works from while you prepare for a meeting."},"264":{"id":"/product-docs/agents/builder/knowledge-87","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#customer-success","content":"A customer success team reads the knowledge list on agents that work its accounts. A solution deck or customer-profile document there tells the team what context the agent brings to a renewal."},"265":{"id":"/product-docs/agents/builder/knowledge-88","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#revenue-operations","content":"Revenue operations reviews which company documents each agent holds. It does this before an agent goes out to a wider team."},"266":{"id":"/product-docs/agents/builder/knowledge-89","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#compare","content":"Oliv AI keeps an agent's files on the agent, in a list you can open, and names spreadsheets and slide decks among its formats. The same files show on the agent's **Overview** as pills. Oliv AI is the only platform in this table that does all three."},"267":{"id":"/product-docs/agents/builder/knowledge-90","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#compare","content":"Agent knowledge, from each platform's public documentation:"},"268":{"id":"/product-docs/agents/builder/knowledge-91","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#compare","content":"| Platform    | Knowledge files kept on each agent | Slide decks and spreadsheets accepted | Knowledge shown on the agent's overview |\n| ----------- | ---------------------------------- | ------------------------------------- | --------------------------------------- |\n| **Oliv AI** | Yes                                | Yes                                   | Yes                                     |","table":"table-3"},"269":{"id":"/product-docs/agents/builder/knowledge-92","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#compare","content":"| Platform | Knowledge files kept on each agent    | Slide decks and spreadsheets accepted | Knowledge shown on the agent's overview |\n| -------- | ------------------------------------- | ------------------------------------- | --------------------------------------- |\n| **Gong** | Yes (files available across all runs) | Yes (PPTX and XLSX among file types)  | Not in docs                             |","table":"table-3"},"270":{"id":"/product-docs/agents/builder/knowledge-93","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#compare","content":"| Platform     | Knowledge files kept on each agent       | Slide decks and spreadsheets accepted | Knowledge shown on the agent's overview |\n| ------------ | ---------------------------------------- | ------------------------------------- | --------------------------------------- |\n| **Outreach** | Partly (Knowledge switched on per agent) | PPT, PDF, DOCX, TXT and MD            | Not in docs                             |","table":"table-3"},"271":{"id":"/product-docs/agents/builder/knowledge-94","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#compare","content":"| Platform         | Knowledge files kept on each agent  | Slide decks and spreadsheets accepted | Knowledge shown on the agent's overview |\n| ---------------- | ----------------------------------- | ------------------------------------- | --------------------------------------- |\n| **Fireflies.ai** | Partly (one central Knowledge Base) | PDF, DOCX, XLSX, CSV, TXT, MD, HTML   | Not in docs                             |","table":"table-3"},"272":{"id":"/product-docs/agents/builder/knowledge-95","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#compare","content":"| Platform  | Knowledge files kept on each agent        | Slide decks and spreadsheets accepted | Knowledge shown on the agent's overview |\n| --------- | ----------------------------------------- | ------------------------------------- | --------------------------------------- |\n| **Avoma** | Partly (files scoped to one chat session) | PDF, images, TXT, DOCX and CSV        | Not in docs                             |","table":"table-3"},"273":{"id":"/product-docs/agents/builder/knowledge-96","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#compare","content":"*Yes: documented and built in. Partly: documented with a limit, shown in brackets. Not in docs: not found in the vendor's public documentation.*"},"274":{"id":"/product-docs/agents/builder/knowledge-97","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#compare-stronger","content":"**Knowledge that stays on the agent.** Oliv AI lists each agent's files under **Knowledge in use** on the agent itself. Gong Assistant takes up to 10 uploaded files per message. See Oliv AI as a Gong alternative."},"275":{"id":"/product-docs/agents/builder/knowledge-98","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge#compar