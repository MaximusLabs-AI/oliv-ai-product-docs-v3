-6","page_id":"/product-docs/workflows/prepare-for-a-meeting","type":"heading","tags":[],"url":"/product-docs/workflows/prepare-for-a-meeting#step-4-first-meeting","content":"Step 4: Prepare a first meeting with Olivia"},"535":{"id":"/product-docs/workflows/prepare-for-a-meeting-7","page_id":"/product-docs/workflows/prepare-for-a-meeting","type":"heading","tags":[],"url":"/product-docs/workflows/prepare-for-a-meeting#step-5-use-the-agenda","content":"Step 5: Walk in with the agenda"},"536":{"id":"/product-docs/workflows/prepare-for-a-meeting-8","page_id":"/product-docs/workflows/prepare-for-a-meeting","type":"heading","tags":[],"url":"/product-docs/workflows/prepare-for-a-meeting#what-it-is","content":"What meeting preparation in Oliv AI is"},"537":{"id":"/product-docs/workflows/prepare-for-a-meeting-9","page_id":"/product-docs/workflows/prepare-for-a-meeting","type":"heading","tags":[],"url":"/product-docs/workflows/prepare-for-a-meeting#why-it-matters","content":"Why meeting preparation matters"},"538":{"id":"/product-docs/workflows/prepare-for-a-meeting-10","page_id":"/product-docs/workflows/prepare-for-a-meeting","type":"heading","tags":[],"url":"/product-docs/workflows/prepare-for-a-meeting#what-its-for","content":"What it's for"},"539":{"id":"/product-docs/workflows/prepare-for-a-meeting-11","page_id":"/product-docs/workflows/prepare-for-a-meeting","type":"heading","tags":[],"url":"/product-docs/workflows/prepare-for-a-meeting#how-it-helps","content":"How it helps"},"540":{"id":"/product-docs/workflows/prepare-for-a-meeting-12","page_id":"/product-docs/workflows/prepare-for-a-meeting","type":"heading","tags":[],"url":"/product-docs/workflows/prepare-for-a-meeting#without-it","content":"What happens without it"},"541":{"id":"/product-docs/workflows/prepare-for-a-meeting-13","page_id":"/product-docs/workflows/prepare-for-a-meeting","type":"heading","tags":[],"url":"/product-docs/workflows/prepare-for-a-meeting#why-buyers-care","content":"Why buyers care"},"542":