cs/apps/converse-25","page_id":"/product-docs/apps/converse","type":"heading","tags":[],"url":"/product-docs/apps/converse#compare","content":"How the Converse app compares"},"2025":{"id":"/product-docs/apps/converse-26","page_id":"/product-docs/apps/converse","type":"heading","tags":[],"url":"/product-docs/apps/converse#compare-stronger","content":"Why Oliv AI is the stronger choice for conversation capture"},"2026":{"id":"/product-docs/apps/converse-27","page_id":"/product-docs/apps/converse","type":"heading","tags":[],"url":"/product-docs/apps/converse#limits","content":"Limits and things to know"},"2027":{"id":"/product-docs/apps/converse-28","page_id":"/product-docs/apps/converse","type":"heading","tags":[],"url":"/product-docs/apps/converse#common-questions","content":"Common questions"},"2028":{"id":"/product-docs/apps/converse-29","page_id":"/product-docs/apps/converse","type":"heading","tags":[],"url":"/product-docs/apps/converse#faq-what","content":"What is the Converse app?"},"2029":{"id":"/product-docs/apps/converse-30","page_id":"/product-docs/apps/converse","type":"heading","tags":[],"url":"/product-docs/apps/converse#faq-bot","content":"Does Oliv AI send a bot to every meeting?"},"2030":{"id":"/product-docs/apps/converse-31","page_id":"/product-docs/apps/converse","type":"heading","tags":[],"url":"/product-docs/apps/converse#faq-platforms","content":"Which meeting platforms does it join?"},"2031":{"id":"/product-docs/apps/converse-32","page_id":"/product-docs/apps/converse","type":"heading","tags":[],"url":"/product-docs/apps/converse#faq-in-person","content":"Can it record in-person meetings?"},"2032":{"id":"/product-docs/apps/converse-33","page_id":"/product-docs/apps/converse","type":"heading","tags":[],"url":"/product-docs/apps/converse#faq-summary-timing","content":"How soon is the summary ready?"},"2033":{"id":"/product-docs/apps/converse-34","page_id":"/product-docs/apps/converse","type":"heading","tags":[],"url":"/product-docs/apps/converse#faq-find","content":"Where do I find past meetings?"},"2034":{"id":"/product-docs/apps/converse-35","page_id":"/product-docs/apps/converse","type":"heading","tags":[],"url":"/product-docs/apps/converse#faq-crm","content":"Does the call record reach my CRM?"},"2035":{"id":"/product-docs/apps/converse-36","page_id":"/product-docs/apps/converse","type":"heading","tags":[],"url":"/product-docs/apps/converse#faq-slack-off","content":"Can I turn off the Slack messages?"},"2036":{"id":"/product-docs/apps/converse-37","page_id":"/product-docs/apps/converse","type":"heading","tags":[],"url":"/product-docs/apps/converse#faq-context","content":"How does Converse decide what's important in a call?"},"2037":{"id":"/product-docs/apps/converse-38","page_id":"/product-docs/apps/converse","type":"heading","tags":[],"url":"/product-docs/apps/converse#faq-plan","content":"Is Converse a separate plan?"},"2038":{"id":"/product-docs/apps/converse-39","page_id":"/product-docs/apps/converse","type":"heading","tags":[],"url":"/product-docs/apps/converse#related","content":"Related"},"2039":{"id":"/product-docs/apps/converse-40","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse","content":"Converse is Oliv AI's conversation capture app. It records and transcribes your team's online meetings, phone calls and in-person conversations, and captures email and Slack the same way. Every conversation lands in one searchable record, with a summary and next steps ready as soon as a call ends."},"2040":{"id":"/product-docs/apps/converse-41","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#at-a-glance","content":"|                  |                                                                        |\n| ---------------- | ---------------------------------------------------------------------- |\n| **What it does** | Captures customer conversations and turns them into searchable records |","table":"table-0"},"2041":{"id":"/product-docs/apps/converse-42","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#at-a-glance","content":"|                  |                                                                          |\n| ---------------- | ------------------------------------------------------------------------ |\n| **Who it's for** | Sales leaders, account executives, SDRs, customer success and enablement |","table":"table-0"},"2042":{"id":"/product-docs/apps/converse-43","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#at-a-glance","content":"|                      |                                                                   |\n| -------------------- | ----------------------------------------------------------------- |\n| **What it captures** | Online meetings, phone calls, in-person meetings, email and Slack |","table":"table-0"},"2043":{"id":"/product-docs/apps/converse-44","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#at-a-glance","content":"|                       |                                                                             |\n| --------------------- | --------------------------------------------------------------------------- |\n| **Where you find it** | **Activities › Meetings** and **Activities › Calls** in the main navigation |","table":"table-0"},"2044":{"id":"/product-docs/apps/converse-45","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#at-a-glance","content":"|                  |                                                                                                   |\n| ---------------- | ------------------------------------------------------------------------------------------------- |\n| **What you get** | Key takeaways, AI summary, tasks, transcript with speaker labels, coaching scores and CRM updates |","table":"table-0"},"2045":{"id":"/product-docs/apps/converse-46","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#at-a-glance","content":"|                 |                                                       |\n| --------------- | ----------------------------------------------------- |\n| **Which plans** | Converse, and the Sell and Grow plans that include it |","table":"table-0"},"2046":{"id":"/product-docs/apps/converse-47","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#what-it-is","content":"The Converse app is where Oliv AI keeps the record of what your customers said. Its product page puts the core in a few words: \"call recording, transcription and AI summaries.\" It's built to understand context, so it reads sentiment and intent instead of matching keyword lists."},"2047":{"id":"/product-docs/apps/converse-48","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#what-it-is","content":"Converse feeds the same context graph the rest of Oliv AI runs on. Your CRM, your forecast and every agent read from the same record. That's why a call captured in Converse can shape a follow-up email, a CRM update or a coaching note without anyone copying it across."},"2048":{"id":"/product-docs/apps/converse-49","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#where-it-lives","content":"**Activities › Meetings** lists the meetings captured in your workspace in a grid, with **My meetings** and **Team meetings** tabs. Each row shows the next step and an AI summary."},"2049":{"id":"/product-docs/apps/converse-50","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#where-it-lives","content":"**Activities › Calls** lists captured phone calls, with their direction, disposition, owner, company and deal."},"2050":{"id":"/product-docs/apps/converse-51","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#where-it-lives","content":"Clips live in the **Library** tab of the Enable app, rather than on a route of their own."},"2051":{"id":"/product-docs/apps/converse-52","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#where-it-lives","content":"Converse lives under Activities: Meetings and Calls are its two lists, and every captured conversation is reached from one of them."},"2052":{"id":"/product-docs/apps/converse-53","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#where-it-lives","content":"Phone call capture gets its own Calls list, with direction, disposition and the deal each call belongs to, beside the meetings rather than mixed into them."},"2053":{"id":"/product-docs/apps/converse-54","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#app-and-plan","content":"Converse is also the name of an Oliv AI plan. Plans are cumulative: Sell includes Converse, and Grow includes Sell. For what each plan includes, see Oliv AI pricing."},"2054":{"id":"/product-docs/apps/converse-55","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#what-its-for","content":"Converse is for revenue teams that want every customer conversation on record, not only the video calls. It gives sales, customer success and enablement one place to find what a customer said."},"2055":{"id":"/product-docs/apps/converse-56","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#how-it-helps","content":"**Nothing to type up.** A summary and next steps are ready as soon as the call ends."},"2056":{"id":"/product-docs/apps/converse-57","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#how-it-helps","content":"**Every channel in one record.** Meetings, phone calls, email and Slack are captured the same way."},"2057":{"id":"/product-docs/apps/converse-58","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#how-it-helps","content":"**The exact moment, found.** You search for the objection or pricing concern, then clip it into a library."},"2058":{"id":"/product-docs/apps/converse-59","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#how-it-helps","content":"**Context agents can use.** Oliv AI's agents read the same record, so follow-ups and CRM updates start from the call."},"2059":{"id":"/product-docs/apps/converse-60","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#without-it","content":"Most of what customers tell a revenue team never gets written down. Notes depend on whoever was on the call. When a deal changes hands or a renewal comes up, the reason a customer bought is hard to recover."},"2060":{"id":"/product-docs/apps/converse-61","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#why-buyers-care","content":"Sales leaders care when the team grows past the point where they can join calls themselves. RevOps cares when CRM fields drift from what customers said. Enablement cares when it needs real examples for onboarding and coaching."},"2061":{"id":"/product-docs/apps/converse-62","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#approach","content":"Imagine a head of sales with twelve reps across new business and account management. A buyer at a large prospect raises a data concern on a phone call. Two days later they repeat it by email, then again in a shared Slack channel. Before the quarterly review, the head of sales wants to see every place it came up."},"2062":{"id":"/product-docs/apps/converse-63","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#approach","content":"The usual answer is a recorder for video calls and nothing else. Phone calls stay in the dialer, emails in each rep's inbox and Slack threads in their channels. Someone pieces the story together by hand, which can take an afternoon and still misses the conversations nobody recorded."},"2063":{"id":"/product-docs/apps/converse-64","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#approach","content":"Buyers have not moved to one channel, and they won't. A tool that records only video meetings leaves the rest of the conversation outside the record. Recording more meetings doesn't close that gap, because capture has to follow the customer wherever they talk."},"2064":{"id":"/product-docs/apps/converse-65","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#approach","content":"Oliv AI captures video calls, phone lines and email threads the same way, and Slack too. When your company hosts the meeting, Oliv AI records botlessly through the meeting platform. When someone outside hosts it, a visible note taker joins under your company's name. The head of sales can then search for the exact concern across every captured conversation."},"2065":{"id":"/product-docs/apps/converse-66","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#approach","content":"The pricing page lists each capture channel by name: botless meeting capture, phone call capture, email capture and Slack capture. Those four channels are the columns covered in How the Converse app compares, below."},"2066":{"id":"/product-docs/apps/converse-67","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#capture-channels","content":"**Online meetings.** Oliv AI joins Zoom, Meet and Teams automatically. If your company organized the meeting, recording happens botlessly inside the meeting app. If someone outside organized it, the note taker joins as a visible participant."},"2067":{"id":"/product-docs/apps/converse-68","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#capture-channels","content":"**Phone calls.** Phone call capture puts calls in the **Calls** list next to your meetings."},"2068":{"id":"/product-docs/apps/converse-69","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#capture-channels","content":"**In-person meetings.** You capture in-person meetings with the mobile app. The Sell and Grow plans also support Plaud, a wearable recorder that travels with your reps."},"2069":{"id":"/product-docs/apps/converse-70","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#capture-channels","content":"**Email.** Email capture adds email threads to the same record as your calls."},"2070":{"id":"/product-docs/apps/converse-71","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#capture-channels","content":"**Slack.** Slack capture brings Slack conversations into that record too."},"2071":{"id":"/product-docs/apps/converse-72","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#capture-channels","content":"Capture is always intentional. With in-person capture, the rep decides when and what to record, and capture is participant-aware rather than covert."},"2072":{"id":"/product-docs/apps/converse-73","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#after-the-call","content":"**A transcript.** Oliv AI transcribes the conversation and labels every speaker."},"2073":{"id":"/product-docs/apps/converse-74","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#after-the-call","content":"**An AI summary and next steps.** Both are ready as soon as the call ends, with key takeaways that link back to the recording."},"2074":{"id":"/product-docs/apps/converse-75","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#after-the-call","content":"**A meeting record in seven tabs.** Meeting details splits each meeting into **Overview**, **Action Items**, **Meeting insights**, **Recording**, **Coaching**, **Attendees** and **CRM Updates**."},"2075":{"id":"/product-docs/apps/converse-76","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#after-the-call","content":"**A call record in four tabs.** A phone call opens with **Overview**, **Action Items**, **Recording** and **Contact**."},"2076":{"id":"/product-docs/apps/converse-77","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#after-the-call","content":"**A follow-up draft.** It's ready within minutes, written from the actual conversation."},"2077":{"id":"/product-docs/apps/converse-78","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#after-the-call","content":"**Meeting notes in your CRM.** The AI summary and full transcript are attached to the opportunity record."},"2078":{"id":"/product-docs/apps/converse-79","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#after-the-call","content":"**Messages in Slack.** Once Slack is connected, Oliv AI sends a meeting summary as soon as each meeting ends, and a copy goes to your email by default."},"2079":{"id":"/product-docs/apps/converse-80","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#after-the-call","content":"This is what Converse hands you after a meeting: takeaways, a summary and the linked deal on the first tab, with tasks, insights, coaching and CRM changes one tab away."},"2080":{"id":"/product-docs/apps/converse-81","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#after-the-call","content":"For the craft side of this, see how to take meeting notes during sales calls."},"2081":{"id":"/product-docs/apps/converse-82","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#search-and-clips","content":"Converse is built so key moments are easy to find. Search for the exact objection, competitor mention or pricing concern, then press **Clip** on the recording to save it to a clip library for coaching, enablement or product."},"2082":{"id":"/product-docs/apps/converse-83","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#search-and-clips","content":"**Search for a meeting.** Open **Activities › Meetings** and use search. You can search by the date the meeting was held."},"2083":{"id":"/product-docs/apps/converse-84","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#search-and-clips","content":"**Jump in from Slack.** A Slack message about a meeting carries an **Open Meeting** button that takes you to it."},"2084":{"id":"/product-docs/apps/converse-85","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#search-and-clips","content":"**Share part of a transcript.** Find the minute marker, tick the box for the segment and copy it. Open it in a new tab to start playback from that minute."},"2085":{"id":"/product-docs/apps/converse-86","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#search-and-clips","content":"Oliv AI's Content Curator agent can also build clip libraries for you. You describe the moments you care about in plain language, and it clips matching moments when each meeting is completed. More on the Content Curator agent."},"2086":{"id":"/product-docs/apps/converse-87","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#search-and-clips","content":"Clipped moments from Converse are kept as clip libraries in the Enable app, where libraries the AI fills sit beside the ones your team curates."},"2087":{"id":"/product-docs/apps/converse-88","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#set-up","content":"**Connect your calendar and video conferencing.** Oliv AI relies on your calendar for the meetings it captures. See the integrations Oliv AI works with."},"2088":{"id":"/product-docs/apps/converse-89","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#set-up","content":"**Turn on botless recording.** If it isn't set up for your organization, contact Oliv Support and connect your video conferencing admin with them."},"2089":{"id":"/product-docs/apps/converse-90","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#set-up","content":"**Connect your CRM.** Salesforce, HubSpot or Zoho syncs pipeline, fields, owners, close dates and stages."},"2090":{"id":"/product-docs/apps/converse-91","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#set-up","content":"**Connect Slack.** The meeting messages start automatically, with no setup of their own. You can turn them off on your **Profile Settings** page."},"2091":{"id":"/product-docs/apps/converse-92","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#set-up","content":"Teams that are moving recordings across from another tool can read the guide to migrating from Gong."},"2092":{"id":"/product-docs/apps/converse-93","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#with-meeting-assistant","content":"Oliv AI's Meeting Assistant agent runs on Oliv Notetaker recordings and transcripts. After a call it drafts the follow-up email and proposes CRM field updates from what was said. The prepare for a meeting guide covers its brief before the call."},"2093":{"id":"/product-docs/apps/converse-94","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#with-enablement-agents","content":"Oliv AI's Content Curator agent needs recordings flowing in from Oliv Notetaker before it can clip moments. Oliv AI's Coach agent works on recordings after the fact to help reps improve."},"2094":{"id":"/product-docs/apps/converse-95","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#with-olivia-and-deal-driver","content":"Ask Oliv AI's Olivia agent to draft the follow-up from a call, and she pulls from the meeting transcript. Oliv AI's Deal Driver agent reads from the same record when it flags deal risk."},"2095":{"id":"/product-docs/apps/converse-96","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#with-crm-manager","content":"Oliv AI's CRM Manager agent attaches the AI summary and the full call transcript to the opportunity record. It keeps deal fields current from call history, as a layer on top of your CRM."},"2096":{"id":"/product-docs/apps/converse-97","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#sales-leaders","content":"A sales leader gets every customer conversation on record across the team, including phone calls and Slack. Search turns a question like \"who heard this objection\" into a list of moments. See Oliv AI for sales managers."},"2097":{"id":"/product-docs/apps/converse-98","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#account-executives","content":"An AE gets a summary, next steps and a follow-up draft after every call. Before the next meeting, the last conversation is a search away. See how AEs run deals with Oliv AI."},"2098":{"id":"/product-docs/apps/converse-99","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#customer-success","content":"A CSM taking over an account can read what sales promised, in the customer's own words. Phone support calls and in-person visits land in the same account record. More on Oliv AI for customer success teams."},"2099":{"id":"/product-docs/apps/converse-100","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#enablement","content":"An enablement lead clips real objection handles and talk tracks into clip libraries for onboarding and coaching. More on sales enablement software."},"2100":{"id":"/product-docs/apps/converse-101","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#compare","content":"Most conversation intelligence tools record video meetings well. The Converse app also captures phone calls, email and Slack into the same record, and records botlessly when your company hosts. Oliv AI is the only platform in this table that does all four."},"2101":{"id":"/product-docs/apps/converse-102","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#compare","content":"Conversation capture channels, from each platform's public documentation:"},"2102":{"id":"/product-docs/apps/converse-103","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#compare","content":"| Platform    | Botless meeting capture | Phone call capture | Email capture | Slack capture |\n| ----------- | ----------------------- | ------------------ | ------------- | ------------- |\n| **Oliv AI** | Yes                     | Yes                | Yes           | Yes           |","table":"table-1"},"2103":{"id":"/product-docs/apps/converse-104","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#compare","content":"| Platform | Botless meeting capture | Phone call capture             | Email capture                | Slack capture |\n| -------- | ----------------------- | ------------------------------ | ---------------------------- | ------------- |\n| **Gong** | Not in docs             | Yes (telephony calls imported) | Yes (email capture settings) | Not in docs   |","table":"table-1"},"2104":{"id":"/product-docs/apps/converse-105","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#compare","content":"| Platform  | Botless meeting capture                 | Phone call capture                        | Email capture          | Slack capture |\n| --------- | --------------------------------------- | ----------------------------------------- | ---------------------- | ------------- |\n| **Avoma** | Yes (Microsoft Cloud Recording, no bot) | Yes (dialer integrations such as Aircall) | Yes (Gmail email sync) | Not in docs   |","table":"table-1"},"2105":{"id":"/product-docs/apps/converse-106","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#compare","content":"| Platform      | Botless meeting capture       | Phone call capture                    | Email capture                           | Slack capture                          |\n| ------------- | ----------------------------- | ------------------------------------- | --------------------------------------- | -------------------------------------- |\n| **Fireflies** | Yes (recording without a bot) | Yes (phone calls via the desktop app) | Partly (email assistant for your inbox) | Partly (Slack insights in Daily Brief) |","table":"table-1"},"2106":{"id":"/product-docs/apps/converse-107","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#compare","content":"| Platform   | Botless meeting capture | Phone call capture                                | Email capture | Slack capture                |\n| ---------- | ----------------------- | ------------------------------------------------- | ------------- | ---------------------------- |\n| **Fathom** | Yes (bot-free capture)  | Not supported (phone calls listed as unsupported) | Not in docs   | Partly (Slack Huddles audio) |","table":"table-1"},"2107":{"id":"/product-docs/apps/converse-108","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#compare","content":"| Platform     | Botless meeting capture | Phone call capture                    | Email capture                 | Slack capture |\n| ------------ | ----------------------- | ------------------------------------- | ----------------------------- | ------------- |\n| **Outreach** | Not in docs             | Yes (recorded calls with transcripts) | Partly (prospect emails only) | Not in docs   |","table":"table-1"},"2108":{"id":"/product-docs/apps/converse-109","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#compare","content":"*Yes: documented and built in. Partly: documented with a limit, shown in brackets. Not in docs: not found in the vendor's public documentation.*"},"2109":{"id":"/product-docs/apps/converse-110","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#compare-stronger","content":"**Slack sits in the same record as calls.** Converse captures Slack alongside meetings, phone calls and email. Gong documents capturing emails, calendar meetings, or both for each team member. Compare Oliv AI vs Gong."},"2110":{"id":"/product-docs/apps/converse-111","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#compare-stronger","content":"**The recording method is chosen for you.** Oliv AI records botlessly when your company hosts and joins visibly when someone else does. Avoma's setup asks you to choose Cloud Recording or the Avoma Assistant bot. Compare Oliv AI vs Avoma."},"2111":{"id":"/product-docs/apps/converse-112","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#compare-stronger","content":"**Every customer email, not only sequence replies.** Converse captures email threads into the conversation record. Outreach's help center says it will only sync emails associated with Prospects. Read Gong vs Outreach for how Oliv AI fits that choice."},"2112":{"id":"/product-docs/apps/converse-113","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#compare-stronger","content":"*Competitor details checked against each vendor's public documentation on 21 October 2026. Features and plans change, so confirm with the vendor before you decide.*"},"2113":{"id":"/product-docs/apps/converse-114","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#limits","content":"**Some channels are add-ons.** Bot-based meeting capture and Slack capture are priced separately. See Oliv AI pricing."},"2114":{"id":"/product-docs/apps/converse-115","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#limits","content":"**Plaud needs a higher plan and its own hardware.** Plaud recordings are supported on Sell and Grow, and the hardware is purchased separately."},"2115":{"id":"/product-docs/apps/converse-116","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#limits","content":"**Botless recording needs setup.** If it isn't enabled for your organization, Oliv Support works with your video conferencing admin to turn it on."},"2116":{"id":"/product-docs/apps/converse-117","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#limits","content":"**External meetings may need admitting.** If an outside organizer's meeting has a waiting room or lobby, someone may need to admit the note taker."},"2117":{"id":"/product-docs/apps/converse-118","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#limits","content":"**Clips sit in the Enable app.** The clips route opens the **Library** tab of Enable."},"2118":{"id":"/product-docs/apps/converse-119","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#faq-what","content":"Converse is Oliv AI's conversation capture app. It records, transcribes and summarizes customer conversations across meetings, phone calls, email and Slack, in one searchable record."},"2119":{"id":"/product-docs/apps/converse-120","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#faq-bot","content":"No. When your company organizes the meeting and botless recording is enabled, Oliv AI records through the meeting platform. A visible note taker joins only when someone outside your company organizes it."},"2120":{"id":"/product-docs/apps/converse-121","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#faq-platforms","content":"Oliv AI joins Zoom, Google Meet and Microsoft Teams meetings automatically."},"2121":{"id":"/product-docs/apps/converse-122","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#faq-in-person","content":"Yes. You capture in-person meetings with the mobile app. Sell and Grow also support Plaud recordings, with the hardware bought separately."},"2122":{"id":"/product-docs/apps/converse-123","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#faq-summary-timing","content":"The summary and next steps are ready as soon as the call ends. A follow-up draft is ready within minutes."},"2123":{"id":"/product-docs/apps/converse-124","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#faq-find","content":"Open **Activities › Meetings** and search. Phone calls are in **Activities › Calls**."},"2124":{"id":"/product-docs/apps/converse-125","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#faq-crm","content":"Yes. The AI summary and full call transcript are attached to the opportunity record in your CRM."},"2125":{"id":"/product-docs/apps/converse-126","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#faq-slack-off","content":"Yes. Turn off the automated meeting messages on your **Profile Settings** page."},"2126":{"id":"/product-docs/apps/converse-127","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#faq-context","content":"It reads context, sentiment and intent rather than matching keyword lists."},"2127":{"id":"/product-docs/apps/converse-128","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#faq-plan","content":"Converse is both an app and a plan. Sell includes Converse, and Grow includes Sell, so each higher plan carries the same capture."},"2128":{"id":"/product-docs/apps/converse-129","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#related","content":"Converse on oliv.ai: the product page for the Converse app."},"2129":{"id":"/product-docs/apps/converse-130","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#related","content":"Context Capture: how Oliv AI captures every interaction into one context layer."},"2130":{"id":"/product-docs/apps/converse-131","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#related","content":"Revenue intelligence vs conversation intelligence: where conversation capture ends and deal work begins."},"2131":{"id":"/product-docs/apps/converse-132","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#related","content":"Sales call analytics tools compared: a wider look at recording and analysis tools."},"2132":{"id":"/product-docs/apps/converse-133","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#related","content":"Agent tools and run modes: how agents act on what Converse captures."},"2133":{"id":"/product-docs/apps/converse-134","page_id":"/product-docs/apps/converse","tags":[],"type":"text","url":"/product-docs/apps/converse#related","content":"Oliv AI product documentation: every documented agent and feature."},"2134":{"id":"/product-docs/apps/converse/clips","page_id":"/product-docs/apps/converse/clips","type":"page","content":"Clip library","breadcrumbs":["Oliv AI docs","Apps","Converse"],"tags":[],"url":"/product-docs/apps/converse/clips"},"2135":{"id":"/product-docs/apps/converse/clips-0","page_id":"/product-docs/apps/converse/clips","tags":[],"type":"text","url":"/product-docs/apps/converse/clips","content":"How Oliv AI builds a clip library from your recorded calls, where libraries live in the Enable app, what each clip page carries, how to define the moments it looks for, and how it compares with other call clipping tools."},"2136":{"id":"/product-docs/apps/converse/clips-1","page_id":"/product-docs/apps/converse/clips","type":"heading","tags":[],"url":"/product-docs/apps/converse/clips#at-a-glance","content":"At a glance"},"2137":{"id":"/product-docs/apps/converse/clips-2","page_id":"/product-docs/apps/converse/clips","type":"heading","tags":[],"url":"/product-docs/apps/converse/clips#what-it-is","content":"What the clip library is"},"2138":{"id":"/product-docs/apps/converse/clips-3","page_id":"/product-docs/apps/converse/clips","type":"heading","tags":[],"url":"/product-docs/apps/converse/clips#library-views","content":"Library views and access"},"2139":{"id":"/product-docs/apps/converse/clips-4","page_id":"/product-docs/apps/converse/clips","type":"heading","tags":[],"url":"/product-docs/apps/converse/clips#clip-details","content":"What's attached to every clip"},"2140":{"id":"/product-docs/apps/converse/clips-5","page_id":"/product-docs/apps/converse/clips","type":"heading","tags":[],"url":"/product-docs/apps/converse/clips#clip-page","content":"Watch a clip"},"2141":{"id":"/product-docs/apps/converse/clips-6","page_id":"/product-docs/apps/converse/clips","type":"heading","tags":[],"url":"/product-docs/apps/converse/clips#moments-and-libraries","content":"Moments and libraries"},"2142":{"id":"/product-docs/apps/converse/clips-7","page_id":"/product-docs/apps/converse/clips","type":"heading","tags":[],"url":"/product-docs/apps/converse/clips#why-it-matters","content":"Why the clip library matters"},"2143":{"id":"/product-docs/apps/converse/clips-8","page_id":"/product-docs/apps/converse/clips","type":"heading","tags":[],"url":"/product-docs/apps/converse/clips#what-its-for","content":"What it's for"},"2144":{"id":"/product-docs/apps/converse/clips-9","page_id":"/product-docs/apps/converse/clips","type":"heading","tags":[],"url":"/product-docs/apps/converse/clips#how-it-helps","content":"How it helps"},"2145":{"id":"/product-docs/apps/converse/clips-10","page_id":"/product-docs/apps/converse/clips","type":"heading","tags":[],"url":"/product-docs/apps/converse/clips#without-it","content":"What happens without it"},"2146":{"id":"/product-docs/apps/converse/clips-11","page_id":"/product-docs/apps/converse/clips","type":"heading","tags":[],"url":"/product-docs/apps/converse/clips#why-buyers-care","content":"Why buyers care"},"2147":{"id":"/product-docs/apps/converse/clips-12","page_id":"/product-docs/apps/converse/clips","type":"heading","tags":[],"url":"/product-docs/apps/converse/clips#approach","content":"The Oliv AI approach to the clip library"},"2148":{"id":"/product-docs/apps/converse/clips-13","page_id":"/product-docs/apps/converse/clips","type":"head