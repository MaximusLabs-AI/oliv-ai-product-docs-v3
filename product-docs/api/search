s/capabilities-134","page_id":"/product-docs/capabilities","tags":[],"type":"text","url":"/product-docs/capabilities#faq-platforms","content":"Zoom, Google Meet and Microsoft Teams, which it joins automatically, and Webex through the Webex App Hub."},"3079":{"id":"/product-docs/capabilities-135","page_id":"/product-docs/capabilities","tags":[],"type":"text","url":"/product-docs/capabilities#faq-crm","content":"No. Oliv AI works as a layer on top of your existing CRM. It brings the context together and keeps your CRM updated."},"3080":{"id":"/product-docs/capabilities-136","page_id":"/product-docs/capabilities","tags":[],"type":"text","url":"/product-docs/capabilities#related","content":"Agents overview: how the agents fit together and share one record."},"3081":{"id":"/product-docs/capabilities-137","page_id":"/product-docs/capabilities","tags":[],"type":"text","url":"/product-docs/capabilities#related","content":"Apps overview: the apps your team works in, and the seat that brings each one."},"3082":{"id":"/product-docs/getting-started/plan-your-deployment","page_id":"/product-docs/getting-started/plan-your-deployment","type":"page","content":"Plan your deployment","breadcrumbs":["Oliv AI docs","Getting started"],"tags":[],"url":"/product-docs/getting-started/plan-your-deployment"},"3083":{"id":"/product-docs/getting-started/plan-your-deployment-0","page_id":"/product-docs/getting-started/plan-your-deployment","tags":[],"type":"text","url":"/product-docs/getting-started/plan-your-deployment","content":"A 30-day plan for rolling Oliv AI out across sales and customer success, from choosing who runs the setup and lining up admin access to the first brief, the process handbook and the day-30 review."},"3084":{"id":"/product-docs/getting-started/plan-your-deployment-1","page_id":"/product-docs/getting-started/plan-your-deployment","type":"heading","tags":[],"url":"/product-docs/getting-started/plan-your-deployment#at-a-glance","content":"At a glance"},"3085":{"id":"/pro