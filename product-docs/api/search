,"5599":10,"5600":10,"5601":10,"5602":11,"5603":11,"5604":11,"5605":11,"5606":11,"5607":10,"5608":10,"5609":10,"5610":10,"5611":10,"5612":10,"5613":10,"5614":10,"5615":10,"5616":10,"5617":10,"5618":10,"5619":9,"5620":10,"5621":8,"5622":8,"5623":8,"5624":8,"5625":8,"5626":10,"5627":10,"5628":9,"5629":10,"5630":9,"5631":10,"5632":9,"5633":9,"5634":9,"5635":9,"5636":8,"5637":8,"5638":8,"5639":8,"5640":8,"5641":8,"5642":8,"5643":8,"5644":8,"5645":9,"5646":9,"5647":9,"5648":9,"5649":9,"5650":8,"5651":8,"5652":8,"5653":8,"5654":8,"5655":8,"5656":8,"5657":10,"5658":9,"5659":10,"5660":10,"5661":9,"5662":9,"5663":9,"5664":9,"5665":10,"5666":10,"5667":10,"5668":8,"5669":8,"5670":8,"5671":8,"5672":8,"5673":8,"5674":8,"5675":8,"5676":8,"5677":8}}},"docs":{"docs":{"1":{"id":"/product-docs/agents/builder","page_id":"/product-docs/agents/builder","type":"page","content":"Agent builder overview","breadcrumbs":["Oliv AI docs","Agents","Agent builder"],"tags":[],"url":"/product-docs/agents/builder"},"2":{"id":"/product-docs/agents/builder-0","page_id":"/product-docs/agents/builder","tags":[],"type":"text","url":"/product-docs/agents/builder","content":"The parts every Oliv AI agent is built from, from the marketplace where agents live to the detail page, instructions, tools and run modes, triggers, knowledge and run history."},"3":{"id":"/product-docs/agents/builder-1","page_id":"/product-docs/agents/builder","type":"heading","tags":[],"url":"/product-docs/agents/builder#marketplace","content":"Where agents live: the marketplace"},"4":{"id":"/product-docs/agents/builder-2","page_id":"/product-docs/agents/builder","type":"heading","tags":[],"url":"/product-docs/agents/builder#categories-and-badges","content":"Categories and badges"},"5":{"id":"/product-docs/agents/builder-3","page_id":"/product-docs/agents/builder","type":"heading","tags":[],"url":"/product-docs/agents/builder#agent-parts","content":"The parts of an agent"},"6":{"id":"/product-docs/agents/builder-4","page_id":"/product-docs/agents/builder","type":"heading","tags":[],"url":"/product-docs/agents/builder#autonomy","content":"How much freedom an agent has"},"7":{"id":"/product-docs/agents/builder-5","page_id":"/product-docs/agents/builder","type":"heading","tags":[],"url":"/product-docs/agents/builder#working-together","content":"How agents work together"},"8":{"id":"/product-docs/agents/builder-6","page_id":"/product-docs/agents/builder","type":"heading","tags":[],"url":"/product-docs/agents/builder#shared-context","content":"One shared record"},"9":{"id":"/product-docs/agents/builder-7","page_id":"/product-docs/agents/builder","type":"heading","tags":[],"url":"/product-docs/agents/builder#thresholds-and-delivery","content":"Thresholds and delivery"},"10":{"id":"/product-docs/agents/builder-8","page_id":"/product-docs/agents/builder","type":"heading","tags":[],"url":"/product-docs/agents/builder#custom-agents","content":"Custom agents"},"11":{"id":"/product-docs/agents/builder-9","page_id":"/product-docs/agents/builder","type":"heading","tags":[],"url":"/product-docs/agents/builder#next-steps","content":"Next steps"},"12":{"id":"/product-docs/agents/builder-10","page_id":"/product-docs/agents/builder","tags":[],"type":"text","url":"/product-docs/agents/builder","content":"The agent builder is where you see what an Oliv AI agent is and how it works. Every agent with a detail page shows the same parts: its purpose, its actions, what starts it, the files it reads and its past runs. This section explains each part, starting with the marketplace where agents live."},"13":{"id":"/product-docs/agents/builder-11","page_id":"/product-docs/agents/builder","tags":[],"type":"text","url":"/product-docs/agents/builder","content":"The marketplace is where every agent starts. Cards show what each agent does and whether you view it or clone it, with Oliv AI's Oliver agent on hand for questions."},"14":{"id":"/product-docs/agents/builder-12","page_id":"/product-docs/agents/builder","tags":[],"type":"text","url":"/product-docs/agents/builder#marketplace","content":"Open **Agents** in the main sidebar to reach the marketplace, the single place you see every agent available to you. Each agent is a card with a picture, a name, a short description and one button. **View Agent** opens that agent's detail page, and **Back to Marketplace** at the top brings you back. **Clone Agent** appears on template agents, as the way to take one as a starting point."},"15":{"id":"/product-docs/agents/builder-13","page_id":"/product-docs/agents/builder","tags":[],"type":"text","url":"/product-docs/agents/builder#marketplace","content":"A search box at the right matches what you type against each agent's name and description. The Oliv AI agent marketplace on oliv.ai shows the pre-built agents grouped by the roles they serve."},"16":{"id":"/product-docs/agents/builder-14","page_id":"/product-docs/agents/builder","tags":[],"type":"text","url":"/product-docs/agents/builder#marketplace","content":"Search matches the description as well as the name. Typing renewal keeps Renewal Radar by its name and QBR Builder by its description."},"17":{"id":"/product-docs/agents/builder-15","page_id":"/product-docs/agents/builder","tags":[],"type":"text","url":"/product-docs/agents/builder#categories-and-badges","content":"Agents are grouped by the revenue team they serve. Five buttons above the grid narrow the list: **All**, **Our Agents**, **Sales**, **Revenue Operations** and **Customer Success**. The category buttons and the search box work together, so an agent must match both to stay listed."},"18":{"id":"/product-docs/agents/builder-16","page_id":"/product-docs/agents/builder","tags":[],"type":"text","url":"/product-docs/agents/builder#categories-and-badges","content":"Some cards also carry a **Pre-built** or **Custom** badge, which tells you where that agent came from. A chat with Oliv AI's Oliver agent sits on the right of the marketplace, so you can ask about agents without leaving the screen. The panel has its own new chat and history buttons, a suggested question to start from and the **Ask before acting** setting under the message box."},"19":{"id":"/product-docs/agents/builder-17","page_id":"/product-docs/agents/builder","tags":[],"type":"text","url":"/product-docs/agents/builder#categories-and-badges","content":"A category button narrows the grid to one team's agents. Pre-built and Custom badges mark where each agent came from, and both kinds open the same detail page."},"20":{"id":"/product-docs/agents/builder-18","page_id":"/product-docs/agents/builder","tags":[],"type":"text","url":"/product-docs/agents/builder#agent-parts","content":"An agent's detail page opens on its **Overview** tab. It summarizes the agent's goal, triggers, tools, knowledge and recent runs. A **Run Agent** button at the top right starts a run by hand. Each of the other tabs goes into one part in depth."},"21":{"id":"/product-docs/agents/builder-19","page_id":"/product-docs/agents/builder","tags":[],"type":"text","url":"/product-docs/agents/builder#agent-parts","content":"The Overview tab is the summary of an agent. Each card on it, from triggers to knowledge, has a tab of its own that goes into detail."},"22":{"id":"/product-docs/agents/builder-20","page_id":"/product-docs/agents/builder","tags":[],"type":"text","url":"/product-docs/agents/builder#agent-parts","content":"| Part         | Tab              | What it tells you                                                            |\n| ------------ | ---------------- | ---------------------------------------------------------------------------- |\n| Instructions | **Instructions** | The agent's **Objective**, its numbered **Process** steps and its **Output** |","table":"table-0"},"23":{"id":"/product-docs/agents/builder-21","page_id":"/product-docs/agents/builder","tags":[],"type":"text","url":"/product-docs/agents/builder#agent-parts","content":"| Part                | Tab       | What it tells you                                          |\n| ------------------- | --------- | ---------------------------------------------------------- |\n| Tools and run modes | **Tools** | Each action the agent may take, and how freely it takes it |","table":"table-0"},"24":{"id":"/product-docs/agents/builder-22","page_id":"/product-docs/agents/builder","tags":[],"type":"text","url":"/product-docs/agents/builder#agent-parts","content":"| Part                   | Tab          | What it tells you                                          |\n| ---------------------- | ------------ | ---------------------------------------------------------- |\n| Triggers and schedules | **Triggers** | The events and fixed times that start the agent on its own |","table":"table-0"},"25":{"id":"/product-docs/agents/builder-23","page_id":"/product-docs/agents/builder","tags":[],"type":"text","url":"/product-docs/agents/builder#agent-parts","content":"| Part            | Tab           | What it tells you                                        |\n| --------------- | ------------- | -------------------------------------------------------- |\n| Knowledge files | **Knowledge** | The files the agent works against, each one open to view |","table":"table-0"},"26":{"id":"/product-docs/agents/builder-24","page_id":"/product-docs/agents/builder","tags":[],"type":"text","url":"/product-docs/agents/builder#agent-parts","content":"| Part        | Tab      | What it tells you                                   |\n| ----------- | -------- | --------------------------------------------------- |\n| Run history | **Runs** | Every run, with a full record of what the agent did |","table":"table-0"},"27":{"id":"/product-docs/agents/builder-25","page_id":"/product-docs/agents/builder","tags":[],"type":"text","url":"/product-docs/agents/builder#agent-parts","content":"Every agent's page has **Overview**, **Instructions**, **Tools** and **Runs**. **Triggers**, **Knowledge** and **Data** appear only on agents that use them. Some agents add a tab of their own, such as **Moments** on Oliv AI's Content Curator agent, or **Sequence** on an agent that runs outreach in steps."},"28":{"id":"/product-docs/agents/builder-26","page_id":"/product-docs/agents/builder","tags":[],"type":"text","url":"/product-docs/agents/builder#agent-parts","content":"Read the parts in order and you have the whole agent. The instructions say what it does, the tools say what it may touch, and the triggers say when it acts. The run history shows what actually happened."},"29":{"id":"/product-docs/agents/builder-27","page_id":"/product-docs/agents/builder","tags":[],"type":"text","url":"/product-docs/agents/builder#autonomy","content":"Two settings decide how far an agent goes on its own."},"30":{"id":"/product-docs/agents/builder-28","page_id":"/product-docs/agents/builder","tags":[],"type":"text","url":"/product-docs/agents/builder#autonomy","content":"**Per tool.** On the **Tools** tab, **Auto Run** acts without asking, **Requires Approval** waits for a person to confirm, and **Agent Decides** judges whether to ask."},"31":{"id":"/product-docs/agents/builder-29","page_id":"/product-docs/agents/builder","tags":[],"type":"text","url":"/product-docs/agents/builder#autonomy","content":"**Per conversation.** In a chat with Oliv AI's Olivia agent, each conversation is set to **Ask before acting** or **Act without asking**."},"32":{"id":"/product-docs/agents/builder-30","page_id":"/product-docs/agents/builder","tags":[],"type":"text","url":"/product-docs/agents/builder#autonomy","content":"Every run leaves evidence. Its record shows what that run produced: each email the agent wrote in full with the contacts it picked, a clipped call with its transcript, each step of an outreach sequence, or a drafted reply with the deal context behind it. So you can check an agent's past runs before you give it more freedom. CRM updates follow the same path, from reviewed to automatic, in keep the CRM updated."},"33":{"id":"/product-docs/agents/builder-31","page_id":"/product-docs/agents/builder","tags":[],"type":"text","url":"/product-docs/agents/builder#working-together","content":"Agents don't work alone. Oliv AI's Olivia agent runs the frontline and routes work to the right specialist agent. Oliv AI's Oliver agent keeps the playbook current and configures which agents are active, what they monitor and what thresholds trigger their actions. Each agent gets the right tools, memory, permissions and guardrails for the job, scoped to the task at hand."},"34":{"id":"/product-docs/agents/builder-32","page_id":"/product-docs/agents/builder","tags":[],"type":"text","url":"/product-docs/agents/builder#shared-context","content":"Every agent and every rep works from the same context graph. Agents also start from the data you already have. Olivia reads what's already there, messy data included, and Oliv AI's Forecaster agent doesn't need a clean CRM to start. When you override one of Forecaster's recommendations, it learns from that feedback."},"35":{"id":"/product-docs/agents/builder-33","page_id":"/product-docs/agents/builder","tags":[],"type":"text","url":"/product-docs/agents/builder#thresholds-and-delivery","content":"Some agents let you tune when they speak up. With Oliv AI's Deal Driver agent, inactivity windows, field completion requirements and deal value thresholds are configurable per manager or per team. Agents deliver work where people already are: Deal Driver reaches you in Slack, email or the Oliv AI app. Tools in the catalog act in systems such as Salesforce and HubSpot."},"36":{"id":"/product-docs/agents/builder-34","page_id":"/product-docs/agents/builder","tags":[],"type":"text","url":"/product-docs/agents/builder#custom-agents","content":"The marketplace on oliv.ai offers pre-built agents designed for specific challenges, and invites you to request a custom agent. Oliv AI's GTM engineering team stays with you after launch. It reviews agent output, tunes the playbook and adds custom agents as your territory, comp or ICP shifts, as the RevOps page describes. A custom agent has the same parts as every other, so the pages in this section apply to it. The build vs buy guide covers when a custom agent makes sense."},"37":{"id":"/product-docs/agents/builder-35","page_id":"/product-docs/agents/builder","tags":[],"type":"text","url":"/product-docs/agents/builder#next-steps","content":"Set run modes on each tool: decide which actions wait for a person."},"38":{"id":"/product-docs/agents/builder-36","page_id":"/product-docs/agents/builder","tags":[],"type":"text","url":"/product-docs/agents/builder#next-steps","content":"Agents overview: see how Olivia, Oliver and the specialist agents fit together."},"39":{"id":"/product-docs/agents/builder-37","page_id":"/product-docs/agents/builder","tags":[],"type":"text","url":"/product-docs/agents/builder#next-steps","content":"Oliv AI's CRM Manager agent: the agent that moves from reviewed to automatic CRM updates."},"40":{"id":"/product-docs/agents/builder-38","page_id":"/product-docs/agents/builder","tags":[],"type":"text","url":"/product-docs/agents/builder#next-steps","content":"Run a pipeline review: put Deal Driver's per-rep reports to work."},"41":{"id":"/product-docs/agents/builder-39","page_id":"/product-docs/agents/builder","tags":[],"type":"text","url":"/product-docs/agents/builder#next-steps","content":"Record a meeting and follow up: see several agents act on one call."},"42":{"id":"/product-docs/agents/builder/instructions","page_id":"/product-docs/agents/builder/instructions","type":"page","content":"Agent instructions","breadcrumbs":["Oliv AI docs","Agents","Agent builder"],"tags":[],"url":"/product-docs/agents/builder/instructions"},"43":{"id":"/product-docs/agents/builder/instructions-0","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions","content":"What an Oliv AI agent's instructions are, how to read its Objective, Process and Output on the Instructions tab, and how to trace each process step to the tool it uses."},"44":{"id":"/product-docs/agents/builder/instructions-1","page_id":"/product-docs/agents/builder/instructions","type":"heading","tags":[],"url":"/product-docs/agents/builder/instructions#at-a-glance","content":"At a glance"},"45":{"id":"/product-docs/agents/builder/instructions-2","page_id":"/product-docs/agents/builder/instructions","type":"heading","tags":[],"url":"/product-docs/agents/builder/instructions#what-it-is","content":"What agent instructions are"},"46":{"id":"/product-docs/agents/builder/instructions-3","page_id":"/product-docs/agents/builder/instructions","type":"heading","tags":[],"url":"/product-docs/agents/builder/instructions#why-it-matters","content":"Why agent instructions matter"},"47":{"id":"/product-docs/agents/builder/instructions-4","page_id":"/product-docs/agents/builder/instructions","type":"heading","tags":[],"url":"/product-docs/agents/builder/instructions#what-its-for","content":"What it's for"},"48":{"id":"/product-docs/agents/builder/instructions-5","page_id":"/product-docs/agents/builder/instructions","type":"heading","tags":[],"url":"/product-docs/agents/builder/instructions#how-it-helps","content":"How it helps"},"49":{"id":"/product-docs/agents/builder/instructions-6","page_id":"/product-docs/agents/builder/instructions","type":"heading","tags":[],"url":"/product-docs/agents/builder/instructions#without-it","content":"What happens without it"},"50":{"id":"/product-docs/agents/builder/instructions-7","page_id":"/product-docs/agents/builder/instructions","type":"heading","tags":[],"url":"/product-docs/agents/builder/instructions#why-buyers-care","content":"Why buyers care"},"51":{"id":"/product-docs/agents/builder/instructions-8","page_id":"/product-docs/agents/builder/instructions","type":"heading","tags":[],"url":"/product-docs/agents/builder/instructions#approach","content":"The Oliv AI approach to agent instructions"},"52":{"id":"/product-docs/agents/builder/instructions-9","page_id":"/product-docs/agents/builder/instructions","type":"heading","tags":[],"url":"/product-docs/agents/builder/instructions#read-instructions","content":"Read an agent's instructions"},"53":{"id":"/product-docs/agents/builder/instructions-10","page_id":"/product-docs/agents/builder/instructions","type":"heading","tags":[],"url":"/product-docs/agents/builder/instructions#trace-to-tool","content":"Trace a step to its tool"},"54":{"id":"/product-docs/agents/builder/instructions-11","page_id":"/product-docs/agents/builder/instructions","type":"heading","tags":[],"url":"/product-docs/agents/builder/instructions#contents-list","content":"Move around with the contents list"},"55":{"id":"/product-docs/agents/builder/instructions-12","page_id":"/product-docs/agents/builder/instructions","type":"heading","tags":[],"url":"/product-docs/agents/builder/instructions#works-with","content":"How agent instructions work with other features"},"56":{"id":"/product-docs/agents/builder/instructions-13","page_id":"/product-docs/agents/builder/instructions","type":"heading","tags":[],"url":"/product-docs/agents/builder/instructions#with-tools","content":"Tools and run modes"},"57":{"id":"/product-docs/agents/builder/instructions-14","page_id":"/product-docs/agents/builder/instructions","type":"heading","tags":[],"url":"/product-docs/agents/builder/instructions#with-overview","content":"The Overview tab"},"58":{"id":"/product-docs/agents/builder/instructions-15","page_id":"/product-docs/agents/builder/instructions","type":"heading","tags":[],"url":"/product-docs/agents/builder/instructions#with-knowledge-and-triggers","content":"Knowledge and triggers"},"59":{"id":"/product-docs/agents/builder/instructions-16","page_id":"/product-docs/agents/builder/instructions","type":"heading","tags":[],"url":"/product-docs/agents/builder/instructions#with-deal-work","content":"Deal work"},"60":{"id":"/product-docs/agents/builder/instructions-17","page_id":"/product-docs/agents/builder/instructions","type":"heading","tags":[],"url":"/product-docs/agents/builder/instructions#who-uses-it","content":"Who uses agent instructions, and how"},"61":{"id":"/product-docs/agents/builder/instructions-18","page_id":"/product-docs/agents/builder/instructions","type":"heading","tags":[],"url":"/product-docs/agents/builder/instructions#account-executives-and-sales-leaders","content":"Account executives and sales leaders"},"62":{"id":"/product-docs/agents/builder/instructions-19","page_id":"/product-docs/agents/builder/instructions","type":"heading","tags":[],"url":"/product-docs/agents/builder/instructions#revenue-operations","content":"Revenue operations"},"63":{"id":"/product-docs/agents/builder/instructions-20","page_id":"/product-docs/agents/builder/instructions","type":"heading","tags":[],"url":"/product-docs/agents/builder/instructions#enablement","content":"Enablement"},"64":{"id":"/product-docs/agents/builder/instructions-21","page_id":"/product-docs/agents/builder/instructions","type":"heading","tags":[],"url":"/product-docs/agents/builder/instructions#customer-success","content":"Customer success and account management"},"65":{"id":"/product-docs/agents/builder/instructions-22","page_id":"/product-docs/agents/builder/instructions","type":"heading","tags":[],"url":"/product-docs/agents/builder/instructions#compare","content":"How agent instructions compare"},"66":{"id":"/product-docs/agents/builder/instructions-23","page_id":"/product-docs/agents/builder/instructions","type":"heading","tags":[],"url":"/product-docs/agents/builder/instructions#compare-stronger","content":"Why Oliv AI is the stronger choice for agent instructions"},"67":{"id":"/product-docs/agents/builder/instructions-24","page_id":"/product-docs/agents/builder/instructions","type":"heading","tags":[],"url":"/product-docs/agents/builder/instructions#limits","content":"Limits and things to know"},"68":{"id":"/product-docs/agents/builder/instructions-25","page_id":"/product-docs/agents/builder/instructions","type":"heading","tags":[],"url":"/product-docs/agents/builder/instructions#common-questions","content":"Common questions"},"69":{"id":"/product-docs/agents/builder/instructions-26","page_id":"/product-docs/agents/builder/instructions","type":"heading","tags":[],"url":"/product-docs/agents/builder/instructions#faq-where","content":"Where do I see what an agent actually does?"},"70":{"id":"/product-docs/agents/builder/instructions-27","page_id":"/product-docs/agents/builder/instructions","type":"heading","tags":[],"url":"/product-docs/agents/builder/instructions#faq-edit","content":"Can I edit an agent's instructions?"},"71":{"id":"/product-docs/agents/builder/instructions-28","page_id":"/product-docs/agents/builder/instructions","type":"heading","tags":[],"url":"/product-docs/agents/builder/instructions#faq-which-tools","content":"How do I tell which tools a step uses?"},"72":{"id":"/product-docs/agents/builder/instructions-29","page_id":"/product-docs/agents/builder/instructions","type":"heading","tags":[],"url":"/product-docs/agents/builder/instructions#faq-approval","content":"How do I check whether a step needs approval?"},"73":{"id":"/product-docs/agents/builder/instructions-30","page_id":"/product-docs/agents/builder/instructions","type":"heading","tags":[],"url":"/product-docs/agents/builder/instructions#faq-how-many-steps","content":"How many steps does an agent's process have?"},"74":{"id":"/product-docs/agents/builder/instructions-31","page_id":"/product-docs/agents/builder/instructions","type":"heading","tags":[],"url":"/product-docs/agents/builder/instructions#faq-no-output","content":"Why does one agent have no Output section?"},"75":{"id":"/product-docs/agents/builder/instructions-32","page_id":"/product-docs/agents/builder/instructions","type":"heading","tags":[],"url":"/product-docs/agents/builder/instructions#faq-author","content":"Can I see who wrote the instructions, or when they changed?"},"76":{"id":"/product-docs/agents/builder/instructions-33","page_id":"/product-docs/agents/builder/instructions","type":"heading","tags":[],"url":"/product-docs/agents/builder/instructions#faq-goal","content":"How is the Goal on the Overview tab different?"},"77":{"id":"/product-docs/agents/builder/instructions-34","page_id":"/product-docs/agents/builder/instructions","type":"heading","tags":[],"url":"/product-docs/agents/builder/instructions#faq-no-tab","content":"Why does this agent have no Instructions tab?"},"78":{"id":"/product-docs/agents/builder/instructions-35","page_id":"/product-docs/agents/builder/instructions","type":"heading","tags":[],"url":"/product-docs/agents/builder/instructions#related","content":"Related"},"79":{"id":"/product-docs/agents/builder/instructions-36","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions","content":"Every Oliv AI agent with a detail page carries a written statement of what it is for and how it goes about its work. The **Instructions** tab shows it in three parts: **Objective**, **Process** and **Output**. Each process step names the tools it uses, and pressing a tool takes you straight to it."},"80":{"id":"/product-docs/agents/builder/instructions-37","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions","content":"The Instructions tab sets out an agent's method in writing. The contents list on the left jumps to each part, and every step names the tool that carries it out."},"81":{"id":"/product-docs/agents/builder/instructions-38","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#at-a-glance","content":"|                           |                                                   |\n| ------------------------- | ------------------------------------------------- |\n| **What instructions are** | A written statement of what an agent does and how |","table":"table-0"},"82":{"id":"/product-docs/agents/builder/instructions-39","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#at-a-glance","content":"|                     |                                                                        |\n| ------------------- | ---------------------------------------------------------------------- |\n| **Where they live** | **Agents › [agent] › Instructions**, the second tab after **Overview** |","table":"table-0"},"83":{"id":"/product-docs/agents/builder/instructions-40","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#at-a-glance","content":"|              |                                        |\n| ------------ | -------------------------------------- |\n| **Sections** | **Objective**, **Process**, **Output** |","table":"table-0"},"84":{"id":"/product-docs/agents/builder/instructions-41","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#at-a-glance","content":"|                   |                                                       |\n| ----------------- | ----------------------------------------------------- |\n| **Process steps** | 3 to 6 per agent, each with a title and a description |","table":"table-0"},"85":{"id":"/product-docs/agents/builder/instructions-42","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#at-a-glance","content":"|                  |                                           |\n| ---------------- | ----------------------------------------- |\n| **Output items** | 1 to 3 per agent, where the agent has any |","table":"table-0"},"86":{"id":"/product-docs/agents/builder/instructions-43","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#at-a-glance","content":"|                |                                                                     |\n| -------------- | ------------------------------------------------------------------- |\n| **Tool chips** | Inside each step; pressing one opens that tool on the **Tools** tab |","table":"table-0"},"87":{"id":"/product-docs/agents/builder/instructions-44","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#at-a-glance","content":"|                |                               |\n| -------------- | ----------------------------- |\n| **Navigation** | A contents list down the left |","table":"table-0"},"88":{"id":"/product-docs/agents/builder/instructions-45","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#what-it-is","content":"Instructions are how you understand an agent before you trust it. They spell out, in plain prose, what the agent is trying to achieve, the steps it takes and what it hands back. Every agent that has a detail page carries them."},"89":{"id":"/product-docs/agents/builder/instructions-46","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#what-it-is","content":"| Section       | What it says                                             | Always shown |\n| ------------- | -------------------------------------------------------- | ------------ |\n| **Objective** | A short paragraph on what the agent is trying to achieve | Yes          |","table":"table-1"},"90":{"id":"/product-docs/agents/builder/instructions-47","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#what-it-is","content":"| Section     | What it says                                                        | Always shown                |\n| ----------- | ------------------------------------------------------------------- | --------------------------- |\n| **Process** | A numbered list of steps, each with a short title and a description | Yes, with at least one step |","table":"table-1"},"91":{"id":"/product-docs/agents/builder/instructions-48","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#what-it-is","content":"| Section    | What it says                                                                    | Always shown                         |\n| ---------- | ------------------------------------------------------------------------------- | ------------------------------------ |\n| **Output** | A numbered list of what the agent produces, each with a title and a description | Only when the agent has output items |","table":"table-1"},"92":{"id":"/product-docs/agents/builder/instructions-49","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#what-it-is","content":"Within a step's description, each tool the step uses appears as a small bordered chip with the tool's name and icon. A step can carry two chips when it uses two tools, such as one for an inbox and one for team chat. That lets you see which outside action each part of the agent's work depends on."},"93":{"id":"/product-docs/agents/builder/instructions-50","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#what-it-is","content":"A full set of instructions reads top to bottom: what the agent aims for, the five steps it takes, and what it hands back, down to the wording of its Slack message."},"94":{"id":"/product-docs/agents/builder/instructions-51","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#what-it-is","content":"Steps can hold more than plain prose:"},"95":{"id":"/product-docs/agents/builder/instructions-52","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#what-it-is","content":"**Conditions.** A step title can set a rule, such as \"If coverage is weak, then find new stakeholders\"."},"96":{"id":"/product-docs/agents/builder/instructions-53","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#what-it-is","content":"**Criteria.** A step can list its rules under bold labels, such as **Territory** and **Company size**."},"97":{"id":"/product-docs/agents/builder/instructions-54","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#what-it-is","content":"**Mentions.** A routing step can name a rep pool as an @-mention chip, such as **@enterpriseAE**."},"98":{"id":"/product-docs/agents/builder/instructions-55","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#what-it-is","content":"**Highlights.** Key values, such as when the agent should start, are picked out in bold or color."},"99":{"id":"/product-docs/agents/builder/instructions-56","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#what-it-is","content":"**Templates.** An output can give the exact message the agent sends, with placeholders such as `{{deal_name}}`."},"100":{"id":"/product-docs/agents/builder/instructions-57","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#what-it-is","content":"Instructions can carry real rules: who to disqualify by territory and size, and which rep pool gets each lead, named as an @-mention chip."},"101":{"id":"/product-docs/agents/builder/instructions-58","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#what-it-is","content":"The tab opens with a header card carrying the agent's picture, its name and its one-line description. The **Overview** tab carries a separate, shorter **Goal** statement."},"102":{"id":"/product-docs/agents/builder/instructions-59","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#what-its-for","content":"Instructions tell you what an agent will do before it does it. They lay out the agent's aim, its method and its results in words a sales team can read. They also show which tool each step relies on."},"103":{"id":"/product-docs/agents/builder/instructions-60","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#how-it-helps","content":"**The method is in writing.** **Process** lists every step in order, with a title and a description."},"104":{"id":"/product-docs/agents/builder/instructions-61","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#how-it-helps","content":"**Results are named up front.** **Output** says what the agent produces, so nobody guesses."},"105":{"id":"/product-docs/agents/builder/instructions-62","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#how-it-helps","content":"**Steps lead to tools.** Pressing a tool chip opens that tool and its approval setting."},"106":{"id":"/product-docs/agents/builder/instructions-63","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#how-it-helps","content":"**Long instructions stay easy to move through.** The contents list jumps to any section or step."},"107":{"id":"/product-docs/agents/builder/instructions-64","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#without-it","content":"Without written instructions, an agent's method is a guess. A leader can't tell whether it follows the way the team sells. Reps get output with no account of how it was reached, and trust in the agent fades."},"108":{"id":"/product-docs/agents/builder/instructions-65","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#why-buyers-care","content":"This matters most to sales leaders, who answer for how their team sells. It matters before an agent reaches the team, when a leader decides whether to back it. It matters again when the sales method changes, because the steps should still match it."},"109":{"id":"/product-docs/agents/builder/instructions-66","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#approach","content":"Imagine a sales director who has spent a year getting her team to qualify every deal the same way. Reps confirm the pain, the decision process and the economic buyer before a deal moves on. Now she wants an agent working those deals, and she wants that method in its steps."},"110":{"id":"/product-docs/agents/builder/instructions-67","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#approach","content":"Often an agent arrives as a black box with a one-line summary. Leaders tend to judge it by its first few outputs, which may take weeks to gather. By then reps have formed a view, and a step that skips the method is hard to spot."},"111":{"id":"/product-docs/agents/builder/instructions-68","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#approach","content":"The method is a sequence, so the agent's work should read as one. If its steps are written down in order, a leader can lay them beside the qualification method and check each one. Any gap shows up on the page, not in a lost deal."},"112":{"id":"/product-docs/agents/builder/instructions-69","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#approach","content":"Oliv AI writes each agent's method out on its **Instructions** tab. **Objective** states the aim, **Process** lists the numbered steps, and **Output** names what the agent produces. The sales director reads **Process** step by step against her method. Where a step relies on a tool, she presses its chip and checks how freely it acts."},"113":{"id":"/product-docs/agents/builder/instructions-70","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#approach","content":"The steps are on the tab for anyone to read. Each one has a title and a description, and the tools it uses appear as chips inside the text. How other platforms describe what an agent does is covered in How agent instructions compare, below."},"114":{"id":"/product-docs/agents/builder/instructions-71","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#read-instructions","content":"Open the agent from the agent marketplace and select the **Instructions** tab, the second tab after **Overview**."},"115":{"id":"/product-docs/agents/builder/instructions-72","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#read-instructions","content":"Read the header card at the top: the agent's picture, name and one-line description."},"116":{"id":"/product-docs/agents/builder/instructions-73","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#read-instructions","content":"Read **Objective**, a short paragraph on what the agent is trying to achieve."},"117":{"id":"/product-docs/agents/builder/instructions-74","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#read-instructions","content":"Read **Process**. Each numbered step has a short title in bold and a description beneath."},"118":{"id":"/product-docs/agents/builder/instructions-75","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#read-instructions","content":"Read **Output**, if the agent has one: a numbered list of what it produces."},"119":{"id":"/product-docs/agents/builder/instructions-76","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#read-instructions","content":"Steps are numbered from 1 in the order they're stored."},"120":{"id":"/product-docs/agents/builder/instructions-77","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#trace-to-tool","content":"Find a tool chip inside a step's description. It's a small bordered pill with the tool's name and icon."},"121":{"id":"/product-docs/agents/builder/instructions-78","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#trace-to-tool","content":"Press the chip. The page switches to the **Tools** tab with that tool scrolled into view."},"122":{"id":"/product-docs/agents/builder/instructions-79","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#trace-to-tool","content":"Read the tool's card: what it does, and its run mode, such as **Auto Run** or **Requires Approval**."},"123":{"id":"/product-docs/agents/builder/instructions-80","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#trace-to-tool","content":"The run mode decides whether that action needs a person's approval, as the guide to agent tools and run modes explains. Every chip opens the **Tools** tab, wherever it sits in a step."},"124":{"id":"/product-docs/agents/builder/instructions-81","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#trace-to-tool","content":"Every chip names a tool you can trace. Here the Draft reply step also states its own rule in words: never send without the seller's approval."},"125":{"id":"/product-docs/agents/builder/instructions-82","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#contents-list","content":"The contents list runs down the left of the tab. The text pane on the right scrolls on its own."},"126":{"id":"/product-docs/agents/builder/instructions-83","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#contents-list","content":"**Top-level entries**, such as **Objective**, **Process** and **Output**, appear in darker, heavier text. Pressing one scrolls to that section."},"127":{"id":"/product-docs/agents/builder/instructions-84","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#contents-list","content":"**Indented entries** name each process step and output item, in lighter text. Pressing one scrolls to it and marks it as the active entry. Pressing it again clears the mark."},"128":{"id":"/product-docs/agents/builder/instructions-85","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#contents-list","content":"Long entries are cut short with an ellipsis, so the list stays one line per step."},"129":{"id":"/product-docs/agents/builder/instructions-86","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#contents-list","content":"The contents list mirrors the instructions. On a short agent like this one, three steps and one output fit in view at once."},"130":{"id":"/product-docs/agents/builder/instructions-87","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#with-tools","content":"Instructions name the tools; the **Tools** tab sets how freely each one runs. Reading a step and then its tool's mode shows you both what the agent does and how much it does unasked."},"131":{"id":"/product-docs/agents/builder/instructions-88","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#with-overview","content":"The **Overview** tab gives a short **Goal** statement and lists the agent's tools as pills. The **Instructions** tab is the longer account of the same agent."},"132":{"id":"/product-docs/agents/builder/instructions-89","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#with-knowledge-and-triggers","content":"On agents that have them, the **Knowledge** tab lists the files an agent works against, and the **Triggers** tab lists what starts it. Read them with the instructions to see the full picture of an agent."},"133":{"id":"/product-docs/agents/builder/instructions-90","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#with-deal-work","content":"Instructions are where you check how an agent handles the deal work it takes on. That includes the brief before a customer call and the daily deal work an account executive runs."},"134":{"id":"/product-docs/agents/builder/instructions-91","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#who-uses-it","content":"These are typical patterns, shown to illustrate how the tab is used."},"135":{"id":"/product-docs/agents/builder/instructions-92","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#account-executives-and-sales-leaders","content":"A front-line manager reads an agent's **Process** before a team meeting and walks reps through each step. An account executive checks **Output** to know what the agent will hand over on a deal."},"136":{"id":"/product-docs/agents/builder/instructions-93","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#revenue-operations","content":"A revenue operations team presses every tool chip in an agent's **Process**. It lists the steps that write to the CRM or reach customers, then checks each tool's run mode before a rollout."},"137":{"id":"/product-docs/agents/builder/instructions-94","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#enablement","content":"An enablement lead uses **Objective**, **Process** and **Output** as a ready-made outline when training reps on a new agent. The contents list makes it easy to jump to the step a rep asks about."},"138":{"id":"/product-docs/agents/builder/instructions-95","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#customer-success","content":"A customer success team reads the instructions of agents that work its accounts. It checks the steps before a renewal, so nobody is surprised by what the agent sends."},"139":{"id":"/product-docs/agents/builder/instructions-96","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#compare","content":"Oliv AI writes each agent's method out in three parts: what it aims for, the numbered steps it takes and what it produces. Each step names the tools it uses, and each tool links to its approval setting. Oliv AI is the only platform in this table that does all three."},"140":{"id":"/product-docs/agents/builder/instructions-97","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#compare","content":"Agent instructions, from each platform's public documentation:"},"141":{"id":"/product-docs/agents/builder/instructions-98","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#compare","content":"| Platform    | Objective, process and output written out | Each step names the tools it uses | Step links to the tool's approval setting |\n| ----------- | ----------------------------------------- | --------------------------------- | ----------------------------------------- |\n| **Oliv AI** | Yes                                       | Yes                               | Yes                                       |","table":"table-2"},"142":{"id":"/product-docs/agents/builder/instructions-99","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#compare","content":"| Platform | Objective, process and output written out  | Each step names the tools it uses | Step links to the tool's approval setting |\n| -------- | ------------------------------------------ | --------------------------------- | ----------------------------------------- |\n| **Gong** | Partly (one free-text Instructions prompt) | Partly (actions run in sequence)  | Not in docs                               |","table":"table-2"},"143":{"id":"/product-docs/agents/builder/instructions-100","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#compare","content":"| Platform     | Objective, process and output written out        | Each step names the tools it uses | Step links to the tool's approval setting |\n| ------------ | ------------------------------------------------ | --------------------------------- | ----------------------------------------- |\n| **Outreach** | Partly (pre-defined MEDDPICC fields and prompts) | Not in docs                       | Not in docs                               |","table":"table-2"},"144":{"id":"/product-docs/agents/builder/instructions-101","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#compare","content":"| Platform         | Objective, process and output written out  | Each step names the tools it uses | Step links to the tool's approval setting |\n| ---------------- | ------------------------------------------ | --------------------------------- | ----------------------------------------- |\n| **Fireflies.ai** | Partly (one set of instructions per skill) | Not in docs                       | Not in docs                               |","table":"table-2"},"145":{"id":"/product-docs/agents/builder/instructions-102","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#compare","content":"| Platform  | Objective, process and output written out  | Each step names the tools it uses | Step links to the tool's approval setting |\n| --------- | ------------------------------------------ | --------------------------------- | ----------------------------------------- |\n| **Avoma** | Partly (saved prompts in a Prompt Library) | Not in docs                       | Not in docs                               |","table":"table-2"},"146":{"id":"/product-docs/agents/builder/instructions-103","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#compare","content":"*Yes: documented and built in. Partly: documented with a limit, shown in brackets. Not in docs: not found in the vendor's public documentation.*"},"147":{"id":"/product-docs/agents/builder/instructions-104","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#compare-stronger","content":"**A method you can read in order.** Oliv AI shows each agent's **Process** as numbered steps, each with a title and a description. Gong's agent builder asks for a prompt describing what you want the agent to do. See Oliv AI as a Gong alternative."},"148":{"id":"/product-docs/agents/builder/instructions-105","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#compare-stronger","content":"**Steps tied to the tools they use.** Oliv AI draws each tool as a chip inside the step that uses it. Outreach's Deal Agent starts MEDDPICC users on pre-defined fields and prompts. See how Gong and Outreach compare."},"149":{"id":"/product-docs/agents/builder/instructions-106","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#compare-stronger","content":"**Instructions kept on the agent.** Oliv AI keeps the **Objective**, **Process** and **Output** on each agent's own tab. Avoma keeps prompts in a central Prompt Library for Global Ask Avoma. See Avoma vs Oliv AI."},"150":{"id":"/product-docs/agents/builder/instructions-107","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#compare-stronger","content":"*Competitor details checked against each vendor's public documentation on 21 October 2026. Features and plans change, so confirm with the vendor before you decide.*"},"151":{"id":"/product-docs/agents/builder/instructions-108","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#limits","content":"**Read-only.** There's no text field, **Edit** or **Save** control anywhere on the tab."},"152":{"id":"/product-docs/agents/builder/instructions-109","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#limits","content":"**No history.** There's no version history, author or last-changed date."},"153":{"id":"/product-docs/agents/builder/instructions-110","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#limits","content":"**No export.** You can't export, print or copy the instructions as a block."},"154":{"id":"/product-docs/agents/builder/instructions-111","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#limits","content":"**No search.** The text can't be searched; the contents list is the way to move around it."},"155":{"id":"/product-docs/agents/builder/instructions-112","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#limits","content":"**Only agents with a detail page.** An agent without a detail page has no **Instructions** tab."},"156":{"id":"/product-docs/agents/builder/instructions-113","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#limits","content":"**Output can be missing.** An agent with no output items shows no **Output** heading at all."},"157":{"id":"/product-docs/agents/builder/instructions-114","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#faq-where","content":"Open the agent and select the **Instructions** tab. **Objective** says what it's for, **Process** lists its steps and **Output** lists what it produces."},"158":{"id":"/product-docs/agents/builder/instructions-115","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#faq-edit","content":"Not from the **Instructions** tab. It has no text field, **Edit** or **Save** control, so the instructions are read-only there."},"159":{"id":"/product-docs/agents/builder/instructions-116","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#faq-which-tools","content":"Tool names appear as small chips inside each step's description. Pressing one opens that tool on the **Tools** tab."},"160":{"id":"/product-docs/agents/builder/instructions-117","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#faq-approval","content":"Press the tool chip in that step. The **Tools** tab opens on that tool, and its run mode shows whether the action needs a person's approval."},"161":{"id":"/product-docs/agents/builder/instructions-118","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#faq-how-many-steps","content":"Between 3 and 6 across the agents in the product."},"162":{"id":"/product-docs/agents/builder/instructions-119","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#faq-no-output","content":"The **Output** section is hidden when an agent has no output items stored."},"163":{"id":"/product-docs/agents/builder/instructions-120","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#faq-author","content":"No. No author, version or date is recorded on the tab."},"164":{"id":"/product-docs/agents/builder/instructions-121","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#faq-goal","content":"The **Goal** on the **Overview** tab is a short statement kept separately from the instructions. The **Instructions** tab is the full account, in three sections."},"165":{"id":"/product-docs/agents/builder/instructions-122","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#faq-no-tab","content":"Only agents with a detail page have instructions, so an agent without one has nothing to show."},"166":{"id":"/product-docs/agents/builder/instructions-123","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#related","content":"Agent tools and run modes: set the approval mode for each tool a step uses."},"167":{"id":"/product-docs/agents/builder/instructions-124","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#related","content":"Oliv AI product documentation: every guide, by agent and feature."},"168":{"id":"/product-docs/agents/builder/instructions-125","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#related","content":"Olivia agent: ask Oliv AI's Olivia agent about deals and pipeline."},"169":{"id":"/product-docs/agents/builder/instructions-126","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#related","content":"Deal Driver agent: how Oliv AI's Deal Driver agent works on open deals."},"170":{"id":"/product-docs/agents/builder/instructions-127","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#related","content":"Your playbook, written for agents: how Oliv AI captures your revenue process."},"171":{"id":"/product-docs/agents/builder/instructions-128","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#related","content":"Sales methodology: how Oliv AI supports the way your team sells."},"172":{"id":"/product-docs/agents/builder/instructions-129","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#related","content":"MEDDIC sales methodology guide: training on MEDDIC and making it stick."},"173":{"id":"/product-docs/agents/builder/instructions-130","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#related","content":"Auto-scoring MEDDIC, BANT and SPICED: qualification scored from calls."},"174":{"id":"/product-docs/agents/builder/instructions-131","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#related","content":"The AI adoption ladder for revenue teams: from one-off prompts to agents."},"175":{"id":"/product-docs/agents/builder/instructions-132","page_id":"/product-docs/agents/builder/instructions","tags":[],"type":"text","url":"/product-docs/agents/builder/instructions#related","content":"Oliv AI for sales leaders: how each agent helps a sales leader."},"176":{"id":"/product-docs/agents/builder/knowledge","page_id":"/product-docs/agents/builder/knowledge","type":"page","content":"Agent knowledge files","breadcrumbs":["Oliv AI docs","Agents","Agent builder"],"tags":[],"url":"/product-docs/agents/builder/knowledge"},"177":{"id":"/product-docs/agents/builder/knowledge-0","page_id":"/product-docs/agents/builder/knowledge","tags":[],"type":"text","url":"/product-docs/agents/builder/knowledge","content":"What an Oliv AI agent's knowledge files are, how to check and open them on the Knowledge tab, and which file form