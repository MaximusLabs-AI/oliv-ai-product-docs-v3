ps/converse/recording-modes#who-uses-it","content":"Who uses recording modes, and how"},"2603":{"id":"/product-docs/apps/converse/recording-modes-22","page_id":"/product-docs/apps/converse/recording-modes","type":"heading","tags":[],"url":"/product-docs/apps/converse/recording-modes#account-management","content":"Account management"},"2604":{"id":"/product-docs/apps/converse/recording-modes-23","page_id":"/product-docs/apps/converse/recording-modes","type":"heading","tags":[],"url":"/product-docs/apps/converse/recording-modes#account-executives","content":"Account executives"},"2605":{"id":"/product-docs/apps/converse/recording-modes-24","page_id":"/product-docs/apps/converse/recording-modes","type":"heading","tags":[],"url":"/product-docs/apps/converse/recording-modes#customer-success","content":"Customer success"},"2606":{"id":"/product-docs/apps/converse/recording-modes-25","page_id":"/product-docs/apps/converse/recording-modes","type":"heading","tags":[],"url":"/product-docs/apps/converse/recording-modes#revops","content":"Revenue operations"},"2607":{"id":"/product-docs/apps/converse/recording-modes-26","page_id":"/product-docs/apps/converse/recording-modes","type":"heading","tags":[],"url":"/product-docs/apps/converse/recording-modes#compare","content":"How recording modes compare"},"2608":{"id":"/product-docs/apps/converse/recording-modes-27","page_id":"/product-docs/apps/converse/recording-modes","type":"heading","tags":[],"url":"/product-docs/apps/converse/recording-modes#compare-stronger","content":"Why Oliv AI is the stronger choice for recording modes"},"2609":{"id":"/product-docs/apps/converse/recording-modes-28","page_id":"/product-docs/apps/converse/recording-modes","type":"heading","tags":[],"url":"/product-docs/apps/converse/recording-modes#limits","content":"Limits and things to know"},"2610":{"id":"/product-docs/apps/converse/recording-modes-29","page_id":"/product-docs/apps/converse/recording-modes","type":"heading","tags":[],"url":"/product-docs/apps/converse/recording-modes#common-questions","content":"Common questions"},"2611":{"id":"/product-docs/apps/converse/recording-modes-30","page_id":"/product-docs/apps/converse/recording-modes","type":"heading","tags":[],"url":"/product-docs/apps/converse/recording-modes#faq-how-it-chooses","content":"How does Oliv AI choose between bot and botless?"},"2612":{"id":"/product-docs/apps/converse/recording-modes-31","page_id":"/product-docs/apps/converse/recording-modes","type":"heading","tags":[],"url":"/product-docs/apps/converse/recording-modes#faq-attendees-know","content":"Will attendees know the meeting is being recorded?"},"2613":{"id":"/product-docs/apps/converse/recording-modes-32","page_id":"/product-docs/apps/converse/recording-modes","type":"heading","tags":[],"url":"/product-docs/apps/converse/recording-modes#faq-platforms","content":"Which meeting apps support botless recording?"},"2614":{"id":"/product-docs/apps/converse/recording-modes-33","page_id":"/product-docs/apps/converse/recording-modes","type":"heading","tags":[],"url":"/product-docs/apps/converse/recording-modes#faq-no-bot","content":"My customer doesn't want a bot. What should I do?"},"2615":{"id":"/product-docs/apps/converse/recording-modes-34","page_id":"/product-docs/apps/converse/recording-modes","type":"heading","tags":[],"url":"/product-docs/apps/converse/recording-modes#faq-lobby","content":"Why didn't the note taker start recording?"},"2616":{"id":"/product-docs/apps/converse/recording-modes-35","page_id":"/product-docs/apps/converse/recording-modes","type":"heading","tags":[],"url":"/product-docs/apps/converse/recording-modes#faq-turn-on","content":"How do I turn on botless recording?"},"2617":{"id":"/product-docs/apps/converse/recording-modes-36","page_id":"/product-docs/apps/converse/recording-modes","type":"heading","tags":[],"url":"/product-docs/apps/converse/recording-modes#faq-teams-meet","content":"Do I need an integration for Teams or Google Meet?"},"2618":{"id":"/product-docs/apps/converse/recording-modes-37","page_id":"/product-docs/apps/converse/recording-modes","type":"heading","tags":[],"url":"/product-docs/apps/converse/recording-modes#faq-no-host","content":"Can Zoom meetings record when the host isn't there?"},"2619":{"id":"/product-docs/apps/converse/recording-modes-38","page_id":"/product-docs/apps/converse/recording-modes","type":"heading","tags":[],"url":"/product-docs/apps/converse/recording-modes#faq-remove","content":"How do I stop the note taker joining one meeting?"},"2620":{"id":"/product-docs/apps/converse/recording-modes-39","page_id":"/product-docs/apps/converse/recording-modes","type":"heading","tags":[],"url":"/product-docs/apps/converse/recording-modes#faq-phone","content":"Can I record phone calls?"},"2621":{"id":"/product-docs/apps/converse/recording-modes-40","page_id":"/product-docs/apps/converse/recording-modes","type":"heading","tags":[],"url":"/product-docs/apps/converse/recording-modes#faq-in-person","content":"Can Oliv AI capture in-person meetings?"},"2622":{"id":"/product-docs/apps/converse/recording-modes-41","page_id":"/product-docs/apps/converse/recording-modes","type":"heading","tags":[],"url":"/product-docs/apps/converse/recording-modes#related","content":"Related"},"2623":{"id":"/product-docs/apps/converse/recording-modes-42","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes","content":"Oliv AI records your meetings in one of two ways, and it picks the way for you based on who organized the meeting. When someone from your company is the organizer, Oliv AI records botlessly, through Zoom or Microsoft Teams itself. When someone outside your company is the organizer, a visible note taker joins the call, named after your company. This page explains both modes and how to prepare your meetings so they record."},"2624":{"id":"/product-docs/apps/converse/recording-modes-43","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#at-a-glance","content":"|                   |                                                                    |\n| ----------------- | ------------------------------------------------------------------ |\n| **The two modes** | Botless recording through the meeting app, or a visible note taker |","table":"table-0"},"2625":{"id":"/product-docs/apps/converse/recording-modes-44","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#at-a-glance","content":"|                 |                                         |\n| --------------- | --------------------------------------- |\n| **Who decides** | Oliv AI, from who organized the meeting |","table":"table-0"},"2626":{"id":"/product-docs/apps/converse/recording-modes-45","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#at-a-glance","content":"|                            |                                          |\n| -------------------------- | ---------------------------------------- |\n| **Your company organizes** | Botless: no Oliv participant on the call |","table":"table-0"},"2627":{"id":"/product-docs/apps/converse/recording-modes-46","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#at-a-glance","content":"|                               |                                                    |\n| ----------------------------- | -------------------------------------------------- |\n| **Someone outside organizes** | A note taker joins, shown with your company's name |","table":"table-0"},"2628":{"id":"/product-docs/apps/converse/recording-modes-47","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#at-a-glance","content":"|                        |                                                                    |\n| ---------------------- | ------------------------------------------------------------------ |\n| **What attendees see** | The meeting app's own recording indicator, or the named note taker |","table":"table-0"},"2629":{"id":"/product-docs/apps/converse/recording-modes-48","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#at-a-glance","content":"|           |                                                                           |\n| --------- | ------------------------------------------------------------------------- |\n| **Needs** | A connected calendar, and botless recording enabled for your organization |","table":"table-0"},"2630":{"id":"/product-docs/apps/converse/recording-modes-49","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#at-a-glance","content":"|                     |                          |\n| ------------------- | ------------------------ |\n| **Platforms named** | Zoom and Microsoft Teams |","table":"table-0"},"2631":{"id":"/product-docs/apps/converse/recording-modes-50","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#at-a-glance","content":"|                 |                                                                                                       |\n| --------------- | ----------------------------------------------------------------------------------------------------- |\n| **Phone calls** | A **Record call** toggle and a **Recording method** of **One-way** or **Two-way** in the Power Dialer |","table":"table-0"},"2632":{"id":"/product-docs/apps/converse/recording-modes-51","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#what-it-is","content":"A recording mode is how Oliv AI captures a meeting. When native or botless recording is enabled for your organization, Oliv AI chooses the method based on who organized the meeting. You don't pick a mode per call."},"2633":{"id":"/product-docs/apps/converse/recording-modes-52","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#what-it-is","content":"|               | Botless recording                                      | Note taker                                         |\n| ------------- | ------------------------------------------------------ | -------------------------------------------------- |\n| **Used when** | You or someone from your company organized the meeting | Someone outside your company organized the meeting |","table":"table-1"},"2634":{"id":"/product-docs/apps/converse/recording-modes-53","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#what-it-is","content":"|                    | Botless recording                                | Note taker                            |\n| ------------------ | ------------------------------------------------ | ------------------------------------- |\n| **How it records** | Directly through the video conferencing platform | The note taker joins as a participant |","table":"table-1"},"2635":{"id":"/product-docs/apps/converse/recording-modes-54","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#what-it-is","content":"|                        | Botless recording                                                        | Note taker                                   |\n| ---------------------- | ------------------------------------------------------------------------ | -------------------------------------------- |\n| **What attendees see** | The meeting app's recording indication, and no separate Oliv participant | A participant shown with your company's name |","table":"table-1"},"2636":{"id":"/product-docs/apps/converse/recording-modes-55","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#what-it-is","content":"|                      | Botless recording | Note taker                                      |\n| -------------------- | ----------------- | ----------------------------------------------- |\n| **Before it starts** | Nothing to admit  | May need admitting from a waiting room or lobby |","table":"table-1"},"2637":{"id":"/product-docs/apps/converse/recording-modes-56","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#what-it-is","content":"Botless recording happens inside the meeting app, such as Zoom or Microsoft Teams. The note taker is Oliv AI's visible way of joining a call to take notes, so you can focus on the conversation."},"2638":{"id":"/product-docs/apps/converse/recording-modes-57","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#what-it-is","content":"Whichever mode records it, the meeting lands in **Activities › Meetings** with its duration, type, next step and AI summary."},"2639":{"id":"/product-docs/apps/converse/recording-modes-58","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#what-it-is","content":"Botless or note taker, every recorded meeting ends up in the same Meetings list, so the mode changes how a call is captured but never where you find it."},"2640":{"id":"/product-docs/apps/converse/recording-modes-59","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#phone-calls","content":"Phone calls placed from the Power Dialer in Engage have their own recording controls. Once a call connects, the contact card shows a **Record call** toggle and a **Recording method** choice of **One-way** or **Two-way**. Pause, mute and **End Call** sit beside them."},"2641":{"id":"/product-docs/apps/converse/recording-modes-60","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#phone-calls","content":"For dialer calls the rep sets recording on the call itself, with the Record call toggle and a choice of recording method, rather than through the meeting organizer rule."},"2642":{"id":"/product-docs/apps/converse/recording-modes-61","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#what-its-for","content":"Recording modes let you capture every customer meeting while keeping the call itself clean. When you host, nothing extra sits in the participant list. When a customer hosts, attendees can see clearly who is recording."},"2643":{"id":"/product-docs/apps/converse/recording-modes-62","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#how-it-helps","content":"**No bot on calls you host.** The meeting app records, so no Oliv participant appears."},"2644":{"id":"/product-docs/apps/converse/recording-modes-63","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#how-it-helps","content":"**No setting to remember.** The organizer decides the mode, so there's nothing to switch per call."},"2645":{"id":"/product-docs/apps/converse/recording-modes-64","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#how-it-helps","content":"**Clear when you're a guest.** On someone else's meeting, the note taker carries your company's name."},"2646":{"id":"/product-docs/apps/converse/recording-modes-65","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#how-it-helps","content":"**Recorded either way.** Whoever organized it, the meeting is captured."},"2647":{"id":"/product-docs/apps/converse/recording-modes-66","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#without-it","content":"Without a choice of mode, every recorded call gets a bot in the participant list. Some customers ask for it to leave, and the call goes unrecorded. Others accept it but feel watched. The cost is gaps in the record of your most important accounts."},"2648":{"id":"/product-docs/apps/converse/recording-modes-67","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#why-buyers-care","content":"This matters to account managers and customer success teams, whose customers often set the tone on calls. It matters to revenue operations, who answer IT and security questions about recorders. It counts most with enterprise customers who have strict meeting policies."},"2649":{"id":"/product-docs/apps/converse/recording-modes-68","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#approach","content":"Picture an account manager with a renewal review on the calendar next week. The customer's IT lead has asked, politely, that no meeting bot join their calls. The account manager still wants a recording, because an expansion conversation will follow. Notes from this call will shape that proposal."},"2650":{"id":"/product-docs/apps/converse/recording-modes-69","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#approach","content":"The usual answer is to switch the recorder off and take notes by hand, or to ask the customer for an exception. Either way, something tends to get lost. It's either the record of the call or a little goodwill. Hand-written notes also miss the exact words a customer used about budget or scope."},"2651":{"id":"/product-docs/apps/converse/recording-modes-70","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#approach","content":"What the customer objects to is an extra participant, not a record of the meeting. The host already controls how a meeting app records. So the real question is who sends the invite. If your company hosts, the meeting app can do the recording itself."},"2652":{"id":"/product-docs/apps/converse/recording-modes-71","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#approach","content":"Oliv AI answers it from the invite. When the account manager organizes the meeting, Oliv AI records through Zoom or Microsoft Teams directly, with no Oliv participant on the call. When the customer organizes, the note taker joins visibly, named after the account manager's company. Nobody has to change a setting before the call."},"2653":{"id":"/product-docs/apps/converse/recording-modes-72","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#approach","content":"Attendees on a botless call still see the meeting app's own recording indicator, so nobody is recorded without knowing it. How that organizer rule stacks up against other recorders is covered in How recording modes compare, below."},"2654":{"id":"/product-docs/apps/converse/recording-modes-73","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#prepare","content":"Whichever mode applies, a few things need to be in place before Oliv AI can record."},"2655":{"id":"/product-docs/apps/converse/recording-modes-74","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#prepare","content":"**Connect your calendar.** Calendar integration is required for Oliv AI to work. Without it, the note taker can't take notes during your meetings."},"2656":{"id":"/product-docs/apps/converse/recording-modes-75","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#prepare","content":"**Connect your video platform.** For Microsoft Teams and Google Meet, no extra integration is needed: Oliv AI joins automatically once your calendar is connected. For Zoom, install the Oliv AI Zoom app, as set out under Set up Zoom recording."},"2657":{"id":"/product-docs/apps/converse/recording-modes-76","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#prepare","content":"**Decide who sends the invite.** If a customer would rather not see a bot, send the meeting invite from your own calendar. Your company is then the organizer, and the call records botlessly."},"2658":{"id":"/product-docs/apps/converse/recording-modes-77","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#prepare","content":"**Plan for the lobby.** On meetings someone outside your company hosts, the note taker may wait in a waiting room or lobby. Ask the host to admit it, or recording can't begin."},"2659":{"id":"/product-docs/apps/converse/recording-modes-78","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#turn-on-botless","content":"Botless recording is enabled per organization. If it isn't set up for yours, reach out to Oliv AI Support and connect your video conferencing admin with them. They'll help enable it for your team."},"2660":{"id":"/product-docs/apps/converse/recording-modes-79","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#zoom","content":"Oliv AI has two Zoom apps on the Zoom marketplace:"},"2661":{"id":"/product-docs/apps/converse/recording-modes-80","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#zoom","content":"| App                    | What it does                                                                                                |\n| ---------------------- | ----------------------------------------------------------------------------------------------------------- |\n| **Oliv - Meeting bot** | Adds the note taker to your meetings, records with your consent, and surfaces the meeting details afterward |","table":"table-2"},"2662":{"id":"/product-docs/apps/converse/recording-modes-81","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#zoom","content":"| App                       | What it does                                                                                                                          |\n| ------------------------- | ------------------------------------------------------------------------------------------------------------------------------------- |\n| **Oliv.ai** (meeting app) | Adds a richer set of features: fewer steps for recording consent, and Oliv AI's view inside Zoom during the call to update CRM fields |","table":"table-2"},"2663":{"id":"/product-docs/apps/converse/recording-modes-82","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#zoom","content":"By default, Oliv AI asks the host's permission to record a Zoom meeting. Without that permission, Oliv AI can't summarize the meeting."},"2664":{"id":"/product-docs/apps/converse/recording-modes-83","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#zoom-admin","content":"A Zoom admin can grant permissions so that Zoom meetings are recorded even when the host isn't present."},"2665":{"id":"/product-docs/apps/converse/recording-modes-84","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#zoom-admin","content":"Go to the Zoom meeting bot settings at web.oliv.ai/apps/zoom-meeting-bot."},"2666":{"id":"/product-docs/apps/converse/recording-modes-85","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#zoom-admin","content":"Check the **Permissions** box. This grants the admin-level permission that lets Zoom meetings record automatically without the host."},"2667":{"id":"/product-docs/apps/converse/recording-modes-86","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#zoom-admin","content":"Click **Allow** to enable the Shared Access Permission."},"2668":{"id":"/product-docs/apps/converse/recording-modes-87","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#zoom-admin","content":"Let the Oliv AI team know. They finish the setup on their side."},"2669":{"id":"/product-docs/apps/converse/recording-modes-88","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#manage-notetaker","content":"Oliv AI joins external calls automatically, but you can manage that from Oliv AI or from your Google or Outlook calendar. There are five ways to stop the note taker joining:"},"2670":{"id":"/product-docs/apps/converse/recording-modes-89","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#manage-notetaker","content":"The Oliv AI Chrome extension or the Oliv AI Outlook add-in."},"2671":{"id":"/product-docs/apps/converse/recording-modes-90","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#manage-notetaker","content":"The **Meetings** page in Oliv AI, under **Activities**."},"2672":{"id":"/product-docs/apps/converse/recording-modes-91","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#manage-notetaker","content":"The remove link in your meeting preparation summary, by email or Slack."},"2673":{"id":"/product-docs/apps/converse/recording-modes-92","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#manage-notetaker","content":"The remove link in the Zoom chat."},"2674":{"id":"/product-docs/apps/converse/recording-modes-93","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#manage-notetaker","content":"Removing the note taker directly in Zoom."},"2675":{"id":"/product-docs/apps/converse/recording-modes-94","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#with-meeting-assistant","content":"Recordings feed what happens before and after your calls. Oliv AI's Meeting Assistant agent drafts the follow-up from the transcript once a recording is processed. It also sends the brief that helps you prepare for a meeting next time."},"2676":{"id":"/product-docs/apps/converse/recording-modes-95","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#with-converse","content":"Converse captures online meetings, bot-free calls, phone calls and email the same way. In-person meetings are captured with Plaud, a wearable recorder that travels with your reps, and the rep decides when and what to record."},"2677":{"id":"/product-docs/apps/converse/recording-modes-96","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#with-converse","content":"A recorded meeting opens with a **Recording** tab: the player with **Add Comment**, **Clip** and **Share**, a speaker **Timeline** with talk time and engagement, and **Chapters**, **Transcripts** and **Comments**. The meeting details page covers each tab."},"2678":{"id":"/product-docs/apps/converse/recording-modes-97","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#with-converse","content":"This is what a recording becomes once it is processed: chapters, a transcript, comments and per-speaker talk time, ready to clip or share."},"2679":{"id":"/product-docs/apps/converse/recording-modes-98","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#with-converse","content":"A recorded phone call gets an audio player instead, with a **Timeline** of talk time per speaker, **Chapters**, **Add Comment** and a timestamped **Transcript**."},"2680":{"id":"/product-docs/apps/converse/recording-modes-99","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#with-converse","content":"A recorded phone call is replayed the same way as a meeting, with the transcript beside an audio player, so calls are as easy to review as video meetings."},"2681":{"id":"/product-docs/apps/converse/recording-modes-100","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#with-zoom-app","content":"With the Oliv.ai meeting app, you can open Oliv AI inside Zoom during the call. Update deal data in place and see the moments you highlighted through Oliv AI during the meeting. See Oliv AI integrations for the full list of connections."},"2682":{"id":"/product-docs/apps/converse/recording-modes-101","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#with-clips","content":"Once a recording is processed, Oliv AI's Content Curator agent can clip the moments your team cares about and post them to your team's channel."},"2683":{"id":"/product-docs/apps/converse/recording-modes-102","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#with-agents","content":"Oliv AI's Olivia agent draws on meeting data as the primary source of her live context. Oliv AI's Deal Driver agent tells managers which meetings happened and their key outcomes in its end-of-day summary."},"2684":{"id":"/product-docs/apps/converse/recording-modes-103","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#who-uses-it","content":"These are typical patterns, shown to illustrate how teams use the two modes."},"2685":{"id":"/product-docs/apps/converse/recording-modes-104","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#account-management","content":"An account manager sends renewal and QBR invites from their own calendar. Calls with customers who dislike bots record botlessly, and the full account history stays intact."},"2686":{"id":"/product-docs/apps/converse/recording-modes-105","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#account-executives","content":"An account executive joins a prospect's own meeting link for a demo. The note taker asks to be admitted from the lobby with the AE's company name, and the follow-up still arrives after the call. It's part of how AEs run their deals in Oliv AI."},"2687":{"id":"/product-docs/apps/converse/recording-modes-106","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#customer-success","content":"A customer success manager runs onboarding calls on Microsoft Teams. Because the CSM organizes them, no Oliv participant appears, and the customer sees only Teams' own recording indicator."},"2688":{"id":"/product-docs/apps/converse/recording-modes-107","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#revops","content":"A revenue operations lead works with the Zoom admin to grant admin-level permissions. Meetings then record even when the host is late or absent. RevOps also decides which agent actions run without asking."},"2689":{"id":"/product-docs/apps/converse/recording-modes-108","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#compare","content":"Oliv AI switches between botless recording and a visible note taker by itself, based on who organized the meeting. Calls you host record through Zoom or Microsoft Teams with no bot, and calls a customer hosts get a note taker with your company's name. Oliv AI is the only platform in this table that does all three."},"2690":{"id":"/product-docs/apps/converse/recording-modes-109","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#compare","content":"Recording modes, from each platform's public documentation:"},"2691":{"id":"/product-docs/apps/converse/recording-modes-110","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#compare","content":"| Platform    | Bot-free recording in Zoom and Teams | Recording method follows the meeting organizer | Note taker shows your company's name |\n| ----------- | ------------------------------------ | ---------------------------------------------- | ------------------------------------ |\n| **Oliv AI** | Yes                                  | Yes                                            | Yes                                  |","table":"table-3"},"2692":{"id":"/product-docs/apps/converse/recording-modes-111","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#compare","content":"| Platform | Bot-free recording in Zoom and Teams | Recording method follows the meeting organizer | Note taker shows your company's name |\n| -------- | ------------------------------------ | ---------------------------------------------- | ------------------------------------ |\n| **Gong** | Partly (native recording, Zoom only) | Set by company setup (two methods by setup)    | Not in docs                          |","table":"table-3"},"2693":{"id":"/product-docs/apps/converse/recording-modes-112","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#compare","content":"| Platform  | Bot-free recording in Zoom and Teams           | Recording method follows the meeting organizer | Note taker shows your company's name |\n| --------- | ---------------------------------------------- | ---------------------------------------------- | ------------------------------------ |\n| **Avoma** | Partly (Teams needs a cloud recording license) | Chosen during setup (pick cloud or bot)        | Yes (custom bot name)                |","table":"table-3"},"2694":{"id":"/product-docs/apps/converse/recording-modes-113","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#compare","content":"| Platform   | Bot-free recording in Zoom and Teams    | Recording method follows the meeting organizer           | Note taker shows your company's name |\n| ---------- | --------------------------------------- | -------------------------------------------------------- | ------------------------------------ |\n| **Fathom** | Partly (Teams still uses the notetaker) | User preference, admin can block (org-wide bot override) | Yes (custom notetaker name)          |","table":"table-3"},"2695":{"id":"/product-docs/apps/converse/recording-modes-114","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#compare","content":"| Platform         | Bot-free recording in Zoom and Teams     | Recording method follows the meeting organizer | Note taker shows your company's name |\n| ---------------- | ---------------------------------------- | ---------------------------------------------- | ------------------------------------ |\n| **Fireflies.ai** | Partly (Google Meet SDK and desktop app) | Your choice per meeting (bot or Take Notes)    | Partly (custom name on paid plans)   |","table":"table-3"},"2696":{"id":"/product-docs/apps/converse/recording-modes-115","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#compare","content":"*Yes: documented and built in. Partly: documented with a limit, shown in brackets. Not in docs: not found in the vendor's public documentation.*"},"2697":{"id":"/product-docs/apps/converse/recording-modes-116","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#compare-stronger","content":"**Bot-free on Teams as well as Zoom.** Oliv AI records botlessly in both Zoom and Microsoft Teams when your company organizes. Fathom records Microsoft Teams meetings by having its notetaker join the call."},"2698":{"id":"/product-docs/apps/converse/recording-modes-117","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#compare-stronger","content":"**Nothing to choose per call.** Oliv AI reads the organizer and picks the mode for you. Avoma has you choose between cloud recording and its bot during setup. See Oliv AI vs Avoma."},"2699":{"id":"/product-docs/apps/converse/recording-modes-118","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#compare-stronger","content":"**Customer-hosted calls covered.** When someone outside your company organizes, Oliv AI joins with a visible note taker. Gong lists calls hosted by someone outside your company among those not picked up automatically. See Gong vs Oliv AI."},"2700":{"id":"/product-docs/apps/converse/recording-modes-119","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#compare-stronger","content":"*Competitor details checked against each vendor's public documentation on 21 October 2026. Features and plans change, so confirm with the vendor before you decide.*"},"2701":{"id":"/product-docs/apps/converse/recording-modes-120","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#limits","content":"**Botless needs enabling.** Botless recording works once it's enabled for your organization, with help from Oliv AI Support and your video conferencing admin."},"2702":{"id":"/product-docs/apps/converse/recording-modes-121","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#limits","content":"**The organizer decides, not you.** You can't force botless recording on a meeting someone outside your company organized. Send the invite yourself if it matters."},"2703":{"id":"/product-docs/apps/converse/recording-modes-122","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#limits","content":"**Lobbies can block the note taker.** If an external meeting has a waiting room, someone has to admit the note taker before recording begins."},"2704":{"id":"/product-docs/apps/converse/recording-modes-123","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#limits","content":"**Zoom asks the host first.** By default, Oliv AI needs the host's permission to record a Zoom meeting. Admin-level permissions remove that step, and a Zoom admin has to grant them."},"2705":{"id":"/product-docs/apps/converse/recording-modes-124","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#limits","content":"**No calendar, no recording.** Oliv AI relies on your calendar to know which meetings to join."},"2706":{"id":"/product-docs/apps/converse/recording-modes-125","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#limits","content":"**Attendees are always told.** Botless calls show the meeting app's recording indication, so recording is never hidden."},"2707":{"id":"/product-docs/apps/converse/recording-modes-126","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#faq-how-it-chooses","content":"By who organized the meeting. If you or someone from your company organized it, Oliv AI records botlessly. If someone outside your company did, the note taker joins."},"2708":{"id":"/product-docs/apps/converse/recording-modes-127","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#faq-attendees-know","content":"Yes. On a botless call they see the meeting app's own recording indication. On other calls they see the note taker, shown with your company's name."},"2709":{"id":"/product-docs/apps/converse/recording-modes-128","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#faq-platforms","content":"Zoom and Microsoft Teams are both supported. Recording happens inside the meeting app itself, with no separate Oliv participant on the call."},"2710":{"id":"/product-docs/apps/converse/recording-modes-129","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#faq-no-bot","content":"Send the meeting invite from your own calendar. With your company as the organizer, Oliv AI records botlessly and no note taker joins."},"2711":{"id":"/product-docs/apps/converse/recording-modes-130","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#faq-lobby","content":"If the meeting had a waiting room or lobby, the note taker may have needed admitting first. Ask the host to let it in."},"2712":{"id":"/product-docs/apps/converse/recording-modes-131","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#faq-turn-on","content":"Reach out to Oliv AI Support and connect your video conferencing admin with them. They'll help enable botless recording for your team."},"2713":{"id":"/product-docs/apps/converse/recording-modes-132","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#faq-teams-meet","content":"No. Once your calendar is connected, Oliv AI joins Microsoft Teams and Google Meet meetings automatically. Zoom uses the Oliv AI Zoom app."},"2714":{"id":"/product-docs/apps/converse/recording-modes-133","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#faq-no-host","content":"Yes, once a Zoom admin grants admin-level permissions through the Zoom meeting bot settings and tells the Oliv AI team."},"2715":{"id":"/product-docs/apps/converse/recording-modes-134","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#faq-remove","content":"Use the Chrome extension or Outlook add-in, the **Meetings** page under **Activities**, the remove link in your prep summary or the Zoom chat, or remove it in Zoom."},"2716":{"id":"/product-docs/apps/converse/recording-modes-135","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#faq-phone","content":"Yes. In the Power Dialer, turn on **Record call** and pick a **Recording method** of **One-way** or **Two-way**."},"2717":{"id":"/product-docs/apps/converse/recording-modes-136","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#faq-in-person","content":"Yes, through Plaud, a wearable recorder that travels with your reps. The rep decides when and what to record."},"2718":{"id":"/product-docs/apps/converse/recording-modes-137","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#related","content":"Oliv AI product documentation: every guide, by agent and feature."},"2719":{"id":"/product-docs/apps/converse/recording-modes-138","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#related","content":"Prepare for a meeting: the brief that arrives before your recorded calls."},"2720":{"id":"/product-docs/apps/converse/recording-modes-139","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#related","content":"Converse: every conversation, captured the same way."},"2721":{"id":"/product-docs/apps/converse/recording-modes-140","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#related","content":"Oliv AI integrations: calendars, video platforms and chat tools."},"2722":{"id":"/product-docs/apps/converse/recording-modes-141","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#related","content":"Meeting recorder picks: how meeting recorders differ."},"2723":{"id":"/product-docs/apps/converse/recording-modes-142","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#related","content":"Sales call analytics software: recording, transcription and coaching compared."},"2724":{"id":"/product-docs/apps/converse/recording-modes-143","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#related","content":"Meeting transcription software: accuracy and speaker detection."},"2725":{"id":"/product-docs/apps/converse/recording-modes-144","page_id":"/product-docs/apps/converse/recording-modes","tags":[],"type":"text","url":"/product-docs/apps/converse/recording-modes#related","content":"Plans and pricing: how Oliv AI is priced."},"2726":{"id":"/product-docs/apps/engage","page_id":"/product-docs/apps/engage","type":"page","content":"Engage app","breadcrumbs":["Oliv AI docs","Apps"],"tags":[],"url":"/product-docs/apps/engage"},"2727":{"id":"/product-docs/apps/engage-0","page_id":"/product-docs/apps/engage","tags":[],"type":"text","url":"/product-docs/apps/engage","content":"What Oliv AI's Engage app does for outbound teams, from the multichannel Inbox and signal-driven plays to the power dialer with a call plan for every contact, and how it compares with other sales engagement tools."},"2728":{"id":"/product-docs/apps/engage-1","page_id":"/product-docs/apps/engage","type":"heading","tags":[],"url":"/product-docs/apps/engage#at-a-glance","content":"At a glance"},"2729":{"id":"/product-docs/apps/engage-2","page_id":"/product-docs/apps/engage","type":"heading","tags":[],"url":"/product-docs/apps/engage#what-it-is","content":"What the Engage app is"},"2730":{"id":"/product-docs/apps/engage-3","page_id":"/product-docs/apps/engage","type":"heading","tags":[],"url":"/product-docs/apps/engage#where-it-lives","content":"Where Engage lives in the product"},"2731":{"id":"/product-docs/apps/engage-4","page_id":"/product-docs/apps/engage","type":"heading","tags":[],"url":"/product-docs/apps/engage#add-on","content":"Engage the add-on"},"2732":{"id":"/product-docs/apps/engage-5","page_id":"/product-docs/apps/engage","type":"heading","tags":[],"url":"/product-docs/apps/engage#why-it-matters","content":"Why the Engage app matters"},"2733":{"id":"/product-docs/apps/engage-6","page_id":"/product-docs/apps/engage","type":"heading","tags":[],"url":"/product-docs/apps/engage#what-its-for","content":"What it's for"},"2734":{"id":"/product-docs/apps/engage-7","page_id":"/product-docs/apps/engage","type":"heading","tags":[],"url":"/product-docs/apps/engage#how-it-helps","content":"How it helps"},"2735":{"id":"/product-docs/apps/engage-8","page_id":"/product-docs/apps/engage","type":"heading","tags":[],"url":"/product-docs/apps/engage#without-it","content":"What happens without it"},"2736":{"id":"/product-docs/apps/engage-9","page_id":"/product-docs/apps/engage","type":"heading","tags":[],"url":"/product-docs/apps/engage#why-buyers-care","content":"Why buyers care"},"2737":{"id":"/pr